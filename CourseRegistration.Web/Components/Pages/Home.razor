@page "/"
@namespace CourseRegistration.Web.Components.Pages
@inject IStudentRepository StudentRepository
@inject IRegistrationCartStateStore CartStateStore
@inject ICurrentUserStateStore CurrentUserStateStore
@inject ILoginModalService LoginModalService
@implements IDisposable

<!-- Banner Gọn Gàng - Cổng Đăng Ký Học Phần Trực Tuyến -->
<div class="hero-portal p-3 p-md-4 mb-4 rounded-4 shadow-sm">
    <div class="row align-items-center g-3">
        <div class="col-lg-7">
            <div class="d-inline-flex align-items-center bg-white bg-opacity-10 border border-white border-opacity-25 rounded-pill px-3 py-1 mb-2">
                <span class="pulse-indicator"></span>
                <span class="small fw-semibold text-white">Cổng Đào Tạo Trực Tuyến &bull; Học kỳ 1 (2026 - 2027)</span>
            </div>
            
            <h1 class="h3 fw-bold mb-2 gradient-heading text-white">
                Đăng Ký Học Phần
            </h1>
            
            <p class="mb-3 text-white-50 small" style="line-height: 1.6;">
                Hệ thống đăng ký tín chỉ sinh viên chính quy &bull; Tra cứu lớp học phần, kiểm tra điều kiện tiên quyết và sắp xếp lịch học thời gian thực.
            </p>

            <div class="d-flex flex-wrap gap-2">
                <a href="/sections?tab=search" class="btn btn-light px-3 py-2 fw-semibold text-primary shadow-sm d-inline-flex align-items-center justify-content-center hero-action-btn">
                    <i class="bi bi-search me-2"></i> Tra Cứu Học Phần
                </a>
                <a href="/schedule" class="btn btn-outline-light px-3 py-2 d-inline-flex align-items-center justify-content-center hero-action-btn">
                    <i class="bi bi-calendar3 me-1"></i> Thời Khóa Biểu
                </a>
                @if (isAuthenticated)
                {
                    <a href="/cart" class="btn btn-outline-light px-3 py-2 position-relative d-inline-flex align-items-center justify-content-center hero-action-btn">
                        <i class="bi bi-cart3 me-1"></i> Giỏ Đăng Ký
                        @if (cartCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger ms-1">@cartCount</span>
                        }
                    </a>
                }
            </div>
        </div>

        <div class="col-lg-5">
            @if (!isAuthenticated)
            {
                <!-- Thẻ Chưa Đăng Nhập -->
                <div class="student-badge-card text-white">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-white border-opacity-25">
                        <span class="fw-bold small text-uppercase">
                            <i class="bi bi-person-badge me-1"></i>Cổng Xác Thực Sinh Viên
                        </span>
                        <span class="badge bg-secondary text-white px-2 py-1 small">Chưa đăng nhập</span>
                    </div>

                    <div class="mb-3">
                        <h5 class="fw-bold mb-1 text-white">Chào Mừng Bạn!</h5>
                        <p class="small text-white-50 mb-0" style="line-height: 1.5;">
                            Đăng nhập bằng tài khoản sinh viên để bắt đầu tra cứu, thêm học phần vào giỏ và gửi phiếu đăng ký tín chỉ.
                        </p>
                    </div>

                    <button type="button" 
                            class="btn btn-warning w-100 py-2 fw-bold text-dark rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                            @onclick="() => LoginModalService.Open()">
                        <i class="bi bi-box-arrow-in-right fs-5"></i>
                        <span>Đăng Nhập Ngay</span>
                    </button>
                </div>
            }
            else if (currentRole == "Admin")
            {
                <!-- Thẻ Cán Bộ Quản Trị Đào Tạo -->
                <div class="student-badge-card text-white">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-white border-opacity-25">
                        <span class="badge bg-danger text-white px-2.5 py-1 fw-bold small shadow-xs">
                            <i class="bi bi-shield-lock-fill me-1"></i>Phòng Đào Tạo
                        </span>
                        <span class="badge bg-white bg-opacity-25 text-white px-2 py-1 small">Quản trị viên</span>
                    </div>

                    <div class="mb-2">
                        <h5 class="fw-bold mb-0 text-white">Cán bộ Quản lý Đào tạo</h5>
                        <div class="small text-white-50">
                            Hệ thống Đào tạo Tín chỉ &bull; HK1 (2026 - 2027)
                        </div>
                    </div>

                    <div class="d-flex gap-2 mb-2 flex-wrap">
                        <a href="/admin" class="btn btn-sm btn-danger fw-bold flex-fill shadow-xs text-nowrap">
                            <i class="bi bi-speedometer2 me-1"></i>Trang PĐT
                        </a>
                        <a href="/admin/courses" class="btn btn-sm btn-outline-light flex-fill text-nowrap">
                            <i class="bi bi-book me-1"></i>Môn học
                        </a>
                        <a href="/admin/sections" class="btn btn-sm btn-outline-light flex-fill text-nowrap">
                            <i class="bi bi-collection me-1"></i>Lớp HP
                        </a>
                        <a href="/admin/enrollments" class="btn btn-sm btn-outline-light flex-fill text-nowrap">
                            <i class="bi bi-person-gear me-1"></i>Rút môn
                        </a>
                    </div>

                    <div class="pt-2 border-top border-white border-opacity-25">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="small text-white-50 mb-0 text-nowrap me-2">Kiểm tra SV:</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary w-auto" @onchange="OnStudentChange">
                                @foreach (var s in students)
                                {
                                    <option value="@s.StudentId" selected="@(s.StudentId == selectedStudentId)">
                                        @s.StudentCode - @s.FullName
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Thẻ Sinh Viên Đăng Nhập -->
                <div class="student-badge-card text-white">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-white border-opacity-25">
                        <span class="fw-bold small text-uppercase">
                            <i class="bi bi-mortarboard-fill me-1"></i>Tài khoản sinh viên
                        </span>
                        <span class="badge bg-success text-white px-2 py-1 small">Đang đăng nhập</span>
                    </div>

                    @if (currentStudent != null)
                    {
                        <div class="mb-2">
                            <h5 class="fw-bold mb-0 text-white">@currentStudent.FullName</h5>
                            <div class="small text-white-50">
                                MSSV: <strong>@currentStudent.StudentCode</strong> &bull; @currentStudent.Major
                            </div>
                        </div>

                        <div class="p-2 bg-black bg-opacity-25 rounded-3 mb-2 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-white-50">Hạn mức HK1 (2026 - 2027):</span>
                                <span class="fw-bold text-warning">Tối đa @currentStudent.MaxCreditsPerSemester TC</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-white-50">Điều kiện tiên quyết:</span>
                                @if (currentStudent.StudentId == 1)
                                {
                                    <span class="badge bg-success text-white">✓ Đạt chuẩn (TIN101 & 102)</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">⚠️ Chưa đạt TIN102</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="/cart" class="btn btn-outline-light btn-sm flex-fill">
                                <i class="bi bi-cart3 me-1"></i>Giỏ đăng ký (@cartCount)
                            </a>
                            <a href="/schedule" class="btn btn-outline-light btn-sm flex-fill">
                                <i class="bi bi-calendar3 me-1"></i>Lịch học cá nhân
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- 4 Lối Tắt Dịch Vụ Chính (Gọn Gàng) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a href="/sections" class="card border-0 shadow-sm p-3 text-decoration-none h-100 portal-card text-center text-md-start">
            <div class="portal-icon bg-primary-subtle text-primary mb-2 mx-auto mx-md-0">
                <i class="bi bi-search"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">Tra Cứu Lớp HP</h6>
            <div class="small text-muted">Lọc theo môn & thêm giỏ</div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a href="/cart" class="card border-0 shadow-sm p-3 text-decoration-none h-100 portal-card text-center text-md-start">
            <div class="portal-icon bg-success-subtle text-success mb-2 mx-auto mx-md-0">
                <i class="bi bi-cart-check"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">Giỏ Đăng Ký</h6>
            <div class="small text-muted">Kiểm tra & gửi phiếu</div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a href="/schedule" class="card border-0 shadow-sm p-3 text-decoration-none h-100 portal-card text-center text-md-start">
            <div class="portal-icon bg-info-subtle text-info-emphasis mb-2 mx-auto mx-md-0">
                <i class="bi bi-calendar3"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">Thời Khóa Biểu</h6>
            <div class="small text-muted">Lịch học tuần & in TKB</div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        @if (currentRole == "Admin")
        {
            <a href="/admin/courses" class="card border-0 shadow-sm p-3 text-decoration-none h-100 portal-card text-center text-md-start">
                <div class="portal-icon bg-primary-subtle text-primary mb-2 mx-auto mx-md-0">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Quản Lý Học Phần</h6>
                <div class="small text-muted">Môn học & phân công</div>
            </a>
        }
        else if (!isAuthenticated)
        {
            <button type="button" 
                    class="card border-0 shadow-sm p-3 text-decoration-none h-100 portal-card text-center text-md-start w-100 bg-white"
                    @onclick="() => LoginModalService.Open()">
                <div class="portal-icon bg-warning-subtle text-warning-emphasis mb-2 mx-auto mx-md-0">
                    <i class="bi bi-box-arrow-in-right"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Đăng Nhập</h6>
                <div class="small text-muted">Tài khoản sinh viên & quản trị</div>
            </button>
        }
        else
        {
            <a href="/schedule" class="card border-0 shadow-sm p-3 text-decoration-none h-100 portal-card text-center text-md-start">
                <div class="portal-icon bg-secondary-subtle text-secondary mb-2 mx-auto mx-md-0">
                    <i class="bi bi-mortarboard"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Cổng Sinh Viên</h6>
                <div class="small text-muted">Dành cho Sinh viên</div>
            </a>
        }
    </div>
</div>

<!-- ============================================================== -->
<!-- MỤC KÉO MỞ ĐỌC THÔNG TIN & QUY CHẾ (GỌN GÀNG, KHÔNG RƯỜM RÀ) -->
<!-- ============================================================== -->
<div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <div>
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-info-circle text-primary me-2"></i>Thông Tin Hướng Dẫn & Quy Chế Đào Tạo
            </h5>
            <small class="text-muted">Cổng Thông Tin Học Vụ &bull; Giai đoạn Học kỳ 1 (2026 - 2027)</small>
        </div>
        <span class="badge bg-light text-muted border small d-none d-sm-inline">
            <i class="bi bi-arrows-expand me-1"></i>Nhấn để mở / đóng
        </span>
    </div>

    <div class="accordion accordion-flush" id="portalAccordion">
        <!-- MỤC 1: LỘ TRÌNH 2 HỌC KỲ & 3 GIAI ĐOẠN LINH HOẠT -->
        <div class="accordion-item border rounded-3 mb-2 overflow-hidden">
            <h2 class="accordion-header">
                <button class="accordion-button @(isTimelineOpen ? "" : "collapsed") fw-bold py-3" 
                        type="button" 
                        @onclick="() => isTimelineOpen = !isTimelineOpen">
                    <i class="bi bi-clock-history text-primary me-2"></i> 1. Kế hoạch & Lịch trình Đăng ký 2 Học kỳ (Năm học 2026 - 2027)
                </button>
            </h2>
            <div class="accordion-collapse collapse @(isTimelineOpen ? "show" : "")">
                <div class="accordion-body bg-light-subtle pt-3">
                    <!-- Học kỳ 1 -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-calendar-check text-primary me-1"></i> Học kỳ 1 (2026 - 2027)
                            </h6>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                <i class="bi bi-play-circle-fill me-1"></i> Đang diễn ra (Thời gian thực)
                            </span>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <div class="p-3 border rounded-3 bg-white h-100">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">Giai đoạn 1</span>
                                        <span class="badge bg-light text-muted border small">Đã xong</span>
                                    </div>
                                    <div class="fw-bold small text-dark">Đăng Ký Chính Thức</div>
                                    <div class="text-muted small">15/10/2026 &rarr; 26/10/2026</div>
                                    <p class="text-secondary small mb-0 mt-1" style="font-size: 0.8rem;">
                                        Đăng ký môn học theo lộ trình chuẩn CTĐT của khóa.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border border-primary border-2 rounded-3 bg-primary-subtle-light h-100 shadow-sm position-relative">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="badge bg-primary text-white rounded-pill">Giai đoạn 2</span>
                                        <span class="badge bg-success text-white small">🟢 Đang mở</span>
                                    </div>
                                    <div class="fw-bold small text-primary">ĐK Bổ Sung &amp; Học Vượt</div>
                                    <div class="text-primary fw-semibold small">27/10/2026 &rarr; 05/11/2026</div>
                                    <p class="text-dark small mb-1 mt-1" style="font-size: 0.8rem;">
                                        Đăng ký thêm lớp còn slot, đổi nhóm lớp, sinh viên học vượt hoặc học cải thiện.
                                    </p>
                                    <div class="badge bg-success-subtle text-success py-1 px-2 rounded-2 small mt-1">
                                        <i class="bi bi-broadcast me-1"></i>Đang mở cổng trực tuyến
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded-3 bg-white h-100">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="badge bg-light text-muted border rounded-pill">Giai đoạn 3</span>
                                        <span class="badge bg-light text-muted border small">Sắp diễn ra</span>
                                    </div>
                                    <div class="fw-bold small text-dark">Rút Môn &amp; Nộp Học Phí</div>
                                    <div class="text-muted small">06/11/2026 &rarr; 20/11/2026</div>
                                    <p class="text-secondary small mb-0 mt-1" style="font-size: 0.8rem;">
                                        Rút học phần không tính điểm rớt, thanh toán học phí VietQR và chốt danh sách thi.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Học kỳ 2 -->
                    <div class="pt-2 border-top">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="fw-bold mb-0 text-muted">
                                <i class="bi bi-calendar3 text-secondary me-1"></i> Học kỳ 2 (2026 - 2027)
                            </h6>
                            <span class="badge bg-secondary text-white px-2 py-1 rounded-pill small">Kế hoạch tiếp theo</span>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white">
                                    <div class="badge bg-light text-muted border mb-1">GĐ 1: ĐK Chính Thức</div>
                                    <div class="text-muted small">15/12/2026 &rarr; 28/12/2026</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white">
                                    <div class="badge bg-light text-muted border mb-1">GĐ 2: ĐK Bổ Sung &amp; Vượt</div>
                                    <div class="text-muted small">29/12/2026 &rarr; 08/01/2027</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white">
                                    <div class="badge bg-light text-muted border mb-1">GĐ 3: Rút Môn &amp; Học Phí</div>
                                    <div class="text-muted small">09/01/2027 &rarr; 22/01/2027</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 pt-2 border-top d-flex justify-content-end">
                        <a href="/sections?tab=plan" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                            <i class="bi bi-calendar3-range me-1.5"></i> Xem Chi Tiết Kế Hoạch 3 Giai Đoạn &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MỤC 2: QUY CHẾ TÍN CHỈ & HỦY RÚT MÔN SAU HẠN -->
        <div class="accordion-item border rounded-3 mb-2 overflow-hidden">
            <h2 class="accordion-header">
                <button class="accordion-button @(isRulesOpen ? "" : "collapsed") fw-bold py-3" 
                        type="button" 
                        @onclick="() => isRulesOpen = !isRulesOpen">
                    <i class="bi bi-shield-check text-success me-2 fs-5"></i> 2. Quy chế Đào tạo Tín chỉ &amp; Hủy / Rút môn học vụ
                </button>
            </h2>
            <div class="accordion-collapse collapse @(isRulesOpen ? "show" : "")">
                <div class="accordion-body bg-light-subtle p-3 p-md-4">
                    <div class="row g-3">
                        <!-- Quy định 1 -->
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm p-3 rounded-3 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle" style="width: 36px; height: 36px;">
                                            <i class="bi bi-mortarboard-fill"></i>
                                        </div>
                                        <span class="fw-bold text-dark">1. Hạn mức tín chỉ đăng ký</span>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary px-2 py-1 small">14 - 24 Tín chỉ</span>
                                </div>
                                <p class="text-secondary small mb-0" style="line-height: 1.6;">
                                    Sinh viên có học lực bình thường được đăng ký tối thiểu <strong>14 tín chỉ</strong> và tối đa <strong>24 tín chỉ</strong> trong một học kỳ (đối với sinh viên có điểm trung bình tích lũy GPA từ <strong>2.50</strong> trở lên). Sinh viên thuộc diện cảnh báo học vụ được phép đăng ký tối đa <strong>14 tín chỉ</strong>.
                                </p>
                            </div>
                        </div>

                        <!-- Quy định 2 -->
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm p-3 rounded-3 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning-emphasis rounded-circle" style="width: 36px; height: 36px;">
                                            <i class="bi bi-diagram-3-fill"></i>
                                        </div>
                                        <span class="fw-bold text-dark">2. Điều kiện học phần tiên quyết</span>
                                    </div>
                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1 small">Điểm đạt ≥ 4.0 / 10</span>
                                </div>
                                <p class="text-secondary small mb-0" style="line-height: 1.6;">
                                    Bắt buộc sinh viên phải tích lũy điểm đạt (từ <strong>4.0 / 10</strong> trở lên) ở học phần tiên quyết mới đủ điều kiện đăng ký môn học kế tiếp. <em>Ví dụ: Phải qua môn Lập trình Hướng đối tượng (TIN102) mới được đăng ký môn Lập trình Ứng dụng Web (WEB301)</em>. Hệ thống tự động kiểm tra CSDL và khóa đăng ký nếu chưa đạt.
                                </p>
                            </div>
                        </div>

                        <!-- Quy định 3 -->
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm p-3 rounded-3 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="d-inline-flex align-items-center justify-content-center bg-info-subtle text-info-emphasis rounded-circle" style="width: 36px; height: 36px;">
                                            <i class="bi bi-calendar2-week-fill"></i>
                                        </div>
                                        <span class="fw-bold text-dark">3. Chống trùng lịch &amp; Sĩ số lớp</span>
                                    </div>
