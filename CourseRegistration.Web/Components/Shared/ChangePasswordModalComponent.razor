@namespace CourseRegistration.Web.Components.Shared
@inject IChangePasswordModalService ChangePasswordModalService
@inject IChangePasswordUseCase ChangePasswordUseCase
@inject ICurrentUserStateStore CurrentUserStateStore
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (ChangePasswordModalService.IsVisible)
{
    <div class="login-modal-overlay">
        <div class="login-modal-dialog" style="max-width: 470px;">
            <div class="login-modal-content card border-0 shadow-2xl rounded-4 overflow-hidden">
                <!-- Header Gradient -->
                <div class="text-white text-center py-4 px-4 position-relative" 
                     style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 40%, #0d9488 100%);">
                    <button type="button" 
                            class="btn-close-modal position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center" 
                            @onclick="CloseModal"
                            aria-label="Đóng">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <div class="mb-2">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle shadow-xs" 
                              style="width: 58px; height: 58px; background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.25);">
                            <i class="bi bi-key-fill fs-2 text-warning"></i>
                        </span>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">Đổi Mật Khẩu</h4>
                    <div class="text-white-50 small">
                        @if (currentUser != null)
                        {
                            <span>
                                Tài khoản: <strong class="text-white">@currentUser.Username</strong>
                                @if (currentUser.Role == "Admin")
                                {
                                    <span class="badge bg-danger ms-1 px-1.5 py-0.5" style="font-size: 0.7rem;">Cán bộ Quản trị</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary ms-1 px-1.5 py-0.5" style="font-size: 0.7rem;">Sinh viên</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span>Cập nhật mật khẩu bảo mật tài khoản</span>
                        }
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body p-4 bg-white">
                    @if (isSuccess)
                    {
                        <div class="alert alert-success d-flex align-items-center rounded-3 mb-3 py-3 px-3 shadow-xs" role="alert">
                            <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-4 text-success"></i>
                            <div>
                                <div class="fw-bold">Đổi mật khẩu thành công!</div>
                                <div class="small text-secondary">Mật khẩu mới đã được cập nhật an toàn vào hệ thống. Đang đóng cửa sổ...</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger d-flex align-items-center rounded-3 mb-3 py-2 px-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                                <div class="small fw-semibold">
                                    @errorMessage
                                </div>
                            </div>
                        }

                        <form method="post" action="" @onsubmit="HandleChangePassword" @onsubmit:preventDefault="true">
                            <!-- Mật khẩu hiện tại -->
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small mb-1" for="current-password">
                                    Mật khẩu hiện tại <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input type="@(showCurrentPassword ? "text" : "password")" 
                                           class="form-control border-start-0 border-end-0 ps-0 bg-light" 
                                           placeholder="Nhập mật khẩu bạn đang sử dụng" 
                                           id="current-password"
                                           name="current-password"
                                           autocomplete="current-password"
                                           @bind="model.CurrentPassword" 
                                           @bind:event="oninput" />
                                    <button type="button" 
                                            class="input-group-text bg-light border-start-0 text-muted cursor-pointer" 
                                            @onclick="() => showCurrentPassword = !showCurrentPassword"
                                            title="@(showCurrentPassword ? "Ẩn" : "Hiện")">
                                        <i class="bi @(showCurrentPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Mật khẩu mới -->
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small mb-1" for="new-password">
                                    Mật khẩu mới <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>
                                    <input type="@(showNewPassword ? "text" : "password")" 
                                           class="form-control border-start-0 border-end-0 ps-0 bg-light" 
                                           placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" 
                                           id="new-password"
                                           name="new-password"
                                           autocomplete="new-password"
                                           @bind="model.NewPassword" 
                                           @bind:event="oninput" />
                                    <button type="button" 
                                            class="input-group-text bg-light border-start-0 text-muted cursor-pointer" 
                                            @onclick="() => showNewPassword = !showNewPassword"
                                            title="@(showNewPassword ? "Ẩn" : "Hiện")">
                                        <i class="bi @(showNewPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                    </button>
                                </div>

                                <!-- Password Strength Meter -->
                                @if (!string.IsNullOrEmpty(model.NewPassword))
                                {
                                    var strength = EvaluateStrength(model.NewPassword);
                                    <div class="mt-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.72rem;">
                                            <span class="text-muted">Độ an toàn:</span>
                                            <span class="fw-bold @strength.ColorClass">@strength.Label</span>
                                        </div>
                                        <div class="progress" style="height: 4px;">
                                            <div class="progress-bar @strength.BarClass" role="progressbar" style="width: @(strength.Percent)%"></div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Xác nhận mật khẩu mới -->
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small mb-1" for="confirm-password">
                                    Xác nhận mật khẩu mới <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <input type="@(showConfirmPassword ? "text" : "password")" 
                                           class="form-control border-start-0 border-end-0 ps-0 bg-light" 
                                           placeholder="Nhập lại mật khẩu mới để xác nhận" 
                                           id="confirm-password"
                                           name="confirm-password"
                                           autocomplete="new-password"
                                           @bind="model.ConfirmPassword" 
                                           @bind:event="oninput" />
                                    <button type="button" 
                                            class="input-group-text bg-light border-start-0 text-muted cursor-pointer" 
                                            @onclick="() => showConfirmPassword = !showConfirmPassword"
                                            title="@(showConfirmPassword ? "Ẩn" : "Hiện")">
                                        <i class="bi @(showConfirmPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(model.ConfirmPassword))
                                {
                                    @if (model.NewPassword == model.ConfirmPassword)
                                    {
                                        <div class="text-success small mt-1" style="font-size: 0.74rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Mật khẩu xác nhận trùng khớp
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-danger small mt-1" style="font-size: 0.74rem;">
                                            <i class="bi bi-x-circle-fill me-1"></i>Mật khẩu xác nhận chưa khớp
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Tiêu chí bảo mật -->
                            <div class="p-2.5 bg-light rounded-3 mb-3" style="font-size: 0.75rem;">
                                <div class="fw-bold text-dark mb-1">Yêu cầu bảo mật:</div>
                                <div class="d-flex flex-column gap-1 text-muted">
                                    <div class="d-flex align-items-center gap-1.5 @(model.NewPassword?.Length >= 6 ? "text-success fw-semibold" : "")">
                                        <i class="bi @(model.NewPassword?.Length >= 6 ? "bi-check-circle-fill text-success" : "bi-circle text-muted")"></i>
                                        <span>Tối thiểu 6 ký tự</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1.5 @(!string.IsNullOrEmpty(model.NewPassword) && model.NewPassword != model.CurrentPassword ? "text-success fw-semibold" : "")">
                                        <i class="bi @(!string.IsNullOrEmpty(model.NewPassword) && model.NewPassword != model.CurrentPassword ? "bi-check-circle-fill text-success" : "bi-circle text-muted")"></i>
                                        <span>Khác với mật khẩu hiện tại</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-1.5 @(!string.IsNullOrEmpty(model.ConfirmPassword) && model.NewPassword == model.ConfirmPassword ? "text-success fw-semibold" : "")">
                                        <i class="bi @(!string.IsNullOrEmpty(model.ConfirmPassword) && model.NewPassword == model.ConfirmPassword ? "bi-check-circle-fill text-success" : "bi-circle text-muted")"></i>
                                        <span>Xác nhận mật khẩu chính xác</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Các nút thao tác -->
                            <div class="d-flex gap-2">
                                <button type="button" 
                                        class="btn btn-outline-secondary flex-fill py-2 fw-semibold rounded-3" 
                                        @onclick="CloseModal"
                                        disabled="@isLoading">
                                    Hủy bỏ
                                </button>
                                <button type="submit" 
                                        class="btn btn-primary flex-fill py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-1.5"
                                        disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Đang cập nhật...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check2-circle fs-5"></i>
                                        <span>Cập Nhật Mật Khẩu</span>
                                    }
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ChangePasswordViewModel model = new ChangePasswordViewModel();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isSuccess = false;
    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;
    private UserAccount? currentUser;

    protected override void OnInitialized()
    {
        ChangePasswordModalService.OnChange += HandleModalStateChange;
    }

    private async void HandleModalStateChange()
    {
        if (ChangePasswordModalService.IsVisible)
        {
            errorMessage = string.Empty;
            isSuccess = false;
            isLoading = false;
            showCurrentPassword = false;
            showNewPassword = false;
            showConfirmPassword = false;
            model = new ChangePasswordViewModel();
            currentUser = await CurrentUserStateStore.GetCurrentUserAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        ChangePasswordModalService.Close();
    }

    private async Task HandleChangePassword()
    {
        errorMessage = string.Empty;

        if (currentUser == null || currentUser.AccountId <= 0)
        {
            currentUser = await CurrentUserStateStore.GetCurrentUserAsync();
            if (currentUser == null || currentUser.AccountId <= 0)
            {
                errorMessage = "Phiên làm việc đã hết hạn. Vui lòng đăng nhập lại.";
                return;
            }
        }

        isLoading = true;

        try
        {
            var result = await ChangePasswordUseCase.ExecuteAsync(
                currentUser.AccountId,
                model.CurrentPassword,
                model.NewPassword,
                model.ConfirmPassword
            );

            if (result.Success)
            {
                isSuccess = true;
                
                // Cập nhật thông tin mật khẩu trong bộ nhớ hiện tại
                currentUser.Password = model.NewPassword.Trim();
                await CurrentUserStateStore.SetCurrentUserAsync(currentUser);

                // Kích hoạt Chrome cập nhật mật khẩu mới đã lưu
                try
                {
                    await JSRuntime.InvokeVoidAsync("triggerBrowserSavePassword", currentUser.Username, model.NewPassword.Trim());
                }
                catch { }

                StateHasChanged();

                // Đóng modal sau 1.2s để người dùng thấy thông báo thành công
                await Task.Delay(1200);
                ChangePasswordModalService.Close();
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Có lỗi xảy ra: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private (string Label, string ColorClass, string BarClass, int Percent) EvaluateStrength(string password)
    {
        if (string.IsNullOrEmpty(password)) return ("Rất yếu", "text-danger", "bg-danger", 10);
        int score = 0;
        if (password.Length >= 6) score += 25;
        if (password.Length >= 8) score += 25;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower)) score += 25;
        if (password.Any(char.IsDigit) && password.Any(ch => !char.IsLetterOrDigit(ch))) score += 25;

        if (score <= 25) return ("Yếu", "text-danger", "bg-danger", 25);
        if (score <= 50) return ("Trung bình", "text-warning", "bg-warning", 50);
        if (score <= 75) return ("Khá an toàn", "text-info", "bg-info", 75);
        return ("Rất mạnh", "text-success", "bg-success", 100);
    }

    public void Dispose()
    {
        ChangePasswordModalService.OnChange -= HandleModalStateChange;
    }

    public class ChangePasswordViewModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
