@page "/login"
@namespace CourseRegistration.Web.Components.Pages
@inject ILoginModalService LoginModalService
@inject NavigationManager NavigationManager

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        // Khi người dùng hoặc liên kết nào dẫn tới /login:
        // Lập tức mở popup Đăng nhập tại chỗ và chuyển hướng về trang chủ/trang đích,
        // triệt để không bao giờ hiển thị trang trắng cô lập.
        LoginModalService.Open();
        var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.Equals("/login", StringComparison.OrdinalIgnoreCase)
            ? ReturnUrl
            : "/";
        NavigationManager.NavigateTo(target, replace: true);
    }
}
