@namespace CourseRegistration.Web.Components.Shared
@inject ILoginModalService LoginModalService
@inject ILoginUseCase LoginUseCase
@inject ICurrentUserStateStore CurrentUserStateStore
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (LoginModalService.IsVisible)
{
    <!-- Modal Backdrop Overlay (Cố định: không bị mất modal khi chạm ra bên ngoài) -->
    <div class="login-modal-overlay">
        <div class="login-modal-dialog">
            <!-- Modal Card -->
            <div class="login-modal-content card border-0 shadow-2xl rounded-4 overflow-hidden">
                <!-- Header Gradient -->
                <div class="login-modal-header text-white text-center py-4 px-4 position-relative">
                    <button type="button" 
                            class="btn-close-modal position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center" 
                            @onclick="CloseModal"
                            aria-label="Đóng">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <div class="mb-2">
                        <i class="bi bi-mortarboard-fill fs-1 text-white"></i>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">Đăng Nhập Hệ Thống</h4>
                    <div class="text-white-50 small">Cổng Đăng Ký Học Phần Trực Tuyến</div>
                </div>

                <!-- Body: Form Đăng Nhập -->
                <div class="card-body p-4 p-md-4 bg-white">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center rounded-3 mb-3 py-2 px-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                            <div class="small fw-semibold">
                                @errorMessage
                            </div>
                        </div>
                    }

                    <form id="loginForm" name="loginForm" method="post" action="" @onsubmit="HandleLogin" @onsubmit:preventDefault="true" autocomplete="on">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small mb-1" for="username">Tài khoản / MSSV <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" 
                                       class="form-control border-start-0 ps-0 bg-light" 
                                       placeholder="Nhập mã sinh viên hoặc tên đăng nhập" 
                                       id="username"
                                       name="username"
                                       autocomplete="username"
                                       autocorrect="off"
                                       autocapitalize="off"
                                       spellcheck="false"
                                       @bind="loginModel.Username" 
                                       @bind:event="oninput" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small mb-1" for="password">Mã truy cập (Mật khẩu) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-shield-lock"></i>
                                </span>
                                <input type="@(showPassword ? "text" : "password")" 
                                       class="form-control border-start-0 border-end-0 ps-0 bg-light" 
                                       placeholder="Nhập mã truy cập của bạn" 
                                       id="password"
                                       name="password"
                                       autocomplete="current-password"
                                       autocorrect="off"
                                       autocapitalize="off"
                                       spellcheck="false"
                                       @bind="loginModel.Password" 
                                       @bind:event="oninput" />
                                <button type="button" 
                                        class="input-group-text bg-light border-start-0 text-muted cursor-pointer" 
                                        @onclick="() => showPassword = !showPassword"
                                        title="@(showPassword ? "Ẩn mã truy cập" : "Hiện mã truy cập")">
                                    <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Nút Đăng Nhập -->
                        <button type="submit" 
                                class="btn btn-primary w-100 py-2.5 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3"
                                disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Đang xác thực...</span>
                            }
                            else
                            {
                                <i class="bi bi-box-arrow-in-right fs-5"></i>
                                <span>Đăng Nhập</span>
                            }
                        </button>
                    </form>

                    <div class="mt-3 pt-3 border-top text-center text-secondary small" style="font-size: 0.78rem;">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Hệ thống xác thực tài khoản sinh viên &amp; cán bộ quản trị.
                        <div class="mt-1 text-muted" style="font-size: 0.74rem;">
                            Quên mật khẩu hoặc cần cấp lại tài khoản? Vui lòng liên hệ <span class="fw-semibold text-dark">Phòng Đào Tạo</span>.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



@if (showSavePasswordPopup)
{
    <!-- HỘP THOẠI LƯU MẬT KHẨU CỦA CHROME (BUBBLE GÓC TRÊN BÊN PHẢI) -->
    <div class="chrome-save-password-bubble" 
         style="position: fixed; top: 14px; right: 24px; z-index: 10600; width: 382px; max-width: calc(100vw - 28px); background: #ffffff; border-radius: 16px; box-shadow: 0 10px 32px rgba(0, 0, 0, 0.28), 0 2px 8px rgba(0, 0, 0, 0.1); border: 1px solid rgba(0, 0, 0, 0.08); padding: 20px 22px 16px 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; animation: chromeBubbleSlideDown 0.22s cubic-bezier(0.16, 1, 0.3, 1);">
        
        <!-- Nút đóng 'X' góc phải trên -->
        <button type="button" 
                class="btn btn-sm btn-icon position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center text-muted border-0 bg-transparent" 
                style="width: 28px; height: 28px; border-radius: 50%;" 
                @onclick="DismissSavePasswordPopup" 
                aria-label="Đóng">
            <i class="bi bi-x-lg" style="font-size: 13px;"></i>
        </button>

        <!-- Illustration trên đầu y hệt Google Chrome -->
        <div class="text-center mb-3">
            <svg width="240" height="74" viewBox="0 0 240 74" fill="none" xmlns="http://www.w3.org/2000/svg" style="max-width: 100%; height: auto;">
                <!-- Floating pale green polygon top left -->
                <polygon points="26,14 36,9 46,14 46,26 36,31 26,26" fill="#C4EED0" opacity="0.85" />
                
                <!-- Soft light blue cloud/pill container -->
                <rect x="62" y="10" width="136" height="52" rx="26" fill="#E8F0FE" />
                <rect x="74" y="21" width="112" height="30" rx="15" fill="#D3E3FD" />
                
                <!-- Security icons inside capsule -->
                <circle cx="88" cy="36" r="6" fill="#1A73E8" />
                <polygon points="101,31 106,33 106,39 101,41 96,39 96,33" fill="#1A73E8" />
                <circle cx="116" cy="36" r="5" fill="#7CBBF3" />
                <polygon points="128,30 134,36 128,42 122,36" fill="#7CBBF3" />
                <polygon points="142,31 147,35 145,41 139,41 137,35" fill="#34A853" />
                <polygon points="155,31 160,33 160,39 155,41 150,39 150,33" fill="#34A853" />
                <circle cx="170" cy="36" r="6" fill="#81C995" />
                
                <!-- Blue checkmark circle badge top right -->
                <circle cx="180" cy="20" r="10" fill="#1A73E8" />
                <path d="M176 20 l3 3 l6 -6" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                
                <!-- Floating pale green polygon bottom right -->
                <polygon points="198,46 206,42 214,46 214,56 206,60 198,56" fill="#C4EED0" opacity="0.85" />
            </svg>
        </div>

        <!-- Key Icon + Tiêu đề "Lưu mật khẩu?" -->
        <div class="d-flex align-items-center mb-3">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="me-2 flex-shrink-0" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 12a4 4 0 1 1 8 0 4 4 0 0 1-8 0z" fill="#34A853" />
                <circle cx="8" cy="12" r="2" fill="#ffffff" />
                <rect x="11" y="11" width="9" height="2" fill="#FBBC04" rx="1" />
                <rect x="18" y="13" width="2" height="3" fill="#1A73E8" rx="0.5" />
                <rect x="15" y="13" width="2" height="2" fill="#1A73E8" rx="0.5" />
            </svg>
            <h6 class="mb-0 fw-bold text-dark" style="font-size: 1.15rem; letter-spacing: -0.2px;">Lưu mật khẩu?</h6>
        </div>

        <!-- Form fields: Tên người dùng & Mật khẩu -->
        <div class="mb-2 d-flex align-items-center">
            <label class="small mb-0" style="width: 110px; font-size: 0.85rem; color: #444746;">Tên người dùng</label>
            <div class="flex-grow-1">
                <input type="text" 
                       class="form-control form-control-sm" 
                       style="border: 1px solid #747775; border-radius: 8px; font-size: 0.88rem; padding: 6px 12px; color: #1f1f1f; background-color: #fff;" 
                       @bind="savedUsername" />
            </div>
        </div>

        <div class="mb-3 d-flex align-items-center">
            <label class="small mb-0" style="width: 110px; font-size: 0.85rem; color: #444746;">Mật khẩu</label>
            <div class="flex-grow-1 position-relative">
                <input type="@(showSavedPasswordInPopup ? "text" : "password")" 
                       class="form-control form-control-sm pe-4" 
                       style="border: 1px solid #747775; border-radius: 8px; font-size: 0.88rem; padding: 6px 12px; color: #1f1f1f; background-color: #fff;" 
                       @bind="savedPassword" />
                <button type="button" 
                        class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted p-0 me-2 border-0 shadow-none" 
                        style="text-decoration: none;"
                        @onclick="() => showSavedPasswordInPopup = !showSavedPasswordInPopup"
                        title="@(showSavedPasswordInPopup ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                    <i class="bi @(showSavedPasswordInPopup ? "bi-eye-slash-fill" : "bi-eye-fill")" style="font-size: 0.95rem; color: #5f6368;"></i>
                </button>
            </div>
        </div>

        <!-- 3 Nút Hành Động: Không bao giờ - Lưu - Không, cảm ơn -->
        <div class="d-flex align-items-center justify-content-end gap-2 mt-3 pt-1">
            <button type="button" 
                    class="btn fw-semibold shadow-none" 
                    style="background-color: #edf2fa; color: #0b57d0; border: none; border-radius: 999px; font-size: 0.84rem; padding: 7px 14px;"
                    @onclick="DismissSavePasswordPopup">
                Không bao giờ
            </button>
            <button type="button" 
                    class="btn fw-bold shadow-none" 
                    style="background-color: #0b57d0; color: #ffffff; border: none; border-radius: 999px; font-size: 0.84rem; padding: 7px 22px;"
                    @onclick="HandleSavePassword">
                Lưu
            </button>
            <button type="button" 
                    class="btn fw-semibold shadow-none" 
                    style="background-color: #edf2fa; color: #0b57d0; border: none; border-radius: 999px; font-size: 0.84rem; padding: 7px 14px;"
                    @onclick="DismissSavePasswordPopup">
                Không, cảm ơn
            </button>
        </div>

        <!-- Chú thích chân hộp thoại -->
        <div class="border-top mt-3 pt-2 text-start" style="border-color: #e1e3e1 !important;">
            <div style="font-size: 0.74rem; color: #444746; line-height: 1.45;">
                Bạn có thể dùng các mật khẩu đã lưu trên mọi thiết bị. Các mật khẩu đó được lưu vào 
                <span style="color: #0b57d0; text-decoration: underline; cursor: pointer;">Trình quản lý mật khẩu</span> cho 23k4080024@@hce.edu.vn.
            </div>
        </div>

    </div>
}

<style>
    @@keyframes chromeBubbleSlideDown {
        from {
            opacity: 0;
            transform: translateY(-12px) scale(0.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

@code {
    private LoginViewModel loginModel = new LoginViewModel();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;
    private bool showBreachWarningModal = false;
    private bool showSavePasswordPopup = false;
    private bool showSavedPasswordInPopup = false;
    private string savedUsername = string.Empty;
    private string savedPassword = string.Empty;
    private UserAccount? pendingAccount = null;
    private bool isConfirming = false;

    protected override void OnInitialized()
    {
        LoginModalService.OnChange += HandleModalStateChange;
    }

    private void HandleModalStateChange()
    {
        if (LoginModalService.IsVisible)
        {
            errorMessage = string.Empty;
            loginModel = new LoginViewModel();
            showPassword = false;
            showBreachWarningModal = false;
            showSavePasswordPopup = false;
            showSavedPasswordInPopup = false;
            isConfirming = false;
        }
        InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        showBreachWarningModal = false;
        showSavePasswordPopup = false;
        isConfirming = false;
        LoginModalService.Close();
    }

    private async Task HandleLogin()
    {
        if (isLoading) return;

        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var username = loginModel.Username.Trim();
            var password = loginModel.Password;

            var account = await LoginUseCase.ExecuteAsync(username, password);
            if (account != null)
            {
                // 1. Cập nhật phiên đăng nhập của người dùng
                await CurrentUserStateStore.SetCurrentUserAsync(account);

                // 2. Lưu thông tin xác thực để hiển thị trên popup lưu mật khẩu
                savedUsername = username;
                savedPassword = password;
                pendingAccount = account;

                // 3. Đóng form nhập liệu đăng nhập
                LoginModalService.Close();

                // 4. Nếu người dùng đang ở trang /login riêng biệt, chuyển hướng tương ứng
                var uri = new Uri(NavigationManager.Uri);
                if (uri.AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase))
                {
                    if (string.Equals(account.Role, "Admin", StringComparison.OrdinalIgnoreCase))
                    {
                        NavigationManager.NavigateTo("/admin");
                    }
                    else
                    {
                        NavigationManager.NavigateTo("/");
                    }
                }

                // 5. Lưu thông tin xác thực an toàn vào LocalStorage (không hiển thị cảnh báo rò rỉ do code website tạo ra)
                try
                {
                    await JSRuntime.InvokeVoidAsync("authStorage.saveCredentials", savedUsername, savedPassword, true);
                }
                catch { }

                showBreachWarningModal = false;
                showSavePasswordPopup = false;
            }
            else
            {
                errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác. Vui lòng thử lại!";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Có lỗi xảy ra trong quá trình đăng nhập: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmBreachWarningAndProceed()
    {
        if (isConfirming) return;
        isConfirming = true;

        try
        {
            // Đóng cảnh báo thay đổi mật khẩu trên giao diện website
            showBreachWarningModal = false;

            // Đóng sạch sẽ mọi popup, không kích hoạt form ngầm để Chrome máy tính không bị nhảy cảnh báo native
            showSavePasswordPopup = false;

            // Lưu an toàn vào LocalStorage
            try
            {
                await JSRuntime.InvokeVoidAsync("authStorage.saveCredentials", savedUsername, savedPassword, true);
            }
            catch { }
        }
        finally
        {
            isConfirming = false;
        }
    }

    private async Task HandleSavePassword()
    {
        showSavePasswordPopup = false;

        // Lưu thông tin đăng nhập và kích hoạt Browser Credential Manager
        try
        {
            await JSRuntime.InvokeVoidAsync("authStorage.saveCredentials", savedUsername, savedPassword, true);
            await JSRuntime.InvokeVoidAsync("triggerBrowserSavePassword", savedUsername, savedPassword);
        }
        catch { }
    }

    private void DismissSavePasswordPopup()
    {
        showSavePasswordPopup = false;
    }

    public void Dispose()
    {
        LoginModalService.OnChange -= HandleModalStateChange;
    }

    public class LoginViewModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}

