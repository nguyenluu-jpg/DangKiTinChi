@namespace CourseRegistration.Web.Components.Shared

<div class="card h-100 shadow-sm border-0 section-card bg-white position-relative overflow-hidden">
    <!-- Accent indicator top border -->
    <div style="height: 4px; background: @(Section.HasAvailableSlot ? "linear-gradient(90deg, #2563eb, #38bdf8)" : "#cbd5e1");"></div>

    <div class="card-header bg-transparent border-bottom-0 pb-0 pt-3">
        <div class="d-flex justify-content-between align-items-center">
            <span class="badge bg-primary-subtle text-primary fw-bold fs-6">
                @Section.SectionCode
            </span>
            <span class="badge @(Section.HasAvailableSlot ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                <i class="bi @(Section.HasAvailableSlot ? "bi-check-circle" : "bi-dash-circle") me-1"></i>
                @(Section.HasAvailableSlot ? $"Còn {Section.AvailableSlots} chỗ" : "Đã hết chỗ")
            </span>
        </div>
    </div>

    <div class="card-body d-flex flex-column">
        <h5 class="card-title text-dark fw-bold mb-1">
            @(Section.Course?.CourseName ?? "Học phần")
        </h5>
        
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="text-muted small">Mã HP: <strong>@(Section.Course?.CourseCode)</strong></span>
            <span class="badge bg-secondary">@(Section.Course?.Credits ?? 0) Tín chỉ</span>
        </div>

        <!-- Cảnh báo Tiên quyết trực quan -->
        @if (!string.IsNullOrEmpty(PrerequisiteWarning))
        {
            <div class="alert alert-warning py-1 px-2 small mb-3 border-0 bg-warning-subtle text-warning-emphasis d-flex align-items-center rounded-2">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                <div class="lh-sm">@PrerequisiteWarning</div>
            </div>
        }
        else if (HasPrerequisiteMet)
        {
            <div class="text-success small mb-2 d-flex align-items-center">
                <i class="bi bi-patch-check-fill me-1"></i>
                <span>Đủ điều kiện môn tiên quyết</span>
            </div>
        }

        <div class="p-2 bg-light rounded-3 small mb-3">
            <div class="mb-1"><i class="bi bi-person-badge text-secondary me-1"></i> Giảng viên: <strong>@Section.Instructor</strong></div>
            <div class="mb-1"><i class="bi bi-geo-alt text-secondary me-1"></i> Phòng: <strong>@(string.IsNullOrEmpty(Section.Room) ? "Chưa sắp xếp" : Section.Room)</strong></div>
            <div>
                <div class="d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-people text-secondary me-1"></i> Sĩ số: <strong>@Section.CurrentEnrollment / @Section.MaxCapacity</strong></span>
                    <span class="text-muted small">@(Section.MaxCapacity > 0 ? (Section.CurrentEnrollment * 100 / Section.MaxCapacity) : 0)%</span>
                </div>
                <div class="progress mt-1" style="height: 6px;">
                    <div class="progress-bar @(Section.CurrentEnrollment >= Section.MaxCapacity ? "bg-danger" : "bg-primary")" 
                         role="progressbar" 
                         style="width: @(Section.MaxCapacity > 0 ? (Section.CurrentEnrollment * 100 / Section.MaxCapacity) : 0)%">
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-auto">
            <div class="small fw-bold text-muted text-uppercase mb-1" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                <i class="bi bi-clock me-1"></i> Lịch học trong tuần
            </div>
            @if (Section.Schedules != null && Section.Schedules.Any())
            {
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var sched in Section.Schedules)
                    {
                        <span class="badge bg-info-subtle text-dark border">
                            @sched.DayOfWeekName (Tiết @sched.StartPeriod-@sched.EndPeriod) - @(string.IsNullOrEmpty(sched.Room) ? Section.Room : sched.Room)
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small fst-italic mb-3">Chưa có lịch cụ thể</div>
            }
        </div>
    </div>

    <div class="card-footer bg-transparent border-top-0 pb-3 pt-0">
        @if (IsInCart)
        {
            <button class="btn btn-outline-danger w-100 py-2 d-flex align-items-center justify-content-center gap-1" @onclick="HandleRemove">
                <i class="bi bi-trash"></i>
                <span>Xóa khỏi giỏ</span>
            </button>
        }
        else
        {
            <button class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-1" 
                    disabled="@(!Section.HasAvailableSlot)"
                    @onclick="HandleAdd">
                <i class="bi @(Section.HasAvailableSlot ? "bi-plus-circle" : "bi-lock")"></i> 
                <span>@(Section.HasAvailableSlot ? "Thêm vào giỏ đăng ký" : "Lớp đã đầy sĩ số")</span>
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Section Section { get; set; } = default!;

    [Parameter]
    public bool IsInCart { get; set; } = false;

    [Parameter]
    public string? PrerequisiteWarning { get; set; }

    [Parameter]
    public bool HasPrerequisiteMet { get; set; } = false;

    [Parameter]
    public EventCallback<Section> OnAddToCart { get; set; }

    [Parameter]
    public EventCallback<int> OnRemoveFromCart { get; set; }

    private async Task HandleAdd()
    {
        if (OnAddToCart.HasDelegate)
        {
            await OnAddToCart.InvokeAsync(Section);
        }
    }

    private async Task HandleRemove()
    {
        if (OnRemoveFromCart.HasDelegate)
        {
            await OnRemoveFromCart.InvokeAsync(Section.SectionId);
        }
    }
}
