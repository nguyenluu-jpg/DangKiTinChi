@namespace CourseRegistration.Web.Components.Shared
@inject ILoginModalService LoginModalService
@inject ILoginUseCase LoginUseCase
@inject ICurrentUserStateStore CurrentUserStateStore
@inject NavigationManager NavigationManager
@implements IDisposable

@if (LoginModalService.IsVisible)
{
    <!-- Modal Backdrop Overlay -->
    <div class="login-modal-overlay" @onclick="CloseModal">
        <div class="login-modal-dialog" @onclick:stopPropagation="true">
            <!-- Modal Card -->
            <div class="login-modal-content card border-0 shadow-2xl rounded-4 overflow-hidden">
                <!-- Header Gradient -->
                <div class="login-modal-header text-white text-center py-4 px-4 position-relative">
                    <button type="button" 
                            class="btn-close-modal position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center" 
                            @onclick="CloseModal"
                            aria-label="Đóng">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <div class="mb-2">
                        <span class="d-inline-flex align-items-center justify-content-center bg-white bg-opacity-20 rounded-circle p-3 shadow-sm">
                            <i class="bi bi-mortarboard-fill fs-2 text-white"></i>
                        </span>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">Đăng Nhập Hệ Thống</h4>
                    <div class="text-white-50 small">Cổng Đăng Ký Học Phần Trực Tuyến</div>
                </div>

                <!-- Form đăng nhập: Bắt onsubmit chuẩn HTML5 để 1 lần bấm Enter hoặc click là ăn ngay lập tức -->
                <form class="card-body p-4 p-md-4 bg-white" @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center rounded-3 mb-3 py-2 px-3 shadow-sm animate-fade-in" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                            <div class="small fw-semibold">
                                @errorMessage
                            </div>
                        </div>
                    }

                    <!-- Tài khoản / MSSV -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1" for="login_username">
                            Tài khoản / MSSV <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-start-0 ps-0 bg-light" 
                                   placeholder="vd: admin hoặc sv21001" 
                                   id="login_username"
                                   autocomplete="username"
                                   @bind="loginModel.Username" 
                                   @bind:event="oninput"
                                   disabled="@isLoading" />
                        </div>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold text-dark small mb-0" for="login_password">
                                Mật khẩu <span class="text-danger">*</span>
                            </label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-shield-lock-fill"></i>
                            </span>
                            <input type="@(showPassword ? "text" : "password")" 
                                   class="form-control border-start-0 border-end-0 ps-0 bg-light" 
                                   placeholder="Nhập mật khẩu..." 
                                   id="login_password"
                                   autocomplete="current-password"
                                   @bind="loginModel.Password" 
                                   @bind:event="oninput"
                                   disabled="@isLoading" />
                            <button type="button" 
                                    class="input-group-text bg-light border-start-0 text-muted cursor-pointer"
                                    @onclick="() => showPassword = !showPassword"
                                    title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Nút Đăng Nhập -->
                    <button type="submit" 
                            class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Đang xác thực...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right fs-5"></i>
                            <span>Đăng Nhập</span>
                        }
                    </button>

                    <!-- Chọn nhanh tài khoản thử nghiệm 1 chạm tiện lợi -->
                    <div class="quick-login-box p-2 rounded-3 bg-light border border-light-subtle mb-2">
                        <div class="text-muted fw-semibold mb-1" style="font-size: 0.73rem;">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Chọn nhanh tài khoản thử nghiệm (1 chạm):
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" 
                                    class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" 
                                    style="font-size: 0.73rem;"
                                    @onclick="@(() => FillAndLogin("sv21001", "123456"))"
                                    disabled="@isLoading">
                                <i class="bi bi-person me-1"></i>sv21001 (SV Tuấn)
                            </button>
                            <button type="button" 
                                    class="btn btn-sm btn-outline-warning text-dark py-0 px-2 rounded-pill" 
                                    style="font-size: 0.73rem;"
                                    @onclick="@(() => FillAndLogin("sv21002", "123456"))"
                                    disabled="@isLoading">
                                <i class="bi bi-person me-1"></i>sv21002 (SV Mai)
                            </button>
                            <button type="button" 
                                    class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill" 
                                    style="font-size: 0.73rem;"
                                    @onclick="@(() => FillAndLogin("admin", "admin123"))"
                                    disabled="@isLoading">
                                <i class="bi bi-shield-lock me-1"></i>admin (Đào Tạo)
                            </button>
                        </div>
                    </div>

                    <div class="mt-2 pt-2 border-top text-center text-secondary small" style="font-size: 0.76rem;">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Hệ thống xác thực tài khoản sinh viên &amp; cán bộ đào tạo.
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@code {
    private LoginViewModel loginModel = new LoginViewModel();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;

    protected override void OnInitialized()
    {
        LoginModalService.OnChange += HandleModalStateChange;
    }

    private void HandleModalStateChange()
    {
        if (LoginModalService.IsVisible)
        {
            errorMessage = string.Empty;
            loginModel = new LoginViewModel();
            showPassword = false;
            isLoading = false;
        }
        InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        LoginModalService.Close();
    }

    private async Task FillAndLogin(string username, string password)
    {
        loginModel.Username = username;
        loginModel.Password = password;
        errorMessage = string.Empty;
        await HandleLogin();
    }

    private async Task HandleLogin()
    {
        var user = loginModel.Username?.Trim() ?? string.Empty;
        var pass = loginModel.Password?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(user) || string.IsNullOrWhiteSpace(pass))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var account = await LoginUseCase.ExecuteAsync(user, pass);
            if (account != null)
            {
                await CurrentUserStateStore.SetCurrentUserAsync(account);
                LoginModalService.Close();

                // Kiểm tra điều hướng thông minh
                var uri = new Uri(NavigationManager.Uri);
                if (uri.AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo("/", forceLoad: false);
                }
                else if (uri.AbsolutePath.Equals("/access-denied", StringComparison.OrdinalIgnoreCase) && account.Role == "Admin")
                {
                    NavigationManager.NavigateTo("/admin/courses", forceLoad: false);
                }
                else
                {
                    // Tải lại nhẹ trang để các component cập nhật theo vai trò mới
                    NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: false);
                }
            }
            else
            {
                errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác. Vui lòng thử lại!";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Có lỗi xảy ra trong quá trình đăng nhập: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        LoginModalService.OnChange -= HandleModalStateChange;
    }

    public class LoginViewModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
