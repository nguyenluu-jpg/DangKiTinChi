@namespace CourseRegistration.Web.Components.Shared
@using CourseRegistration.CoreBusiness.Models
@using CourseRegistration.UseCases.StudentPortal.AiAdvisor
@using CourseRegistration.UseCases.AdminPortal.AiAdminAssistant.Interfaces
@using CourseRegistration.UseCases.PluginInterfaces.DataStore
@inject IGetAiAdviceUseCase GetAiAdviceUseCase
@inject IAdminAiAssistantUseCase AdminAiAssistantUseCase
@inject ICurrentUserStateStore CurrentUserStateStore
@inject IStudentRepository StudentRepository
@inject ILoginModalService LoginModalService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (!isOnAiAdvisorPage)
{
    <div class="ai-robot-floating-container">
        <!-- Cửa sổ Chatbot Cố Vấn AI thu nhỏ nổi ở góc phải -->
        @if (isChatOpen)
        {
            <div class="card border-0 shadow-lg ai-robot-chat-window animate__animated animate__fadeInUp">
                <!-- Header Cửa sổ Chat -->
                <div class="ai-chat-header d-flex justify-content-between align-items-center p-3 text-white">
                    <div class="d-flex align-items-center gap-2">
                        <div class="ai-avatar-circle">
                            <i class="bi bi-robot"></i>
                            <span class="ai-avatar-status-dot"></span>
                        </div>
                        <div>
                            <div class="fw-bold lh-1 small">Cố Vấn Học Thuật AI</div>
                            <span class="ai-online-text">
                                <i class="bi bi-circle-fill text-success" style="font-size: 6px;"></i> Trực tuyến &bull; Trợ lý 24/7
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <a href="/ai-advisor" class="btn btn-sm btn-icon text-white" title="Mở trang cố vấn chi tiết toàn màn hình">
                            <i class="bi bi-arrows-fullscreen"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-icon text-white" @onclick="ToggleChat" title="Thu nhỏ robot">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Thân Cuộc Trò Chuyện (Scrollable) -->
                <div class="ai-chat-body p-3">
                    @foreach (var msg in chatMessages)
                    {
                        @if (msg.IsUser)
                        {
                            <div class="d-flex justify-content-end mb-3">
                                <div class="ai-msg-bubble user-bubble shadow-sm">
                                    @msg.Content
                                    <div class="ai-msg-time text-end">@msg.Timestamp.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-start gap-2 mb-3">
                                <div class="ai-bot-avatar-sm flex-shrink-0">
                                    <i class="bi bi-robot"></i>
                                </div>
                                <div class="ai-msg-bubble bot-bubble shadow-sm flex-grow-1">
                                    <div class="ai-msg-text">@((MarkupString)FormatMarkdown(msg.Content))</div>

                                    @if (!string.IsNullOrEmpty(msg.ModelUsed))
                                    {
                                        <div class="mt-1">
                                            <span class="badge @(msg.IsAiGenerated ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")" style="font-size: 0.66rem;">
                                                <i class="bi @(msg.IsAiGenerated ? "bi-stars" : "bi-database")"></i>
                                                @(msg.IsAiGenerated ? "Trả lời bởi AI (LLM)" : "Chế độ dự phòng (tra cứu SQL Server)")
                                            </span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(msg.WarningMessage))
                                    {
                                        <div class="mt-1 small text-muted fst-italic" style="font-size: 0.7rem;">@msg.WarningMessage</div>
                                    }

                                    @if (msg.ShowLoginButton)
                                    {
                                        <div class="mt-2">
                                            <button type="button" 
                                                    class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1"
                                                    @onclick="() => LoginModalService.Open()">
                                                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập ngay
                                            </button>
                                        </div>
                                    }

                                    @if (msg.RecommendedSections?.Any() == true)
                                    {
                                        <div class="mt-2 pt-2 border-top border-secondary border-opacity-10">
                                            <div class="fw-bold small text-primary mb-1">
                                                <i class="bi bi-stars"></i> Gợi ý @msg.RecommendedSections.Count môn học kỳ này:
                                            </div>
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var sec in (msg.ShowAllSections ? msg.RecommendedSections : msg.RecommendedSections.Take(3)))
                                                {
                                                    <div class="p-1 px-2 rounded bg-white border small d-flex justify-content-between align-items-center">
                                                        <span class="fw-semibold text-truncate me-1">@sec.CourseName (@sec.SectionCode)</span>
                                                        <span class="badge bg-primary-subtle text-primary flex-shrink-0">@sec.Credits TC</span>
                                                    </div>
                                                }
                                                @if (!msg.ShowAllSections && msg.RecommendedSections.Count > 3)
                                                {
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-start small fw-semibold" style="font-size: 0.72rem;" @onclick="() => msg.ShowAllSections = true">
                                                        Xem thêm @(msg.RecommendedSections.Count - 3) lớp
                                                    </button>
                                                }
                                            </div>
                                            <div class="mt-2 text-end">
                                                <a href="/ai-advisor" class="btn btn-xs btn-outline-primary rounded-pill small py-0 px-2 fw-semibold" style="font-size: 0.72rem;">
                                                    <i class="bi bi-cart-check me-1"></i>Xem &amp; Xác nhận thêm vào Giỏ <i class="bi bi-arrow-right"></i>
                                                </a>
                                            </div>
                                        </div>
                                    }

                                    <div class="ai-msg-time">@msg.Timestamp.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                    }

                    <!-- Trạng thái phản hồi tức thì: Đang đọc câu hỏi & Xin chờ chút sinh động -->
                    @if (isThinking)
                    {
                        <div class="d-flex align-items-start gap-2 mb-3 animate__animated animate__fadeIn">
                            <div class="ai-bot-avatar-sm flex-shrink-0 ai-avatar-thinking">
                                <i class="bi bi-robot"></i>
                            </div>
                            <div class="ai-msg-bubble bot-bubble shadow-sm flex-grow-1 border-primary-subtle" style="background: #f0f7ff;">
                                <div class="d-flex align-items-center gap-2 text-primary fw-bold small mb-1">
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>@thinkingStatusMessage</span>
                                </div>
                                <div class="small text-muted" style="font-size: 0.76rem;">
                                    <i class="bi bi-hourglass-split text-primary me-1"></i>Xin chờ chút nhé, AI đang tra cứu dữ liệu &amp; chuẩn bị câu trả lời...
                                </div>
                                <div class="ai-typing-indicator mt-1">
                                    <span></span><span></span><span></span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Khối Gợi Ý Câu Hỏi Nhanh (Chips) -->
                @if (chatMessages.Count <= 2 && !isThinking)
                {
                    <div class="px-3 py-2 bg-light border-top border-bottom">
                        <div class="small fw-semibold text-muted mb-1" style="font-size: 0.72rem;">
                            <i class="bi bi-lightbulb text-warning me-1"></i>Gợi ý câu hỏi nhanh:
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            @if (currentRole == "Admin")
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Thống kê danh sách lớp quá tải sĩ số")'>
                                    📊 Lớp quá tải sĩ số
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Có lớp nào sĩ số dưới 15 cần cảnh báo không?")'>
                                    ⚠️ Lớp ít sinh viên
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Lớp Lập trình Web do ai dạy?")'>
                                    👨‍🏫 Môn Lập trình Web
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Báo cáo tổng quan học kỳ 2026_HK1")'>
                                    📈 Báo cáo tổng quan
                                </button>
                            }
                            else if (isAuthenticated && currentStudent != null)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Kỳ 2026_HK1 tôi nên đăng ký môn nào?")'>
                                    🎓 Gợi ý môn kỳ này
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Kiểm tra điều kiện tiên quyết môn học của tôi")'>
                                    ⚠️ Kiểm tra môn tiên quyết
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Lớp Lập trình Web của thầy Hà Ngọc Long")'>
                                    👨‍🏫 Môn thầy Hà Ngọc Long
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Quy định mức học phí tín chỉ năm nay thế nào?")'>
                                    💰 Mức học phí tín chỉ
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Môn Lập trình Web do ai dạy?")'>
                                    👨‍🏫 Môn Lập trình Web
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Môn Cơ sở dữ liệu có mấy lớp mở?")'>
                                    📊 Môn Cơ sở dữ liệu
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Mức học phí 1 tín chỉ bao nhiêu tiền?")'>
                                    💰 Mức học phí & VietQR
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Sinh viên được đăng ký tối đa bao nhiêu tín chỉ?")'>
                                    ⚖️ Hạn mức số tín chỉ
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Thời gian mở cổng đăng ký học phần khi nào?")'>
                                    📅 Thời gian mở cổng
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill chip-btn" @onclick='() => SendQuickPrompt("Quy chế rút môn học và điểm F xử lý thế nào?")'>
                                    📋 Quy chế rút môn & Điểm F
                                </button>
                                <button type="button" class="btn btn-sm btn-primary py-0 px-2 rounded-pill chip-btn fw-bold" @onclick="() => LoginModalService.Open()">
                                    🔑 Đăng nhập sinh viên
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Chân Cửa Sổ: Nhập câu hỏi & Gửi -->
                <div class="ai-chat-footer p-2 bg-white">
                    <form @onsubmit="SendMessage" @onsubmit:preventDefault class="d-flex gap-1 align-items-center">
                        <input type="text" 
                               class="form-control form-control-sm rounded-pill border shadow-none px-3" 
                               placeholder="Hỏi Cố vấn AI về môn học, giảng viên, quy chế, học phí..." 
                               @bind="inputQuestion" 
                               @bind:event="oninput" 
                               @onkeydown="HandleInputKeyDown" 
                               disabled="@isThinking" />
                        <button type="submit" 
                                class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 ai-send-btn shadow-sm" 
                                disabled="@(isThinking || string.IsNullOrWhiteSpace(inputQuestion))"
                                title="Gửi câu hỏi">
                            @if (isThinking)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" style="width: 14px; height: 14px;"></span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill"></i>
                            }
                        </button>
                    </form>
                    <div class="text-center mt-1">
                        <a href="/ai-advisor" class="ai-full-link small text-decoration-none">
                            Xem mô phỏng lộ trình chuyên sâu &bull; Toàn màn hình <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- Nút Tròn Robot Nổi (Floating Launcher Button) -->
        <div class="d-flex align-items-center gap-2">
            <!-- Bóng thoại chào mời bên cạnh robot (Bubble Callout) -->
            @if (!isChatOpen && !isBubbleDismissed)
            {
                <div class="ai-speech-bubble shadow-sm animate__animated animate__fadeIn">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div class="d-flex flex-column" @onclick="ToggleChat" style="cursor: pointer;">
                            <span class="fw-bold small text-dark lh-1">Cố Vấn AI</span>
                            <span class="text-muted" style="font-size: 0.7rem;">Cần tư vấn môn học? Bấm đây!</span>
                        </div>
                        <button type="button" class="btn-close ms-1 p-1" style="font-size: 0.6rem;" @onclick="() => isBubbleDismissed = true"></button>
                    </div>
                    <div class="bubble-arrow"></div>
                </div>
            }

            <!-- Nút tròn Robot -->
            <button type="button" 
                    class="ai-robot-circle-btn shadow-lg" 
                    @onclick="ToggleChat" 
                    aria-label="Cố Vấn Học Thuật AI">
                <span class="ai-robot-pulse-ring"></span>
                <div class="ai-robot-icon-wrapper">
                    <i class="bi bi-robot fs-3 text-white"></i>
                </div>
                <span class="ai-robot-badge-status" title="AI đang sẵn sàng hỗ trợ"></span>
            </button>
        </div>
    </div>
}

@code {
    private bool isChatOpen = false;
    private bool isBubbleDismissed = false;
    private bool isThinking = false;
    private string thinkingStatusMessage = "Cố vấn AI đang đọc câu hỏi của bạn...";
    private string inputQuestion = string.Empty;

    private bool isAuthenticated = false;
    private string currentRole = string.Empty;
    private Student? currentStudent;
    private List<Student> allStudents = new List<Student>();
    private List<ChatMessageModel> chatMessages = new List<ChatMessageModel>();

    private bool isOnAiAdvisorPage => NavigationManager.Uri.Contains("/ai-advisor", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        CurrentUserStateStore.AddStateChangeListeners(HandleUserStateChange);
        NavigationManager.LocationChanged += HandleLocationChanged;

        try
        {
            allStudents = (await StudentRepository.GetAllStudentsAsync()).ToList();
        }
        catch { }

        await RefreshUserState();
        InitDefaultMessage();
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private async void HandleUserStateChange()
    {
        await RefreshUserState();
        InitDefaultMessage();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUserState()
    {
        isAuthenticated = await CurrentUserStateStore.IsAuthenticatedAsync();
        currentRole = await CurrentUserStateStore.GetCurrentRoleAsync();
        int studentId = await CurrentUserStateStore.GetCurrentStudentIdAsync();
        if (studentId > 0)
        {
            currentStudent = allStudents.FirstOrDefault(s => s.StudentId == studentId)
                             ?? await StudentRepository.GetStudentByIdAsync(studentId);
        }
        else
        {
            currentStudent = null;
        }
    }

    private void InitDefaultMessage()
    {
        chatMessages.Clear();

        if (currentRole == "Admin")
        {
            chatMessages.Add(new ChatMessageModel
            {
                IsUser = false,
                Content = "Xin chào **Cán bộ Phòng Đào Tạo**! Tôi là **Trợ lý AI Quản Trị Đào Tạo**. Bạn có thể yêu cầu tôi rà soát sĩ số lớp, cảnh báo quá tải hoặc thống kê học vụ bất kỳ lúc nào.",
                Timestamp = DateTime.Now
            });
        }
        else if (isAuthenticated && currentStudent != null)
        {
            chatMessages.Add(new ChatMessageModel
            {
                IsUser = false,
                Content = $"Xin chào **{currentStudent.FullName}** (MSSV: {currentStudent.StudentCode})! Tôi là **Cố vấn học thuật AI**. Tôi có thể gợi ý môn nên học kỳ 2026_HK1, rà soát điều kiện tiên quyết hoặc hỗ trợ lịch học cho bạn.",
                Timestamp = DateTime.Now
            });
        }
        else
        {
            chatMessages.Add(new ChatMessageModel
            {
                IsUser = false,
                Content = "Xin chào bạn! Tôi là **Cố vấn học thuật AI** của Trường Đại học Kinh tế Huế. Bạn có thể hỏi tôi về **môn học, giảng viên, phòng học, lịch học, quy chế tín chỉ, mức học phí VietQR**, hoặc **Đăng nhập tài khoản** để tôi phân tích thời khóa biểu tối ưu riêng cho bạn nhé!",
                Timestamp = DateTime.Now
            });
        }
    }

    private async Task ToggleChat()
    {
        isChatOpen = !isChatOpen;
        if (isChatOpen)
        {
            isBubbleDismissed = true;
            await ScrollChatToBottomAsync();
        }
    }

    private async Task SendQuickPrompt(string prompt)
    {
        inputQuestion = prompt;
        await SendMessage();
    }

    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollChatToBottomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("aiChatScrollToBottom", ".ai-chat-body");
        }
        catch { }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputQuestion) || isThinking) return;

        string question = inputQuestion.Trim();
        inputQuestion = string.Empty;

        // 1. Phản hồi tức thì ngay khi bấm Gửi (Instant feedback)
        chatMessages.Add(new ChatMessageModel
        {
            IsUser = true,
            Content = question,
            Timestamp = DateTime.Now
        });

        isThinking = true;
        thinkingStatusMessage = "Cố vấn AI đang đọc câu hỏi của bạn...";
        await InvokeAsync(StateHasChanged);
        await ScrollChatToBottomAsync();

        // 2. Chuyển đổi trạng thái "Xin chờ chút..." sinh động (200ms)
        await Task.Delay(200);
        thinkingStatusMessage = "Đang tra cứu cơ sở dữ liệu đào tạo & quy chế...";
        await InvokeAsync(StateHasChanged);
        await ScrollChatToBottomAsync();

        try
        {
            if (currentRole == "Admin")
            {
                var result = await AdminAiAssistantUseCase.ExecuteAsync(question, "2026_HK1");
                chatMessages.Add(new ChatMessageModel
                {
                    IsUser = false,
                    Content = result.AnswerSummary,
                    Timestamp = DateTime.Now
                });
            }
            else
            {
                // Chuyển toàn bộ hội thoại cho UseCase riêng GetAiAdviceUseCase (Clean Architecture)
                int studentId = 0;
                if (isAuthenticated)
                {
                    studentId = await CurrentUserStateStore.GetCurrentStudentIdAsync();
                }
                // Lịch sử chỉ gồm các lượt TRƯỚC câu hỏi hiện tại (câu hỏi vừa thêm ở trên được bỏ đi để LLM không nhận câu hỏi hai lần)
                var history = chatMessages
                    .Take(chatMessages.Count - 1)
                    .Select(m => new AiConversationMessage
                    {
                        IsUser = m.IsUser,
                        Content = m.Content,
                        Timestamp = m.Timestamp
                    })
                    .ToList();

                var advice = await GetAiAdviceUseCase.ExecuteAsync(studentId, "2026_HK1", question, history);

                chatMessages.Add(new ChatMessageModel
                {
                    IsUser = false,
                    Content = advice.AiMessage,
                    RecommendedSections = advice.RecommendedSections,
                    ShowLoginButton = advice.SuggestLogin,
                    IsAiGenerated = advice.IsAiGenerated,
                    ModelUsed = advice.ModelUsed,
                    WarningMessage = advice.WarningMessage,
                    Timestamp = DateTime.Now
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AiRobotWidget Error] {ex.GetType().Name}: {ex.Message}");
            chatMessages.Add(new ChatMessageModel
            {
                IsUser = false,
                Content = "Dịch vụ AI hiện chưa khả dụng hoặc đang bận xử lý. Vui lòng thử lại sau giây lát nhé!",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isThinking = false;
            await InvokeAsync(StateHasChanged);
            await ScrollChatToBottomAsync();
        }
    }

    private static string FormatMarkdown(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;

        var encoded = System.Web.HttpUtility.HtmlEncode(text);
        var lines = encoded.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var sb = new System.Text.StringBuilder();

        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            if (trimmed.StartsWith("### "))
            {
                var h = trimmed.Substring(4);
                sb.Append($"<div class=\"fw-bold text-primary mt-2 mb-1\">{FormatInline(h)}</div>");
            }
            else if (trimmed.StartsWith("## "))
            {
                var h = trimmed.Substring(3);
                sb.Append($"<div class=\"fw-bold text-dark mt-2 mb-1\">{FormatInline(h)}</div>");
            }
            else if (trimmed.StartsWith("- ") || trimmed.StartsWith("* "))
            {
                var li = trimmed.Substring(2);
                sb.Append($"<div class=\"ps-2 my-1\">&bull; {FormatInline(li)}</div>");
            }
            else if (trimmed.StartsWith("+ "))
            {
                var li = trimmed.Substring(2);
                sb.Append($"<div class=\"ps-3 my-1\">&bull; {FormatInline(li)}</div>");
            }
            else if (string.IsNullOrWhiteSpace(trimmed))
            {
                sb.Append("<div class=\"my-1\"></div>");
            }
            else
            {
                sb.Append($"<div>{FormatInline(trimmed)}</div>");
            }
        }

        return sb.ToString();
    }

    private static string FormatInline(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return string.Empty;
        var formatted = System.Text.RegularExpressions.Regex.Replace(line, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        formatted = System.Text.RegularExpressions.Regex.Replace(formatted, @"\*(.+?)\*", "<em>$1</em>");
        formatted = System.Text.RegularExpressions.Regex.Replace(formatted, @"`(.+?)`", "<code class=\"bg-white border px-1 rounded text-primary\" style=\"font-size: 0.85rem;\">$1</code>");
        return formatted;
    }

    public void Dispose()
    {
        CurrentUserStateStore.RemoveStateChangeListeners(HandleUserStateChange);
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

