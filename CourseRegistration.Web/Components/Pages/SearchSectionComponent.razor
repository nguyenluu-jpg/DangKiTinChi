@page "/sections"
@namespace CourseRegistration.Web.Components.Pages
@inject ISearchSectionUseCase SearchSectionUseCase
@inject IAddSectionToCartUseCase AddSectionToCartUseCase
@inject IRemoveSectionFromCartUseCase RemoveSectionFromCartUseCase
@inject IViewRegistrationCartUseCase ViewRegistrationCartUseCase
@inject ICurrentUserStateStore CurrentUserStateStore
@inject IStudentRepository StudentRepository
@inject ICourseRepository CourseRepository
@inject ILoginModalService LoginModalService
@inject IRegistrationPeriodService RegistrationPeriodService
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-search text-primary me-2"></i>Tra Cứu & Đăng Ký Lớp Học Phần
        </h2>
        <p class="text-muted mb-0">Hệ thống đối chiếu thời gian thực điều kiện tiên quyết, trùng lịch & hạn mức tín chỉ</p>
    </div>
    <a href="/cart" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
        <i class="bi bi-cart-check me-2"></i>
        <span>Vào Giỏ Đăng Ký</span>
        @if (cartSectionIds.Count > 0)
        {
            <span class="badge bg-white text-primary ms-2 rounded-pill">@cartSectionIds.Count</span>
        }
    </a>
</div>

<!-- Kế hoạch & Tiến độ Đăng ký Học phần -->
<RegistrationPhaseBannerComponent @bind-SelectedSemesterCode="currentSemesterCode" OnPhaseChanged="HandleSemesterOrPhaseChanged" />

<!-- Thông báo thao tác giỏ hàng (Feedback Toast) -->
@if (!string.IsNullOrEmpty(feedbackMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-success-subtle d-flex align-items-center justify-content-between py-2 px-3 mb-4 rounded-3" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-5 text-success me-2"></i>
            <div>
                <strong>Thành công!</strong> @feedbackMessage
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/cart" class="btn btn-sm btn-success">Xem giỏ</a>
            <button type="button" class="btn-close position-static p-2" @onclick="() => feedbackMessage = null"></button>
        </div>
    </div>
}

<!-- Thanh sinh viên hiện tại & Hạn mức -->
@if (!isAuthenticated)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-4 rounded-3 shadow-sm border-info-subtle">
        <div class="d-flex align-items-center">
            <i class="bi bi-info-circle-fill fs-4 text-primary me-3"></i>
            <div>
                <div class="fw-bold">Bạn đang tra cứu lớp học phần với tư cách Khách (Chưa đăng nhập)</div>
                <div class="small text-muted">Vui lòng đăng nhập để hệ thống tự động kiểm tra điều kiện tiên quyết và tính toán hạn mức tín chỉ cho bạn.</div>
            </div>
        </div>
        <button type="button" 
                class="btn btn-outline-primary fw-semibold px-3 py-1 rounded-pill"
                @onclick="() => LoginModalService.Open()">
            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
        </button>
    </div>
}
else if (currentRole == "Admin")
{
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white border-start border-danger border-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="user-avatar bg-danger text-white">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark">
                        Chế độ Quản trị viên (Phòng Đào Tạo)
                        @if (currentStudent != null)
                        {
                            <span class="badge bg-secondary ms-1">Đang mô phỏng SV: @currentStudent.FullName</span>
                        }
                    </div>
                    <div class="small text-muted">
                        Bạn có thể kiểm tra danh mục lớp, hoặc chuyển sang trang Quản lý lớp HP để mở lớp & quản lý sĩ số.
                    </div>
                </div>
            </div>
            <div>
                <a href="/admin/sections" class="btn btn-danger btn-sm">
                    <i class="bi bi-gear-fill me-1"></i> Quản lý Lớp HP
                </a>
            </div>
        </div>
    </div>
}
else if (currentStudent != null)
{
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white rounded-4 border-start border-4 border-primary">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="user-avatar @(currentStudent.StudentId == 1 ? "bg-primary text-white" : "bg-warning text-dark") rounded-circle shadow-xs">
                    <i class="bi bi-person-fill fs-5"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2 flex-wrap">
                        @currentStudent.FullName 
                        <span class="badge bg-light text-secondary border font-monospace">@currentStudent.StudentCode</span>
                        <span class="text-muted small fw-normal">&bull; @currentStudent.Major</span>
                    </div>
                    <div class="small text-secondary mt-0.5 d-flex align-items-center gap-2.5 flex-wrap">
                        <span>Hạn mức kỳ: <strong class="text-primary fw-bold">@currentStudent.MaxCreditsPerSemester TC</strong></span>
                        <span>&bull;</span>
                        <span>Đã chọn: <strong class="text-success fw-bold">@cartTotalCredits TC</strong> (@cartSectionIds.Count lớp)</span>
                        <span>&bull;</span>
                        <span>Còn được đăng ký: <strong class="text-dark fw-bold">@(Math.Max(0, currentStudent.MaxCreditsPerSemester - cartTotalCredits)) TC</strong></span>
                    </div>
                </div>
            </div>

            <div>
                @if (currentStudent.StudentCode == "SV21002")
                {
                    <span class="badge bg-danger-subtle text-danger px-3 py-2 small rounded-pill border border-danger-subtle">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Chưa đạt môn tiên quyết TIN102 &bull; Hệ thống sẽ chặn khi gửi phiếu đăng ký môn Web (WEB301)
                    </span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success px-3 py-2 small rounded-pill border border-success-subtle">
                        <i class="bi bi-check2-circle me-1"></i>Đã đạt đủ điều kiện học phần tiên quyết
                    </span>
                }
            </div>
        </div>
    </div>
}

<!-- Thanh tìm kiếm & bộ lọc nâng cao -->
<div class="card border-0 shadow-sm p-3 mb-3 bg-white rounded-4">
    <div class="row g-2.5 align-items-center">
        <!-- Input tìm kiếm từ khóa -->
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" 
                       class="form-control border-start-0" 
                       placeholder="Tìm mã lớp (INT1001.01), tên học phần, GV..."
                       @bind="searchKeyword" 
                       @bind:event="oninput" 
                       @onkeyup="FilterSections" />
                @if (!string.IsNullOrEmpty(searchKeyword))
                {
                    <button class="btn btn-outline-secondary" @onclick="ClearKeyword">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>

        <!-- Lọc theo môn học -->
        <div class="col-12 col-md-3">
            <select class="form-select text-dark" @onchange="OnCourseFilterChanged">
                <option value="0">-- Tất cả môn học --</option>
                @foreach (var c in allCourses)
                {
                    <option value="@c.CourseId">@c.CourseCode - @c.CourseName (@c.Credits TC)</option>
                }
            </select>
        </div>

        <!-- Toggle chỉ lớp còn chỗ & chuyển đổi dạng hiển thị -->
        <div class="col-12 col-md-4 d-flex align-items-center justify-content-between justify-content-md-end gap-2.5 flex-wrap">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="availableOnlySwitch" 
                       checked="@onlyAvailable" @onchange="OnAvailableOnlyChanged">
                <label class="form-check-label small fw-semibold text-secondary" for="availableOnlySwitch">
                    Chỉ hiện còn chỗ
                </label>
            </div>

            <!-- Chuyển đổi Dạng Bảng / Dạng Thẻ -->
            <div class="btn-group btn-group-sm shadow-xs" role="group">
                <button type="button" 
                        class="btn @(isTableView ? "btn-primary" : "btn-outline-secondary") d-flex align-items-center gap-1 px-2.5 py-1.5" 
                        @onclick="() => isTableView = true"
                        title="Xem dạng Bảng chi tiết">
                    <i class="bi bi-table"></i>
                    <span class="d-none d-sm-inline fw-medium">Dạng Bảng</span>
                </button>
                <button type="button" 
                        class="btn @(!isTableView ? "btn-primary" : "btn-outline-secondary") d-flex align-items-center gap-1 px-2.5 py-1.5" 
                        @onclick="() => isTableView = false"
                        title="Xem dạng Thẻ lưới">
                    <i class="bi bi-grid-fill"></i>
                    <span class="d-none d-sm-inline fw-medium">Dạng Thẻ</span>
                </button>
            </div>

            <button class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc" @onclick="HandleReset">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>
</div>

<!-- Danh sách lớp học phần -->
@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <p class="mt-2 text-muted fw-semibold">Đang tải danh sách lớp học phần...</p>
    </div>
}
else if (!string.IsNullOrEmpty(loadErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 my-4 rounded-3 shadow-sm border-danger-subtle">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-danger me-3"></i>
            <div>
                <div class="fw-bold">Lỗi khi tải dữ liệu</div>
                <div class="small text-danger-emphasis">@loadErrorMessage</div>
            </div>
        </div>
        <button class="btn btn-danger btn-sm px-3" @onclick="LoadMasterData">
            <i class="bi bi-arrow-clockwise me-1"></i> Thử lại
        </button>
    </div>
}
else if (!filteredSections.Any())
{
    <div class="card border-0 shadow-sm text-center py-5 bg-white rounded-4">
        <i class="bi bi-inbox fs-1 text-muted mb-2"></i>
        <h5 class="fw-bold text-muted">Không tìm thấy lớp học phần phù hợp</h5>
        <p class="small text-muted mb-3">Vui lòng thử tìm kiếm với từ khóa khác hoặc điều chỉnh bộ lọc</p>
        <div>
            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="HandleReset">Đặt lại bộ lọc</button>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2.5 flex-wrap gap-2">
        <div class="text-secondary small fw-semibold">
            Danh sách <strong>@filteredSections.Count</strong> lớp học phần &bull;
            <span class="text-success">@filteredSections.Count(s => s.HasAvailableSlot) lớp còn chỗ trống</span>
        </div>
        <div class="small text-muted">
            Nhấp <strong>"Thêm vào giỏ"</strong> để chọn học phần, sau đó vào <strong>"Giỏ Đăng Ký"</strong> để xác nhận.
        </div>
    </div>

    @if (isTableView)
    {
        <!-- BẢNG TRA CỨU & ĐĂNG KÝ LỚP HỌC PHẦN (TABLE VIEW CHUYÊN NGHIỆP) -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 section-table">
                    <thead class="bg-light-subtle text-dark border-bottom">
                        <tr>
                            <th class="text-center py-3 ps-3" style="width: 45px;">#</th>
                            <th class="py-3" style="width: 130px;">Mã Lớp HP</th>
                            <th class="py-3" style="min-width: 220px;">Tên Học Phần & Môn Học</th>
                            <th class="text-center py-3" style="width: 80px;">Số TC</th>
                            <th class="py-3" style="width: 170px;">Giảng Viên</th>
                            <th class="py-3" style="min-width: 200px;">Lịch Học & Phòng</th>
                            <th class="py-3" style="width: 160px;">Sĩ Số & Lấp Đầy</th>
                            <th class="py-3" style="width: 150px;">Tiên Quyết</th>
                            <th class="text-end pe-3 py-3" style="width: 140px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < filteredSections.Count; i++)
                        {
                            var sec = filteredSections[i];
                            bool isAdded = cartSectionIds.Contains(sec.SectionId);
                            string? prereqWarning = GetPrerequisiteWarning(sec);
                            bool hasPrereqMet = string.IsNullOrEmpty(prereqWarning) && HasAnyPrerequisite(sec);
                            int fillPct = sec.MaxCapacity > 0 ? (sec.CurrentEnrollment * 100 / sec.MaxCapacity) : 0;

                            <tr class="section-row @(isAdded ? "in-cart-row" : "")">
                                <td class="text-center text-muted fw-semibold ps-3">@(i + 1)</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1 fs-6 fw-bold">
                                        @sec.SectionCode
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(sec.Course?.CourseName ?? "Học phần")</div>
                                    <div class="small text-muted d-flex align-items-center gap-2 mt-0.5">
                                        <span>Mã môn: <strong class="text-secondary font-monospace">@sec.Course?.CourseCode</strong></span>
                                        @if (!string.IsNullOrEmpty(sec.Course?.Department))
                                        {
                                            <span>&bull;</span>
                                            <span>@sec.Course?.Department</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-dark border border-secondary-subtle px-2 py-1 rounded-pill fw-bold">
                                        @(sec.Course?.Credits ?? 0) TC
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="teacher-icon-circle bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div class="small">
                                            <div class="fw-semibold text-dark">@sec.Instructor</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">Giảng viên cơ hữu</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (sec.Schedules != null && sec.Schedules.Any())
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var sched in sec.Schedules)
                                            {
                                                <div class="schedule-pill badge bg-light text-dark border text-start fw-normal py-1 px-2 d-inline-flex align-items-center gap-1.5">
                                                    <i class="bi bi-clock-history text-primary"></i>
                                                    <strong>@sched.DayOfWeekName</strong> (T.@sched.StartPeriod-@sched.EndPeriod)
                                                    <span class="text-muted ms-auto">&bull; P.@(string.IsNullOrEmpty(sched.Room) ? (string.IsNullOrEmpty(sec.Room) ? "A1" : sec.Room) : sched.Room)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">
                                            <i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(sec.Room) ? "Chưa sắp lịch" : $"Phòng {sec.Room}")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-between align-items-center small mb-1">
                                        <span class="fw-bold text-dark">@sec.CurrentEnrollment/@sec.MaxCapacity</span>
                                        @if (sec.HasAvailableSlot)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                                Còn @sec.AvailableSlots
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill small">
                                                Đã đầy
                                            </span>
                                        }
                                    </div>
                                    <div class="progress rounded-pill" style="height: 6px;">
                                        <div class="progress-bar @(sec.CurrentEnrollment >= sec.MaxCapacity ? "bg-danger" : fillPct >= 80 ? "bg-warning" : "bg-primary")" 
                                             role="progressbar" 
                                             style="width: @Math.Min(100, fillPct)%">
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(prereqWarning))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1 text-wrap text-start p-1.5 small" style="max-width: 150px;">
                                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                                            <span>@prereqWarning</span>
                                        </span>
                                    }
                                    else if (hasPrereqMet)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small">
                                            <i class="bi bi-check-circle-fill"></i> Đủ điều kiện
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                                            Không bắt buộc
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (isAdded)
                                    {
                                        <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-2.5 py-1.5 rounded-pill shadow-xs" 
                                                title="Nhấp để xóa khỏi giỏ"
                                                @onclick="() => HandleRemoveFromCart(sec.SectionId)">
                                            <i class="bi bi-trash"></i>
                                            <span>Hủy chọn</span>
                                        </button>
                                    }
                                    else if (!sec.HasAvailableSlot)
                                    {
                                        <button class="btn btn-sm btn-light text-muted border d-inline-flex align-items-center gap-1 px-2.5 py-1.5 rounded-pill opacity-75" disabled>
                                            <i class="bi bi-lock-fill"></i>
                                            <span>Hết chỗ</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 px-2.5 py-1.5 rounded-pill shadow-xs" 
                                                @onclick="() => HandleAddToCart(sec)">
                                            <i class="bi bi-plus-circle"></i>
                                            <span>Thêm vào giỏ</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- DẠNG THẺ LƯỚI (CARD GRID VIEW) -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
            @foreach (var sec in filteredSections)
            {
                bool isAdded = cartSectionIds.Contains(sec.SectionId);
                string? prereqWarning = GetPrerequisiteWarning(sec);
                bool hasPrereqMet = string.IsNullOrEmpty(prereqWarning) && HasAnyPrerequisite(sec);

                <div class="col">
                    <SectionCardComponent Section="@sec" 
                                          IsInCart="@isAdded"
                                          PrerequisiteWarning="@prereqWarning"
                                          HasPrerequisiteMet="@hasPrereqMet"
                                          OnAddToCart="@HandleAddToCart"
                                          OnRemoveFromCart="@HandleRemoveFromCart" />
                </div>
            }
        </div>
    }
}

@code {
    private List<Section> allSections = new List<Section>();
    private List<Section> filteredSections = new List<Section>();
    private List<Course> allCourses = new List<Course>();
    private List<Prerequisite> allPrerequisites = new List<Prerequisite>();
    private List<CompletedCourse> studentCompletedCourses = new List<CompletedCourse>();
    private Student? currentStudent;

    private string currentSemesterCode = "2026_HK1";
    private HashSet<int> cartSectionIds = new HashSet<int>();
    private int cartTotalCredits = 0;
    private string searchKeyword = string.Empty;
    private int selectedCourseId = 0;
    private bool onlyAvailable = false;
    private bool isLoading = true;
    private string? loadErrorMessage;
    private bool isAuthenticated = false;
    private string currentRole = string.Empty;
    private string? feedbackMessage;
    private bool isTableView = true;

    protected override async Task OnInitializedAsync()
    {
        currentSemesterCode = RegistrationPeriodService.CurrentSemesterCode ?? "2026_HK1";
        CurrentUserStateStore.AddStateChangeListeners(HandleUserOrCartChanged);
        await LoadMasterData();
    }

    private async Task HandleSemesterOrPhaseChanged()
    {
        await LoadMasterData();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleUserOrCartChanged()
    {
        try
        {
            await LoadStudentData();
            await LoadCartData();
            FilterSections();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            loadErrorMessage = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMasterData()
    {
        isLoading = true;
        loadErrorMessage = null;
        try
        {
            allCourses = (await CourseRepository.GetAllCoursesAsync()).ToList();
            allPrerequisites = (await CourseRepository.GetAllPrerequisitesAsync()).ToList();
            var rawSections = await SearchSectionUseCase.ExecuteAsync(string.Empty, currentSemesterCode);
            allSections = rawSections.ToList();

            await LoadStudentData();
            await LoadCartData();
            FilterSections();
        }
        catch (Exception ex)
        {
            loadErrorMessage = "Không thể kết nối hoặc tải dữ liệu học phần: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStudentData()
    {
        isAuthenticated = await CurrentUserStateStore.IsAuthenticatedAsync();
        currentRole = await CurrentUserStateStore.GetCurrentRoleAsync();
        int studentId = await CurrentUserStateStore.GetCurrentStudentIdAsync();
        if (studentId > 0)
        {
            currentStudent = await StudentRepository.GetStudentByIdAsync(studentId);
            studentCompletedCourses = (await StudentRepository.GetCompletedCoursesByStudentIdAsync(studentId)).ToList();
        }
        else
        {
            currentStudent = null;
            studentCompletedCourses = new List<CompletedCourse>();
        }
    }

    private async Task LoadCartData()
    {
        var cart = await ViewRegistrationCartUseCase.ExecuteAsync();
        cartSectionIds = cart.EnrollmentLines.Select(l => l.SectionId).ToHashSet();
        cartTotalCredits = cart.TotalCredits;
    }

    private void FilterSections()
    {
        var query = allSections.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            string kw = searchKeyword.Trim();
            query = query.Where(s =>
                (s.SectionCode != null && s.SectionCode.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (s.Course?.CourseName != null && s.Course.CourseName.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (s.Course?.CourseCode != null && s.Course.CourseCode.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
                (s.Instructor != null && s.Instructor.Contains(kw, StringComparison.OrdinalIgnoreCase))
            );
        }

        if (selectedCourseId > 0)
        {
            query = query.Where(s => s.CourseId == selectedCourseId);
        }

        if (onlyAvailable)
        {
            query = query.Where(s => s.HasAvailableSlot);
        }

        filteredSections = query.ToList();
    }

    private void OnCourseFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cid))
        {
            selectedCourseId = cid;
            FilterSections();
        }
    }

    private void OnAvailableOnlyChanged(ChangeEventArgs e)
    {
        onlyAvailable = e.Value is bool b && b;
        FilterSections();
    }

    private void ClearKeyword()
    {
        searchKeyword = string.Empty;
        FilterSections();
    }

    private async Task HandleReset()
    {
        searchKeyword = string.Empty;
        selectedCourseId = 0;
        onlyAvailable = false;
        FilterSections();
        await LoadCartData();
    }

    private bool HasAnyPrerequisite(Section sec)
    {
        return allPrerequisites.Any(p => p.CourseId == sec.CourseId);
    }

    private string? GetPrerequisiteWarning(Section sec)
    {
        var reqs = allPrerequisites.Where(p => p.CourseId == sec.CourseId).ToList();
        if (!reqs.Any()) return null;

        var missing = new List<string>();
        foreach (var req in reqs)
        {
            bool completed = studentCompletedCourses.Any(cc => cc.CourseId == req.PrerequisiteCourseId);
            if (!completed)
            {
                var reqCourse = allCourses.FirstOrDefault(c => c.CourseId == req.PrerequisiteCourseId);
                missing.Add(reqCourse?.CourseCode ?? $"Mã #{req.PrerequisiteCourseId}");
            }
        }

        if (missing.Any())
        {
            return $"Chưa hoàn thành môn tiên quyết: {string.Join(", ", missing)}";
        }

        return null;
    }

    private async Task HandleAddToCart(Section section)
    {
        await AddSectionToCartUseCase.ExecuteAsync(section);
        cartSectionIds.Add(section.SectionId);
        cartTotalCredits += section.Course?.Credits ?? 0;
        feedbackMessage = $"Đã thêm lớp {section.SectionCode} ({section.Course?.CourseName}) vào giỏ đăng ký!";
    }

    private async Task HandleRemoveFromCart(int sectionId)
    {
        var sec = allSections.FirstOrDefault(s => s.SectionId == sectionId);
        await RemoveSectionFromCartUseCase.ExecuteAsync(sectionId);
        cartSectionIds.Remove(sectionId);
        if (sec?.Course != null)
        {
            cartTotalCredits = Math.Max(0, cartTotalCredits - sec.Course.Credits);
        }
        feedbackMessage = $"Đã xóa lớp {sec?.SectionCode ?? sectionId.ToString()} khỏi giỏ đăng ký.";
    }

    public void Dispose()
    {
        CurrentUserStateStore.RemoveStateChangeListeners(HandleUserOrCartChanged);
    }
}

