    private Course? FindMatchingCourse(string qNorm)
    {
        // 1. Khớp chính xác mã môn
        foreach (var c in allCourses)
        {
            var code = c.CourseCode.ToLowerInvariant();
            if (qNorm.Contains(code)) return c;
        }

        // 2. Khớp tên môn không dấu
        foreach (var c in allCourses.OrderByDescending(c => c.CourseName.Length))
        {
            var cNorm = RemoveDiacritics(c.CourseName);
            if (qNorm.Contains(cNorm)) return c;
        }

        // 3. Khớp biệt danh / từ khóa thông dụng
        var aliases = new Dictionary<string, string[]>
        {
            ["WEB301"] = new[] { "lap trinh ung dung web", "lap trinh web", "ung dung web", "ltw", "web301", "web" },
            ["WEB302"] = new[] { "web nang cao", "microservices", "web302" },
            ["CSDL201"] = new[] { "co so du lieu", "csdl201", "csdl", "database", "du lieu", "sql" },
            ["CSDL202"] = new[] { "csdl phan tan", "nosql", "csdl202", "mongodb" },
            ["TIN101"] = new[] { "nhap mon lap trinh", "nmlt", "tin101", "nhap mon", "c#" },
            ["TIN102"] = new[] { "lap trinh huong doi tuong", "huong doi tuong", "oop", "tin102" },
            ["TIN201"] = new[] { "cau truc du lieu", "giai thuat", "ctdl", "tin201", "thuat toan" },
            ["KTPM302"] = new[] { "ky thuat phan mem", "ktpm302", "ktpm", "phan mem", "scrum", "agile" },
            ["ATTT401"] = new[] { "an toan thong tin", "attt401", "attt", "bao mat", "an toan mang" },
            ["ATTT402"] = new[] { "an ninh mang", "attt402", "phong chong tan cong" },
            ["AI401"] = new[] { "tri tue nhan tao", "ai401", "hoc may", "machine learning", "tri tue" },
            ["TOEIC"] = new[] { "tieng anh", "anh van", "toeic", "ngoai ngu" }
        };

        foreach (var kv in aliases)
        {
            var matchedCourse = allCourses.FirstOrDefault(c => c.CourseCode.Equals(kv.Key, StringComparison.OrdinalIgnoreCase));
            if (matchedCourse != null)
            {
                foreach (var alias in kv.Value)
                {
                    if (alias == "web")
                    {
                        if (qNorm.Contains("mon web") || qNorm.Contains("lop web") || qNorm.Contains("lap trinh web") || qNorm.Contains("hoc web"))
                        {
                            return matchedCourse;
                        }
                    }
                    else if (qNorm.Contains(alias))
                    {
                        return matchedCourse;
                    }
                }
            }
        }

        return null;
    }

    private (string Name, List<Section> Sections)? FindMatchingInstructor(string qNorm)
    {
        var instructors = allSections.Select(s => s.Instructor).Where(i => !string.IsNullOrEmpty(i)).Distinct().ToList();

        foreach (var inst in instructors)
        {
            var instNorm = RemoveDiacritics(inst.ToLowerInvariant());
            if (qNorm.Contains(instNorm))
            {
                return (inst, allSections.Where(s => s.Instructor.Equals(inst, StringComparison.OrdinalIgnoreCase)).ToList());
            }

            var parts = instNorm.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var lastName = parts.LastOrDefault();
            if (!string.IsNullOrEmpty(lastName) && lastName.Length > 2)
            {
                if (qNorm.Contains("thay " + lastName) || qNorm.Contains("co " + lastName) || qNorm.Contains(lastName + " day") || qNorm.Contains("lop " + lastName))
                {
                    return (inst, allSections.Where(s => s.Instructor.Equals(inst, StringComparison.OrdinalIgnoreCase)).ToList());
                }
            }
        }

        return null;
    }

    private static string FormatSchedule(Section section)
    {
        if (section.Schedules == null || !section.Schedules.Any()) return "Chưa xếp lịch";
        return string.Join("; ", section.Schedules.Select(s => $"Thứ {s.DayOfWeek} (Tiết {s.StartPeriod}-{s.EndPeriod})"));
    }

    private static string RemoveDiacritics(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var normalizedString = text.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();

        foreach (var c in normalizedString)
        {
            var category = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (category != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                sb.Append(c);
            }
        }

        return sb.ToString()
            .Normalize(System.Text.NormalizationForm.FormC)
            .Replace('đ', 'd')
            .Replace('Đ', 'D');
    }

    private static string FormatMarkdown(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;

        var formatted = System.Web.HttpUtility.HtmlEncode(text)
            .Replace("\n", "<br />");

        formatted = System.Text.RegularExpressions.Regex.Replace(formatted, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        formatted = System.Text.RegularExpressions.Regex.Replace(formatted, @"\*(.+?)\*", "<em>$1</em>");
        return formatted;
    }

