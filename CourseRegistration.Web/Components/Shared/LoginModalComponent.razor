        <!-- Chú thích chân hộp thoại y hệt Screenshot 162716 -->
        <div class="border-top mt-3 pt-2 text-start" style="border-color: #e1e3e1 !important;">
            <div style="font-size: 0.74rem; color: #444746; line-height: 1.45;">
