@namespace CourseRegistration.Web.Components.Shared
@inject ILoginModalService LoginModalService
@inject ILoginUseCase LoginUseCase
@inject ICurrentUserStateStore CurrentUserStateStore
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (LoginModalService.IsVisible)
{
    <!-- Modal Backdrop Overlay (Cố định: không bị mất modal khi chạm ra bên ngoài) -->
    <div class="login-modal-overlay">
        <div class="login-modal-dialog">
            <!-- Modal Card -->
            <div class="login-modal-content card border-0 shadow-2xl rounded-4 overflow-hidden">
                <!-- Header Gradient (Giao diện cũ, đã bỏ hình tròn trắng) -->
                <div class="login-modal-header text-white text-center py-4 px-4 position-relative">
                    <button type="button" 
                            class="btn-close-modal position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center" 
                            @onclick="CloseModal"
                            aria-label="Đóng">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <div class="mb-2">
                        <i class="bi bi-mortarboard-fill fs-1 text-white"></i>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">Đăng Nhập Hệ Thống</h4>
                    <div class="text-white-50 small">Cổng Đăng Ký Học Phần Trực Tuyến</div>
                </div>

                <!-- Body (Form HTML chuẩn để trình duyệt/máy tính tự động bật thông báo lưu mật khẩu) -->
                <div class="card-body p-4 p-md-4 bg-white">
                    @if (showWeakPasswordAlert)
                    {
                        <!-- THÔNG BÁO ĐỔI MẬT KHẨU TỰ ĐỘNG XUẤT HIỆN NGAY SAU KHI ĐĂNG NHẬP THÀNH CÔNG -->
                        <div class="weak-password-notice text-center py-2 px-1" style="animation: fadeIn 0.25s ease-out;">
                            <div class="mb-3">
                                <span class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-15 text-warning rounded-circle shadow-xs" style="width: 72px; height: 72px;">
                                    <i class="bi bi-shield-exclamation fs-1"></i>
                                </span>
                            </div>

                            <h5 class="fw-bold text-dark mb-2">Thông Báo Đổi Mật Khẩu</h5>
                            
                            <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark small text-start py-3 px-3 rounded-3 mb-3 shadow-none">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0 fs-5 mt-0.5"></i>
                                    <div>
                                        <div class="fw-bold text-dark mb-1">Mật khẩu hiện tại quá yếu!</div>
                                        <div class="text-secondary" style="font-size: 0.82rem; line-height: 1.4;">
                                            Tài khoản của bạn đang sử dụng mật khẩu mặc định hoặc mật khẩu có độ bảo mật thấp. Để đảm bảo an toàn cho tài khoản và dữ liệu học tập, vui lòng đổi mật khẩu sau khi đăng nhập.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <form method="post" action="" @onsubmit="ConfirmWeakPasswordAndProceed" @onsubmit:preventDefault="true">
                                <button type="submit" 
                                        class="btn btn-primary w-100 py-2.5 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-2"
                                        disabled="@isLoading"
                                        autofocus>
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Đang xử lý...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-lg fs-5"></i>
                                        <span>OK, Tôi Đã Hiểu</span>
                                    }
                                </button>
                            </form>

                            <div class="text-muted small mt-2" style="font-size: 0.74rem;">
                                Bấm <strong class="text-dark">OK</strong> hoặc nhấn <kbd class="bg-light text-dark border">Enter</kbd> để tiếp tục. Trình duyệt sẽ hỏi bạn có muốn lưu mật khẩu này hay không.
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger d-flex align-items-center rounded-3 mb-3 py-2 px-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                                <div class="small fw-semibold">
                                    @errorMessage
                                </div>
                            </div>
                        }

                        <form method="post" action="" @onsubmit="HandleLogin" @onsubmit:preventDefault="true" autocomplete="on">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small mb-1" for="username">Tài khoản / MSSV <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control border-start-0 ps-0 bg-light" 
                                           placeholder="Nhập mã sinh viên hoặc tên đăng nhập" 
                                           id="username"
                                           name="username"
                                           autocomplete="username"
                                           autocorrect="off"
                                           autocapitalize="off"
                                           spellcheck="false"
                                           @bind="loginModel.Username" 
                                           @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small mb-1" for="password">Mã truy cập (Mật khẩu) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>
                                    <input type="@(showPassword ? "text" : "password")" 
                                           class="form-control border-start-0 border-end-0 ps-0 bg-light" 
                                           placeholder="Nhập mã truy cập của bạn" 
                                           id="password"
                                           name="password"
                                           autocomplete="current-password"
                                           autocorrect="off"
                                           autocapitalize="off"
                                           spellcheck="false"
                                           @bind="loginModel.Password" 
                                           @bind:event="oninput" />
                                    <button type="button" 
                                             class="input-group-text bg-light border-start-0 text-muted cursor-pointer"
                                             @onclick="() => showPassword = !showPassword"
                                             title="@(showPassword ? "Ẩn mã truy cập" : "Hiện mã truy cập")">
                                        <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Nút Đăng Nhập nguyên bản duy nhất -->
                            <button type="submit" 
                                    class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3"
                                    disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Đang xác thực...</span>
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-in-right fs-5"></i>
                                    <span>Đăng Nhập</span>
                                }
                            </button>
                        </form>

                        <div class="mt-3 pt-3 border-top text-center text-secondary small" style="font-size: 0.78rem;">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            Hệ thống xác thực tài khoản sinh viên &amp; cán bộ quản trị.
                            <div class="mt-1 text-muted" style="font-size: 0.74rem;">
                                Quên mật khẩu hoặc cần cấp lại tài khoản? Vui lòng liên hệ <span class="fw-semibold text-dark">Phòng Đào Tạo</span>.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private LoginViewModel loginModel = new LoginViewModel();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;
    private bool showWeakPasswordAlert = false;
    private UserAccount? pendingAccount;

    protected override void OnInitialized()
    {
        LoginModalService.OnChange += HandleModalStateChange;
    }

    private void HandleModalStateChange()
    {
        if (LoginModalService.IsVisible)
        {
            errorMessage = string.Empty;
            loginModel = new LoginViewModel();
            showPassword = false;
            showWeakPasswordAlert = false;
            pendingAccount = null;
        }
        InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        showWeakPasswordAlert = false;
        pendingAccount = null;
        LoginModalService.Close();
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var account = await LoginUseCase.ExecuteAsync(loginModel.Username.Trim(), loginModel.Password);
            if (account != null)
            {
                bool isWeak = IsWeakPassword(loginModel.Password);
                if (isWeak)
                {
                    // Tự động xuất hiện thông báo đổi mật khẩu ngay lập tức sau khi đăng nhập thành công
                    // Giữ form mở, không đóng modal và không chuyển trang cho đến khi bấm OK
                    pendingAccount = account;
                    showWeakPasswordAlert = true;
                    isLoading = false;
                    StateHasChanged();
                    return;
                }
                else
                {
                    // Mật khẩu an toàn: Hoàn tất đăng nhập và kích hoạt lưu mật khẩu
                    await FinalizeLoginAsync(account);
                }
            }
            else
            {
                errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác. Vui lòng thử lại!";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Có lỗi xảy ra trong quá trình đăng nhập: {ex.Message}";
        }
        finally
        {
            if (!showWeakPasswordAlert)
            {
                isLoading = false;
            }
        }
    }

    private async Task ConfirmWeakPasswordAndProceed()
    {
        if (pendingAccount != null)
        {
            isLoading = true;
            try
            {
                await FinalizeLoginAsync(pendingAccount);
            }
            finally
            {
                isLoading = false;
                showWeakPasswordAlert = false;
                pendingAccount = null;
            }
        }
    }

    private async Task FinalizeLoginAsync(UserAccount account)
    {
        // Kích hoạt trình duyệt hỏi lưu mật khẩu theo cơ chế native
        try
        {
            await JSRuntime.InvokeVoidAsync("triggerBrowserSavePassword", 
                loginModel.Username.Trim(), 
                loginModel.Password);
        }
        catch { }

        await CurrentUserStateStore.SetCurrentUserAsync(account);
        
        // Đóng modal để trở lại giao diện
        LoginModalService.Close();

        // Giữ nguyên trang đang đứng, chỉ điều hướng nếu đang ở route /login riêng lẻ
        var uri = new Uri(NavigationManager.Uri);
        if (uri.AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase))
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: false);
        }
    }

    private bool IsWeakPassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password)) return true;
        var p = password.Trim().ToLower();
        if (p == "123456" || p == "admin123" || p == "12345" || p == "12345678" || p == "password" || p == "admin")
            return true;
        if (p.Length < 8)
            return true;
        if (p.All(char.IsDigit) || p.All(char.IsLetter))
            return true;
        return false;
    }

    public void Dispose()
    {
        LoginModalService.OnChange -= HandleModalStateChange;
    }

    public class LoginViewModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
