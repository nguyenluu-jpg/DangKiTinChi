                <polygon points="101,31 106,33 106,39 101,41 96,39 96,33" fill="#1A73E8" />
                <circle cx="116" cy="36" r="5" fill="#7CBBF3" />
                <polygon points="128,30 134,36 128,42 122,36" fill="#7CBBF3" />
                <polygon points="142,31 147,35 145,41 139,41 137,35" fill="#34A853" />
                <polygon points="155,31 160,33 160,39 155,41 150,39 150,33" fill="#34A853" />
                <circle cx="170" cy="36" r="6" fill="#81C995" />
                
                <!-- Blue checkmark circle badge top right -->
                <circle cx="180" cy="20" r="10" fill="#1A73E8" />
                <path d="M176 20 l3 3 l6 -6" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                
                <!-- Floating pale green polygon bottom right -->
                <polygon points="198,46 206,42 214,46 214,56 206,60 198,56" fill="#C4EED0" opacity="0.85" />
            </svg>
        </div>

        <!-- Key Icon + Tiêu đề "Lưu mật khẩu?" -->
        <div class="d-flex align-items-center mb-3">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="me-2 flex-shrink-0" xmlns="http://www.w3.org/2000/svg">
