@page "/ai-advisor"
@namespace CourseRegistration.Web.Components.Pages
@using CourseRegistration.CoreBusiness.Models
@using CourseRegistration.UseCases.StudentPortal.AiAdvisor
@using CourseRegistration.UseCases.StudentPortal.RegistrationCartScreen.Interfaces
@using CourseRegistration.UseCases.AdminPortal.AiAdminAssistant.Interfaces
@using CourseRegistration.Web.Services
@inject IGetAiAdviceUseCase GetAiAdviceUseCase
@inject IAdminAiAssistantUseCase AdminAiAssistantUseCase
@inject IAddSectionToCartUseCase AddSectionToCartUseCase
@inject IRegistrationCartStateStore CartStateStore
@inject ICurrentUserStateStore CurrentUserStateStore
@inject IStudentRepository StudentRepository
@inject ILoginModalService LoginModalService
@inject NavigationManager NavigationManager
@inject AiChatSessionState ChatSessionState
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Trợ Lý & Cố Vấn Học Thuật AI - Đăng Ký Tín Chỉ</PageTitle>

<div class="container py-3">
    <!-- Header banner -->
    <div class="card border-0 rounded-4 shadow-sm text-white mb-4 overflow-hidden position-relative" 
         style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #06b6d4 100%);">
        <div class="card-body p-4 p-lg-5 position-relative z-1">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div style="max-width: 800px;">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-20 text-white small fw-bold mb-3 backdrop-blur">
                        <i class="bi bi-stars text-warning"></i> Tính Năng Nâng Cao &bull; Trí Tuệ Nhân Tạo AI
                    </div>
                    <h2 class="display-6 fw-bold mb-2">Trợ Lý &amp; Cố Vấn Học Thuật AI</h2>
                    <p class="lead mb-0 text-white-50 fs-6">
                        @if (currentRole == "Admin")
                        {
                            <span>Hệ thống AI đa nhiệm: Vừa là <strong>Trợ lý AI Phòng Đào Tạo</strong> (tra cứu sĩ số, cảnh báo quá tải, rà soát học vụ), vừa là <strong>Cố vấn học tập</strong> cho sinh viên.</span>
                        }
                        else
                        {
                            <span>Trợ lý AI phân tích tự động lịch sử học tập, điều kiện tiên quyết và mục tiêu cá nhân để đề xuất lộ trình đăng ký tối ưu nhất cho học kỳ <strong>2026_HK1</strong>.</span>
                        }
                    </p>
                </div>
                <div>
                    <button type="button" class="btn btn-light rounded-pill px-3 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2 text-primary"
                            @onclick="MinimizeToWidget" title="Thu nhỏ về chat box nổi ở góc màn hình">
                        <i class="bi bi-box-arrow-in-down-right"></i>
                        <span>Thu nhỏ về chat box</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!isAuthenticated)
    {
        <!-- Chế độ Cố Vấn Học Thuật Khách & Tra Cứu Toàn Trường -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 border-start border-primary border-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Chế Độ Khách Tham Quan</span>
                            <span class="badge bg-success-subtle text-success px-2 py-1">
                                <i class="bi bi-circle-fill text-success" style="font-size: 6px;"></i> Trực tuyến 24/7
                            </span>
                        </div>
                        <h4 class="fw-bold text-dark mb-0">Tra Cứu Học Thuật &amp; Tư Vấn Thông Tin Học Phần AI</h4>
                        <div class="small text-muted">
                            Bạn có thể tự do đặt bất kỳ câu hỏi nào về môn học, giảng viên, phòng học, mức học phí, và quy chế tín chỉ của nhà trường.
                        </div>
                    </div>
                </div>

                <div>
                    <button type="button" 
                            class="btn btn-outline-primary fw-bold shadow-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2"
                            @onclick="() => LoginModalService.Open()">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Đăng Nhập Sinh Viên (Xem lộ trình cá nhân)</span>
                    </button>
                </div>
            </div>

            <!-- Tác vụ tra cứu nhanh -->
            <div class="mb-3">
                <label class="form-label small fw-bold text-muted mb-2">Câu hỏi gợi ý nhanh:</label>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" 
                            @onclick='() => AskGuestPreset("Môn Lập trình Ứng dụng Web do ai dạy và có mấy lớp?")'>
                        👨‍🏫 Môn Lập trình Web
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" 
                            @onclick='() => AskGuestPreset("Môn Cơ sở dữ liệu có bao nhiêu sinh viên và giảng viên nào dạy?")'>
                        📊 Môn Cơ sở dữ liệu
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" 
                            @onclick='() => AskGuestPreset("Quy định mức học phí tín chỉ năm học 2026 - 2027 thế nào?")'>
                        💰 Mức học phí &amp; VietQR
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" 
                            @onclick='() => AskGuestPreset("Sinh viên được đăng ký tối đa bao nhiêu tín chỉ trong một kỳ?")'>
                        ⚖️ Hạn mức số tín chỉ
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" 
                            @onclick='() => AskGuestPreset("Thời gian mở cổng đăng ký học phần học kỳ 2026_HK1?")'>
                        📅 Thời gian mở cổng
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" 
                            @onclick='() => AskGuestPreset("Quy chế rút môn học và xử lý điểm F như thế nào?")'>
                        📋 Quy chế rút môn &amp; Điểm F
                    </button>
                </div>
            </div>

            <!-- Thanh tìm kiếm thông minh -->
            <div class="input-group mb-2">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-primary"></i></span>
                <input type="text" class="form-control border-start-0 py-2" 
                       placeholder="Hỏi Cố vấn AI về môn học, giảng viên, phòng học, học phí, quy chế..." 
                       @bind="guestQuery" 
                       @bind:event="oninput" 
                       @onkeydown="HandleGuestKeyDown" />
                <button class="btn btn-primary px-4 fw-bold" type="button" @onclick="AskGuestAi" disabled="@isGuestLoading">
                    @if (isGuestLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Đang phân tích...</span>
                    }
                    else
                    {
                        <i class="bi bi-stars me-1"></i>
                        <span>Hỏi Cố Vấn AI</span>
                    }
                </button>
            </div>
            @if (isGuestLoading)
            {
                <div class="alert alert-info py-2 px-3 rounded-3 mt-2 mb-0 d-flex align-items-center gap-2 small animate__animated animate__fadeIn">
                    <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                    <span><strong>Xin chờ chút nhé!</strong> Cố vấn AI đang tra cứu cơ sở dữ liệu học vụ thời gian thực...</span>
                </div>
            }
        </div>

        <!-- KẾT QUẢ TRẢ LỜI CỦA AI CHO KHÁCH (DẠNG THREAD HỘI THOẠI LIÊN TỤC) -->
        @if (ChatSessionState.Messages.Any())
        {
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var msg in ChatSessionState.Messages)
                {
                    if (msg.IsUser)
                    {
                        <!-- User message -->
                        <div class="d-flex justify-content-end">
                            <div class="card border-0 shadow-sm rounded-4 text-white p-3" 
                                 style="max-width: 80%; background: linear-gradient(135deg, #0284c7 0%, #06b6d4 100%);">
                                <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
                                    <span class="small fw-bold opacity-75">
                                        <i class="bi bi-person-fill me-1"></i>Bạn (Khách)
                                    </span>
                                    <span class="small opacity-50">@msg.Timestamp.ToString("HH:mm")</span>
                                </div>
                                <div class="fs-6" style="white-space: pre-wrap; word-break: break-word;">@msg.Content</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- AI message -->
                        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-2 border-start border-info border-4 animate__animated animate__fadeIn">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
                                        <i class="bi bi-robot me-1 text-warning"></i>
                                        Cố Vấn Học Thuật AI
                                    </span>
                                    @if (!string.IsNullOrEmpty(msg.ModelUsed))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border px-2 py-1">
                                            @msg.ModelUsed
                                        </span>
                                    }
                                </div>
                                <span class="text-muted small">@msg.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</span>
                            </div>

                            <div class="ai-response-bubble p-4 rounded-4 shadow-sm bg-white border border-primary-subtle mb-3">
                                <div class="ai-response-content text-dark" style="font-size: 0.96rem; line-height: 1.75;">
                                    @((MarkupString)FormatMessage(msg.Content))
                                </div>
                            </div>

                            @if (msg.ActionLinks.Any())
                            {
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                    <span class="small fw-bold text-muted me-1">Liên kết gợi ý:</span>
                                    @foreach (var link in msg.ActionLinks)
                                    {
                                        if (link.Kind == AiActionLinkKind.Login)
                                        {
                                            <button type="button" class="btn btn-primary btn-sm rounded-pill fw-bold shadow-sm" @onclick="() => LoginModalService.Open()">
                                                <i class="bi bi-box-arrow-in-right me-1"></i>@link.Label
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@link.Url" class="btn btn-outline-primary btn-sm rounded-pill fw-bold shadow-sm">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>@link.Label
                                            </a>
                                        }
                                    }
                                </div>
                            }

                            @if (msg.RecommendedSections.Any())
                            {
                                <h6 class="fw-bold text-dark mt-3 mb-2">
                                    <i class="bi bi-table text-primary me-1"></i> Danh Sách Lớp Học Phần Liên Quan:
                                </h6>
                                <div class="table-responsive rounded-3 border mb-3">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light small">
                                            <tr>
                                                <th>Mã Lớp</th>
                                                <th>Tên Học Phần</th>
                                                <th>Giảng Viên</th>
                                                <th>Thời Khóa Biểu</th>
                                                <th>Ghi Chú</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var sec in msg.RecommendedSections)
                                            {
                                                <tr>
                                                    <td class="fw-bold text-primary">@sec.SectionCode</td>
                                                    <td class="fw-semibold">@sec.CourseName</td>
                                                    <td class="small text-muted">@sec.Instructor</td>
                                                    <td class="small">@sec.ScheduleSummary</td>
                                                    <td class="small text-muted">@sec.RecommendationReason</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (msg.ShowLoginButton)
                            {
                                <div class="alert alert-warning border-0 rounded-4 p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-check-fill fs-4 text-warning"></i>
                                        <span class="small">
                                            Bạn muốn AI phân tích học bạ cá nhân và tự động lên lịch học tối ưu cho riêng bạn?
                                        </span>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-sm fw-bold rounded-pill px-3 shadow-sm" @onclick="() => LoginModalService.Open()">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Sinh Viên Ngay
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    }
    else
    {
        <!-- Nếu là Admin: Cung cấp 2 Chế độ (Tabs) -->
        @if (currentRole == "Admin")
        {
            <div class="card border-0 shadow-sm p-2 mb-4 bg-white rounded-4">
                <div class="nav nav-pills nav-fill gap-2" role="tablist">
                    <button class="nav-link py-2 fw-bold d-flex align-items-center justify-content-center gap-2 @(activeAdminMode == "adminCopilot" ? "active bg-primary text-white" : "text-dark")" 
                            type="button" 
                            @onclick='() => SwitchAdminMode("adminCopilot")'>
                        <i class="bi bi-robot fs-5"></i>
                        <span>1. Trợ Lý AI Phòng Đào Tạo (Hỗ Trợ Học Vụ &amp; Tra Cứu Nhanh)</span>
                    </button>
                    <button class="nav-link py-2 fw-bold d-flex align-items-center justify-content-center gap-2 @(activeAdminMode == "studentSimulator" ? "active bg-danger text-white" : "text-dark")" 
                            type="button" 
                            @onclick='() => SwitchAdminMode("studentSimulator")'>
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                        <span>2. Mô Phỏng Cố Vấn Học Tập Cho Sinh Viên</span>
                    </button>
                </div>
            </div>
        }

        <!-- ========================================================================= -->
        <!-- CHẾ ĐỘ DÀNH CHO ADMIN: TRỢ LÝ AI PHÒNG ĐÀO TẠO (TRA CỨU & THAM MƯU HỌC VỤ)  -->
        <!-- ========================================================================= -->
        @if (currentRole == "Admin" && activeAdminMode == "adminCopilot")
        {
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 border-start border-primary border-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-robot"></i>
                        </div>
                        <div>
                            <span class="badge bg-danger-subtle text-danger px-2 py-1 mb-1">Cán Bộ Phòng Đào Tạo</span>
                            <h4 class="fw-bold text-dark mb-0">Trợ Lý AI Quản Trị Đào Tạo (Admin Copilot)</h4>
                            <div class="small text-muted">Hỗ trợ tra cứu nhanh dữ liệu lớp học phần, sĩ số, cảnh báo quá tải và gợi ý xử lý học vụ.</div>
                        </div>
                    </div>
                </div>

                <!-- Các nút tác vụ nhanh -->
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted mb-2">Tác vụ tra cứu học vụ thường dùng:</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" 
                                @onclick='() => AskAdminPreset("Lớp học phần nào đang quá tải hoặc sắp đầy chỗ?")'>
                            🚨 Lớp quá tải / sắp đầy (>75% sĩ số)
                        </button>
                        <button type="button" class="btn btn-outline-warning btn-sm rounded-pill text-dark" 
                                @onclick='() => AskAdminPreset("Những lớp học phần nào có sĩ số thấp nguy cơ hủy lớp?")'>
                            ⚠️ Lớp ít sinh viên (&lt;50% sĩ số)
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" 
                                @onclick='() => AskAdminPreset("Thống kê tổng quan tình hình đăng ký học phần kỳ này?")'>
                            📊 Báo cáo tổng quan học kỳ
                        </button>
                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill" 
                                @onclick='() => AskAdminPreset("Tình hình đăng ký học phần của các sinh viên?")'>
                            👥 Tra cứu tiến độ sinh viên
                        </button>
                    </div>
                </div>

                <!-- Thanh tìm kiếm thông minh -->
                <div class="input-group mb-2">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-primary"></i></span>
                    <input type="text" class="form-control border-start-0 py-2" 
                           placeholder="Hãy nhập câu hỏi bạn cần trợ giúp..." 
                           @bind="adminQuery" 
                           @bind:event="oninput" 
                           @onkeydown="HandleAdminKeyDown" />
                    <button class="btn btn-primary px-4 fw-bold" type="button" @onclick="AskAdminAi" disabled="@isAdminLoading">
                        @if (isAdminLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Đang phân tích...</span>
                        }
                        else
                        {
                            <i class="bi bi-stars me-1"></i>
                            <span>Hỏi Trợ Lý AI</span>
                        }
                    </button>
                </div>
            </div>

            <!-- KẾT QUẢ TRẢ LỜI CỦA TRỢ LÝ AI ADMIN -->
            @if (adminResult != null)
            {
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 border-start border-info border-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
                                <i class="bi bi-robot me-1 text-warning"></i>
                                Trợ Lý AI Phòng Đào Tạo
                            </span>
                            <span class="badge bg-info-subtle text-info-emphasis border px-2 py-1">
                                @adminResult.Category
                            </span>
                            <span class="badge bg-light text-secondary border px-2 py-1">
                                @adminResult.ModelUsed
                            </span>
                        </div>
                        <span class="text-muted small">Cập nhật: @adminResult.GeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(adminResult.WarningMessage))
                    {
                        <div class="alert alert-info border-0 shadow-sm rounded-3 p-3 d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-info-circle-fill text-primary fs-5 flex-shrink-0"></i>
                            <div class="small fw-semibold">@adminResult.WarningMessage</div>
                        </div>
                    }

                    <!-- AI Response Bubble Hiện Đại & Sang Trọng -->
                    <div class="ai-response-bubble p-4 rounded-4 shadow-sm bg-white border border-primary-subtle mb-3">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom border-light-subtle">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                                    <i class="bi bi-robot fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                        <span>Phòng Đào Tạo &bull; Trợ Lý Phân Tích Dữ Liệu AI</span>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill py-1 px-2 small">
                                            <i class="bi bi-check2-circle me-1"></i>Học vụ thời gian thực
                                        </span>
                                    </div>
                                    <div class="small text-muted">Dữ liệu đối chiếu SQL Server thời gian thực &bull; Cập nhật: @adminResult.GeneratedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-info-subtle text-info-emphasis border px-2 py-1">@adminResult.Category</span>
                                <span class="badge bg-light text-secondary border px-2 py-1">@adminResult.ModelUsed</span>
                            </div>
                        </div>

                        <div class="ai-response-content text-dark" style="font-size: 0.96rem; line-height: 1.75;">
                            @((MarkupString)FormatMessage(adminResult.AnswerSummary))
                        </div>
                    </div>

                    @if (adminResult.ActionableSuggestions.Any())
                    {
                        <div class="card border-0 shadow-sm bg-warning-subtle text-warning-emphasis p-3 rounded-4 mb-3 border-start border-warning border-4">
                            <div class="fw-bold mb-2 small d-flex align-items-center gap-2">
                                <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
                                <span>Đề xuất giải pháp hành động học vụ từ AI:</span>
                            </div>
                            <ul class="mb-0 ps-3 small d-flex flex-column gap-1">
                                @foreach (var sug in adminResult.ActionableSuggestions)
                                {
                                    <li>@sug</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Bảng dữ liệu lớp học phần nếu có -->
                    @if (adminResult.Sections.Any())
                    {
                        <h6 class="fw-bold text-dark mt-3 mb-2">
                            <i class="bi bi-table text-primary me-1"></i> Danh Sách Lớp Học Phần Liên Quan:
                        </h6>
                        <div class="table-responsive rounded-3 border mb-3">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Mã Lớp</th>
                                        <th>Tên Học Phần</th>
                                        <th>Giảng Viên</th>
                                        <th>Sĩ Số (Hiện tại / Tối đa)</th>
                                        <th>Tỷ Lệ Lấp Đầy</th>
                                        <th>Trạng Thái &amp; Ghi Chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sec in adminResult.Sections)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@sec.SectionCode</td>
                                            <td class="fw-semibold">@sec.CourseName</td>
                                            <td class="small text-muted">@sec.Instructor</td>
                                            <td class="small fw-bold">@sec.CurrentEnrollment / @sec.MaxCapacity SV</td>
                                            <td style="min-width: 140px;">
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar @(sec.FillRate >= 90 ? "bg-danger" : (sec.FillRate >= 50 ? "bg-primary" : "bg-secondary"))" 
                                                         role="progressbar" 
                                                         style="width: @(Math.Min(100, sec.FillRate))%;"></div>
                                                </div>
                                                <span class="small fw-semibold text-muted">@sec.FillRate%</span>
                                            </td>
                                            <td>
                                                <span class="@sec.StatusBadge me-1">@sec.Note</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Bảng dữ liệu sinh viên nếu có -->
                    @if (adminResult.Students.Any())
                    {
                        <h6 class="fw-bold text-dark mt-3 mb-2">
                            <i class="bi bi-people text-primary me-1"></i> Danh Sách Sinh Viên:
                        </h6>
                        <div class="table-responsive rounded-3 border mb-3">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>MSSV</th>
                                        <th>Họ và Tên</th>
                                        <th>Chuyên Ngành</th>
                                        <th>Số TC Đăng Ký</th>
                                        <th>Số Môn</th>
                                        <th>Tình Trạng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var stu in adminResult.Students)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@stu.StudentCode</td>
                                            <td class="fw-semibold">@stu.FullName</td>
                                            <td class="small text-muted">@stu.Major</td>
                                            <td class="fw-bold">@stu.RegisteredCredits TC</td>
                                            <td class="small">@stu.RegisteredCoursesCount môn</td>
                                            <td>
                                                <span class="badge @(stu.RegisteredCredits >= 14 ? "bg-success" : (stu.RegisteredCredits > 0 ? "bg-info text-dark" : "bg-warning text-dark"))">
                                                    @stu.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }

        <!-- ========================================================================= -->
        <!-- CHẾ ĐỘ DÀNH CHO SINH VIÊN (HOẶC ADMIN MÔ PHỎNG THEO SINH VIÊN)            -->
        <!-- ========================================================================= -->
        @if (currentRole != "Admin" || activeAdminMode == "studentSimulator")
        {
            <!-- Bộ điều khiển cấu hình sinh viên (Dành cho Admin hoặc chính Sinh viên) -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary-subtle text-primary p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                <i class="bi bi-mortarboard-fill"></i>
                            </div>
                            <div>
                                <div class="small text-muted fw-bold text-uppercase">Hồ sơ sinh viên đang tư vấn:</div>
                                <h4 class="fw-bold text-dark mb-0">@currentStudentName</h4>
                                <div class="small text-muted">
                                    MSSV: <strong>@currentStudentCode</strong> &bull; Ngành: <strong>@currentMajor</strong> (@currentAcademicYear)
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (currentRole == "Admin")
                    {
                        <div class="col-md-5">
                            <label class="form-label small fw-bold text-danger mb-1">
                                <i class="bi bi-shield-lock me-1"></i>Admin: Chọn sinh viên để thử nghiệm tư vấn AI:
                            </label>
                            <select class="form-select" @onchange="OnAdminStudentSelect">
                                @foreach (var s in studentList)
                                {
                                    <option value="@s.StudentId" selected="@(s.StudentId == activeStudentId)">
                                        @s.StudentCode - @s.FullName (@s.Major)
                                    </option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>

            <!-- Nhập câu hỏi tự do hoặc nguyện vọng tư vấn cho AI -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-chat-dots-fill text-primary me-2"></i>Đặt Câu Hỏi Học Vụ Hoặc Nhập Nguyện Vọng Của Bạn
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                        <i class="bi bi-stars me-1"></i>AI Trả Lời Toàn Bộ Câu Hỏi
                    </span>
                </div>
                <p class="small text-muted mb-3">
                    Bạn có thể tự do hỏi <strong>bất kỳ điều gì</strong>: quy chế đào tạo, rút môn, điều kiện tiên quyết, hỏi về giảng viên, môn học, phòng học, hoặc nhờ AI tư vấn thời khóa biểu tối ưu.
                </p>

                <!-- Thanh nhập câu hỏi nổi bật lên đầu -->
                <div class="input-group mb-3">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-chat-text-fill text-primary"></i></span>
                    <input type="text" class="form-control border-start-0 py-2 fs-6" 
                           placeholder="Hãy nhập câu hỏi bạn cần trợ giúp..."
                           @bind="userPrompt" @bind:event="oninput" @onkeydown="HandleKeyDown" />
                    <button class="btn btn-primary px-4 fw-bold shadow-sm" type="button" @onclick="AskAiAdvisor" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>AI Đang Phân Tích...</span>
                        }
                        else
                        {
                            <i class="bi bi-stars me-1"></i>
                            <span>Gửi Câu Hỏi Cho AI</span>
                        }
                    </button>
                </div>

                <!-- Gợi ý tham khảo nhanh (tùy chọn) -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="small fw-semibold text-secondary me-1">Hoặc chọn nhanh câu hỏi mẫu:</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill"
                            @onclick='() => SetPrompt("Quy chế rút môn học và hủy học phần như thế nào?")'>
                        📋 Quy chế rút môn
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill"
                            @onclick='() => SetPrompt("Học kỳ này sinh viên được đăng ký tối đa bao nhiêu tín chỉ?")'>
                        ⚖️ Hạn mức tín chỉ
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill"
                            @onclick='() => SetPrompt("Giảng viên PGS.TS. Ngô Văn Dũng phụ trách môn học nào?")'>
                        👨‍🏫 Tra cứu thầy Dũng
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill"
                            @onclick='() => SetPrompt("Tư vấn kế hoạch học tập cân bằng 10-14 tín chỉ, không trùng lịch")'>
                        🎯 Kế hoạch 10-14 TC
                    </button>
                </div>

                <div class="small text-muted d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>Quy tắc bảo vệ: <strong>AI chỉ gợi ý</strong> &bull; Dữ liệu chưa ghi vào CSDL &bull; Bạn phải xác nhận trước khi lưu.</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success border-0 shadow-sm rounded-4 p-3 d-flex align-items-center justify-content-between mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                        <span>@successMessage</span>
                    </div>
                    <a href="/cart" class="btn btn-success btn-sm fw-bold">
                        <i class="bi bi-cart3 me-1"></i> Xem Giỏ Đăng Ký
                    </a>
                </div>
            }

            <!-- HỘI THOẠI VỚI CỐ VẤN AI (LIÊN TỤC, GIỮ NGUYÊN LỊCH SỬ) -->
            @if (ChatSessionState.Messages.Any())
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small text-muted fw-bold">
                        <i class="bi bi-chat-left-text me-1 text-primary"></i>Lịch sử đối thoại (@ChatSessionState.Messages.Count tin nhắn):
                    </span>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="ClearHistory">
                        <i class="bi bi-trash3 me-1"></i>Xóa cuộc trò chuyện
                    </button>
                </div>

                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var msg in ChatSessionState.Messages)
                    {
                        if (msg.IsUser)
                        {
                            <!-- Bong bóng tin nhắn người dùng -->
                            <div class="d-flex justify-content-end">
                                <div class="card border-0 shadow-sm rounded-4 text-white p-3" 
                                     style="max-width: 80%; background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
                                    <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
                                        <span class="small fw-bold opacity-75">
                                            <i class="bi bi-person-fill me-1"></i>Bạn (@currentStudentName)
                                        </span>
                                        <span class="small opacity-50">@msg.Timestamp.ToString("HH:mm")</span>
                                    </div>
                                    <div class="fs-6" style="white-space: pre-wrap; word-break: break-word;">@msg.Content</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Thẻ trả lời của Cố vấn AI -->
                            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-2 border-start border-primary border-4 animate__animated animate__fadeIn">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-3 border-bottom border-light-subtle">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm" 
                                             style="width: 44px; height: 44px; background: linear-gradient(135deg, #1d4ed8 0%, #0284c7 100%);">
                                            <i class="bi bi-stars fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                                <span>@(msg.IsAiGenerated ? "Trợ Lý Trí Tuệ Nhân Tạo AI" : "Cố Vấn Học Thuật Tín Chỉ")</span>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill py-1 px-2 small">
                                                    <i class="bi bi-patch-check-fill me-1"></i>Phản hồi chính thức
                                                </span>
                                            </div>
                                            <div class="small text-muted">
                                                @msg.Timestamp.ToString("dd/MM/yyyy HH:mm") &bull; @(string.IsNullOrEmpty(msg.ModelUsed) ? "Hệ thống Cố vấn" : msg.ModelUsed)
                                            </div>
                                        </div>
                                    </div>

                                    @if (msg.RecommendedSections.Any())
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary-subtle text-primary border px-2 py-1">
                                                <i class="bi bi-book me-1"></i>@msg.RecommendedSections.Count môn đề xuất
                                            </span>
                                            <span class="badge bg-success-subtle text-success border px-2 py-1">
                                                <i class="bi bi-mortarboard me-1"></i>@msg.RecommendedSections.Sum(s => s.Credits) tín chỉ
                                            </span>
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(msg.WarningMessage))
                                {
                                    <div class="alert alert-info border-0 shadow-sm rounded-4 p-3 d-flex align-items-center gap-2 mb-3">
                                        <i class="bi bi-info-circle-fill text-primary fs-5 flex-shrink-0"></i>
                                        <div class="small fw-semibold">@msg.WarningMessage</div>
                                    </div>
                                }

                                <div class="ai-response-content text-dark p-3 rounded-4 bg-light bg-opacity-75 border border-light-subtle mb-0" 
                                     style="font-size: 0.96rem; line-height: 1.8;">
                                    @((MarkupString)FormatMessage(msg.Content))
                                </div>

                                <!-- Action Links nếu có -->
                                @if (msg.ActionLinks.Any())
                                {
                                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-2 border-top border-light-subtle">
                                        <span class="small fw-bold text-muted me-1">Thao tác nhanh:</span>
                                        @foreach (var link in msg.ActionLinks)
                                        {
                                            if (link.Kind == AiActionLinkKind.Login)
                                            {
                                                <button type="button" class="btn btn-primary btn-sm rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-1"
                                                        @onclick="() => LoginModalService.Open()">
                                                    <i class="bi bi-box-arrow-in-right"></i>
                                                    <span>@link.Label</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <a href="@link.Url" class="btn btn-outline-primary btn-sm rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                    <span>@link.Label</span>
                                                </a>
                                            }
                                        }
                                    </div>
                                }

                                <!-- Danh sách các lớp học phần được gợi ý -->
                                @if (msg.RecommendedSections.Any())
                                {
                                    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mt-3 border">
                                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">
                                                    <i class="bi bi-list-check text-primary me-2"></i>Danh Sách Lớp Học Phần Đề Xuất
                                                </h6>
                                                <span class="small text-muted">Chọn các môn bạn muốn đưa vào Giỏ Đăng Ký</span>
                                            </div>

                                            <div class="d-flex align-items-center gap-3">
                                                <span class="small">
                                                    Đã chọn: <strong class="text-primary fs-6">@msg.RecommendedSections.Where(s => s.IsSelected).Sum(s => s.Credits)</strong> tín chỉ
                                                </span>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleSelectAllForMessage(msg)">
                                                    @(msg.RecommendedSections.All(s => s.IsSelected) ? "Bỏ chọn tất cả" : "Chọn tất cả")
                                                </button>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th style="width: 45px;" class="text-center">Chọn</th>
                                                        <th>Mã Lớp</th>
                                                        <th>Tên Học Phần</th>
                                                        <th>Số TC</th>
                                                        <th>Giảng Viên</th>
                                                        <th>Thời Khóa Biểu &amp; Phòng</th>
                                                        <th>Lý Do AI Đề Xuất</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in msg.RecommendedSections)
                                                    {
                                                        <tr class="@(item.IsSelected ? "table-primary-subtle" : "")">
                                                            <td class="text-center">
                                                                <input type="checkbox" class="form-check-input" 
                                                                       style="cursor: pointer; width: 1.25rem; height: 1.25rem;"
                                                                       @bind="item.IsSelected" />
                                                            </td>
                                                            <td>
                                                                <span class="badge bg-primary fs-6">@item.SectionCode</span>
                                                            </td>
                                                            <td>
                                                                <div class="fw-bold text-dark">@item.CourseName</div>
                                                                <div class="small text-muted">Mã môn: @item.CourseCode</div>
                                                            </td>
                                                            <td>
                                                                <span class="badge bg-secondary">@item.Credits TC</span>
                                                            </td>
                                                            <td class="small">@item.Instructor</td>
                                                            <td>
                                                                <span class="badge bg-light text-dark border">
                                                                    <i class="bi bi-clock me-1 text-primary"></i>@item.ScheduleSummary
                                                                </span>
                                                                <div class="small text-muted mt-1">Phòng: @item.Room</div>
                                                            </td>
                                                            <td class="small text-muted" style="max-width: 320px;">
                                                                <i class="bi bi-check-circle-fill text-success me-1"></i>@item.RecommendationReason
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div class="text-muted small">
                                                <i class="bi bi-info-circle me-1"></i>Học phần được chọn sẽ được đưa vào <strong>Giỏ Đăng Ký</strong>.
                                            </div>
                                            <button type="button" class="btn btn-primary btn-sm fw-bold px-3 shadow-sm" 
                                                    @onclick="() => AddSelectedFromMessageToCart(msg)" 
                                                    disabled="@(!msg.RecommendedSections.Any(s => s.IsSelected))">
                                                <i class="bi bi-cart-plus-fill me-1"></i>
                                                Thêm Vào Giỏ Đăng Ký (@msg.RecommendedSections.Where(s => s.IsSelected).Sum(s => s.Credits) TC)
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        }
    }
</div>

@code {
    private bool isAuthenticated = false;
    private string currentRole = string.Empty;
    private int activeStudentId = 0;
    private string currentStudentCode = string.Empty;
    private string currentStudentName = string.Empty;
    private string currentMajor = string.Empty;
    private string currentAcademicYear = string.Empty;

    // Quản lý tab Admin Copilot vs Student Simulator
    private string activeAdminMode = "adminCopilot";
    private string adminQuery = string.Empty;
    private bool isAdminLoading = false;
    private AdminAiQueryResult? adminResult;

    // Quản lý chế độ Khách (Chưa đăng nhập)
    private string guestQuery = string.Empty;
    private bool isGuestLoading = false;
    private AdminAiQueryResult? guestResult;

    private List<Student> studentList = new List<Student>();
    private string userPrompt = string.Empty;
    private bool isLoading = false;
    private string successMessage = string.Empty;
    private AiCourseAdvice? currentAdvice;

    protected override async Task OnInitializedAsync()
    {
        CurrentUserStateStore.AddStateChangeListeners(HandleUserStateChange);
        ChatSessionState.OnChange += OnSessionChanged;
        studentList = (await StudentRepository.GetAllStudentsAsync()).ToList();
        await RefreshUserState();

        // Khởi tạo lời chào nếu chưa có hội thoại nào trong ChatSessionState
        if (!ChatSessionState.Messages.Any())
        {
            if (!isAuthenticated)
            {
                var initAdvice = await GetAiAdviceUseCase.ExecuteAsync(0, "2026_HK1", "");
                ChatSessionState.AddMessage(new AiConversationMessage
                {
                    IsUser = false,
                    Content = initAdvice.AiMessage,
                    Timestamp = DateTime.Now,
                    ActionLinks = initAdvice.ActionLinks ?? new(),
                    ShowLoginButton = initAdvice.SuggestLogin,
                    IsAiGenerated = initAdvice.IsAiGenerated,
                    ModelUsed = initAdvice.ModelUsed,
                    WarningMessage = initAdvice.WarningMessage
                });
            }
            else if (currentRole != "Admin")
            {
                var initAdvice = await GetAiAdviceUseCase.ExecuteAsync(activeStudentId, "2026_HK1", "");
                currentAdvice = initAdvice;
                ChatSessionState.AddMessage(new AiConversationMessage
                {
                    IsUser = false,
                    Content = initAdvice.AiMessage,
                    Timestamp = DateTime.Now,
                    RecommendedSections = initAdvice.RecommendedSections ?? new(),
                    ActionLinks = initAdvice.ActionLinks ?? new(),
                    IsAiGenerated = initAdvice.IsAiGenerated,
                    ModelUsed = initAdvice.ModelUsed,
                    WarningMessage = initAdvice.WarningMessage
                });
            }
        }

        if (currentRole == "Admin")
        {
            adminResult = await AdminAiAssistantUseCase.ExecuteAsync("chào", "2026_HK1");
            adminQuery = string.Empty;
        }
    }

    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task MinimizeToWidget()
    {
        ChatSessionState.IsWidgetChatOpen = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("history.back");
        }
        catch
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task AskGuestPreset(string queryText)
    {
        guestQuery = queryText;
        await AskGuestAi();
    }

    private async Task HandleGuestKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AskGuestAi();
        }
    }

    private async Task AskGuestAi()
    {
        if (string.IsNullOrWhiteSpace(guestQuery) || isGuestLoading) return;

        string question = guestQuery.Trim();
        guestQuery = string.Empty;

        isGuestLoading = true;
        StateHasChanged();

        await Task.Delay(100);

        try
        {
            ChatSessionState.AddMessage(new AiConversationMessage
            {
                IsUser = true,
                Content = question,
                Timestamp = DateTime.Now
            });

            var history = ChatSessionState.GetRecentHistory(6);
            var advice = await GetAiAdviceUseCase.ExecuteAsync(0, "2026_HK1", question, history);

            ChatSessionState.AddMessage(new AiConversationMessage
            {
                IsUser = false,
                Content = advice.AiMessage,
                Timestamp = DateTime.Now,
                RecommendedSections = advice.RecommendedSections ?? new(),
                ActionLinks = advice.ActionLinks ?? new(),
                ShowLoginButton = advice.SuggestLogin,
                IsAiGenerated = advice.IsAiGenerated,
                ModelUsed = advice.ModelUsed,
                WarningMessage = advice.WarningMessage
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AiAdvisor Guest Error] {ex.GetType().Name}: {ex.Message}");
            ChatSessionState.AddMessage(new AiConversationMessage
            {
                IsUser = false,
                Content = "Dịch vụ AI hiện chưa khả dụng. Ứng dụng vẫn hoạt động bình thường, vui lòng thử lại sau giây lát.",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isGuestLoading = false;
            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }

    private async void HandleUserStateChange()
    {
        await RefreshUserState();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUserState()
    {
        isAuthenticated = await CurrentUserStateStore.IsAuthenticatedAsync();
        currentRole = await CurrentUserStateStore.GetCurrentRoleAsync();
        activeStudentId = await CurrentUserStateStore.GetCurrentStudentIdAsync();

        if (studentList.Any())
        {
            var student = studentList.FirstOrDefault(s => s.StudentId == activeStudentId) ?? studentList.First();
            activeStudentId = student.StudentId;
            currentStudentCode = student.StudentCode;
            currentStudentName = student.FullName;
            currentMajor = student.Major;
            currentAcademicYear = student.AcademicYear;
        }
    }

    private void SwitchAdminMode(string mode)
    {
        activeAdminMode = mode;
        StateHasChanged();
    }

    private async Task AskAdminPreset(string queryText)
    {
        adminQuery = queryText;
        await AskAdminAi();
    }

    private async Task HandleAdminKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AskAdminAi();
        }
    }

    private async Task AskAdminAi()
    {
        if (string.IsNullOrWhiteSpace(adminQuery)) return;

        isAdminLoading = true;
        StateHasChanged();

        try
        {
            adminResult = await AdminAiAssistantUseCase.ExecuteAsync(adminQuery, "2026_HK1");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AiAdvisor Admin Error] {ex.GetType().Name}: {ex.Message}");
            adminResult = new AdminAiQueryResult
            {
                Query = adminQuery,
                Category = "Dịch Vụ AI",
                AnswerSummary = "Dịch vụ AI hiện chưa khả dụng. Ứng dụng vẫn hoạt động bình thường, vui lòng thử lại sau giây lát.",
                IsAiGenerated = false,
                ModelUsed = "Hệ thống Tự Động"
            };
        }
        finally
        {
            isAdminLoading = false;
            StateHasChanged();
        }
    }

    private void SetPrompt(string promptText)
    {
        userPrompt = promptText;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AskAiAdvisor();
        }
    }

    private void OnAdminStudentSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
        {
            var student = studentList.FirstOrDefault(s => s.StudentId == selectedId);
            if (student != null)
            {
                activeStudentId = student.StudentId;
                currentStudentCode = student.StudentCode;
                currentStudentName = student.FullName;
                currentMajor = student.Major;
                currentAcademicYear = student.AcademicYear;
                currentAdvice = null;
                ChatSessionState.Clear();
                successMessage = string.Empty;
                StateHasChanged();
            }
        }
    }

    private async Task AskAiAdvisor()
    {
        if (activeStudentId <= 0 || string.IsNullOrWhiteSpace(userPrompt)) return;

        string question = userPrompt.Trim();
        userPrompt = string.Empty;

        isLoading = true;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            ChatSessionState.AddMessage(new AiConversationMessage
            {
                IsUser = true,
                Content = question,
                Timestamp = DateTime.Now
            });

            var history = ChatSessionState.GetRecentHistory(6);
            var advice = await GetAiAdviceUseCase.ExecuteAsync(activeStudentId, "2026_HK1", question, history);
            currentAdvice = advice;

            if (advice != null && !string.IsNullOrEmpty(advice.AiMessage))
            {
                ChatSessionState.AddMessage(new AiConversationMessage
                {
                    IsUser = false,
                    Content = advice.AiMessage,
                    Timestamp = DateTime.Now,
                    RecommendedSections = advice.RecommendedSections ?? new(),
                    ActionLinks = advice.ActionLinks ?? new(),
                    ShowLoginButton = advice.SuggestLogin,
                    IsAiGenerated = advice.IsAiGenerated,
                    ModelUsed = advice.ModelUsed,
                    WarningMessage = advice.WarningMessage
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AiAdvisor Student Error] {ex.GetType().Name}: {ex.Message}");
            ChatSessionState.AddMessage(new AiConversationMessage
            {
                IsUser = false,
                Content = "Dịch vụ AI hiện chưa khả dụng. Ứng dụng và các chức năng đăng ký tín chỉ vẫn hoạt động bình thường, vui lòng thử lại sau giây lát.",
                Timestamp = DateTime.Now,
                IsAiGenerated = false,
                WarningMessage = "Dịch vụ AI ngoại tuyến tạm thời."
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 999999);
        }
        catch { }
    }

    private void ToggleSelectAllForMessage(AiConversationMessage msg)
    {
        if (msg == null || !msg.RecommendedSections.Any()) return;
        bool allSelected = msg.RecommendedSections.All(s => s.IsSelected);
        foreach (var s in msg.RecommendedSections)
        {
            s.IsSelected = !allSelected;
        }
    }

    private void ClearHistory()
    {
        ChatSessionState.Clear();
        currentAdvice = null;
        successMessage = string.Empty;
    }

    private async Task AddSelectedFromMessageToCart(AiConversationMessage msg)
    {
        if (msg == null) return;

        var selected = msg.RecommendedSections.Where(s => s.IsSelected).ToList();
        if (!selected.Any()) return;

        int addedCount = 0;
        int creditsCount = selected.Sum(s => s.Credits);
        foreach (var item in selected)
        {
            var sec = new Section
            {
                SectionId = item.SectionId,
                SectionCode = item.SectionCode,
                CourseId = item.CourseId,
                Instructor = item.Instructor,
                Room = item.Room,
                Semester = "2026_HK1",
                Course = new Course
                {
                    CourseId = item.CourseId,
                    CourseCode = item.CourseCode,
                    CourseName = item.CourseName,
                    Credits = item.Credits
                }
            };

            await AddSectionToCartUseCase.ExecuteAsync(sec);
            addedCount++;
        }

        successMessage = $"Bạn đã xác nhận và thêm thành công {addedCount} học phần ({creditsCount} tín chỉ) vào Giỏ Đăng Ký!";
        StateHasChanged();
    }

    private static string FormatMessage(string msg)
    {
        if (string.IsNullOrWhiteSpace(msg)) return string.Empty;

        var lines = msg.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var sb = new System.Text.StringBuilder();
        bool inList = false;

        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();

            if (string.IsNullOrWhiteSpace(line))
            {
                if (inList)
                {
                    sb.Append("</ul>");
                    inList = false;
                }
                sb.Append("<div class=\"my-2\"></div>");
                continue;
            }

            // Horizontal rule
            if (line == "---" || line == "***")
            {
                if (inList) { sb.Append("</ul>"); inList = false; }
                sb.Append("<hr class=\"my-3 border-secondary border-opacity-25\" />");
                continue;
            }

            // Headings
            if (line.StartsWith("### "))
            {
                if (inList) { sb.Append("</ul>"); inList = false; }
                var headingText = FormatInline(line.Substring(4));
                sb.Append($"<h5 class=\"fw-bold text-primary mt-3 mb-2 pb-1 border-bottom border-primary-subtle d-flex align-items-center gap-2\"><i class=\"bi bi-arrow-right-short text-primary fs-5\"></i><span>{headingText}</span></h5>");
                continue;
            }
            if (line.StartsWith("## "))
            {
                if (inList) { sb.Append("</ul>"); inList = false; }
                var headingText = FormatInline(line.Substring(3));
                sb.Append($"<h4 class=\"fw-bold text-dark mt-3 mb-2 pb-1 border-bottom d-flex align-items-center gap-2\">{headingText}</h4>");
                continue;
            }

            // Bullet list
            if (line.StartsWith("- ") || line.StartsWith("* ") || line.StartsWith("+ "))
            {
                if (!inList)
                {
                    sb.Append("<ul class=\"list-unstyled ps-1 mb-2 d-flex flex-column gap-2\">");
                    inList = true;
                }
                var itemText = FormatInline(line.Substring(2));
                sb.Append($"<li class=\"d-flex align-items-start gap-2\"><i class=\"bi bi-check-circle-fill text-success fs-6 mt-1 flex-shrink-0\"></i><span>{itemText}</span></li>");
                continue;
            }

            // Nested list or indented bullet
            if (line.StartsWith("  + ") || line.StartsWith("  - "))
            {
                var itemText = FormatInline(line.Substring(4));
                sb.Append($"<li class=\"d-flex align-items-start gap-2 ms-4\"><i class=\"bi bi-dot text-info fs-5 flex-shrink-0\"></i><span>{itemText}</span></li>");
                continue;
            }

            // Regular paragraph
            if (inList)
            {
                sb.Append("</ul>");
                inList = false;
            }

            sb.Append($"<p class=\"mb-2\">{FormatInline(line)}</p>");
        }

        if (inList)
        {
            sb.Append("</ul>");
        }

        return sb.ToString();
    }

    private static string FormatInline(string text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;

        // 1. HtmlEncode để chống XSS
        var encoded = System.Net.WebUtility.HtmlEncode(text);

        // 2. Bold: **text**
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong class=\"text-dark fw-bold\">$1</strong>");

        // 3. Italic: *text*
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*(.+?)\*", "<em class=\"text-muted\">$1</em>");

        // 4. Inline code: `code`
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"`(.+?)`", "<code class=\"bg-white border px-1 py-0 rounded text-primary fw-semibold\" style=\"font-size: 0.88rem;\">$1</code>");

        // 5. Safe markdown link: [text](/duong-dan-noi-bo) - chỉ cho phép đường dẫn bắt đầu bằng / đơn lẻ
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded,
            @"\[([^\]]+)\]\((/[^/\)][^\)]*)\)",
            "<a href=\"$2\" class=\"fw-bold text-decoration-underline text-primary\">$1 <i class=\"bi bi-box-arrow-up-right small\"></i></a>"
        );

        return encoded;
    }

    public void Dispose()
    {
        CurrentUserStateStore.RemoveStateChangeListeners(HandleUserStateChange);
        ChatSessionState.OnChange -= OnSessionChanged;
    }
