@namespace CourseRegistration.Web.Components.Layout
@inject ICurrentUserStateStore CurrentUserStateStore
@inject IStudentRepository StudentRepository
@inject IRegistrationCartStateStore CartStateStore
@inject ILoginModalService LoginModalService
@inject NavigationManager NavigationManager
@implements IDisposable

<!-- Dropdown Backdrop Overlay (Tự động đóng tất cả dropdown khi bấm ra ngoài bất kỳ đâu) -->
@if (isAdminDropdownOpen || isUserDropdownOpen || isMobileNavExpanded)
{
    <div class="dropdown-backdrop-overlay" @onclick="CloseAllDropdowns"></div>
}

<!-- Top Desktop & Tablet Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark custom-navbar sticky-top py-2 shadow-sm">
    <div class="container position-relative">
        <!-- Khối bên trái: Nút 3 thanh (mobile) + Logo Đăng Ký Học Phần -->
        <div class="d-flex align-items-center gap-2">
            <button class="navbar-toggler border-0 p-1 d-lg-none flex-shrink-0" 
                    type="button" 
                    @onclick="() => isMobileNavExpanded = !isMobileNavExpanded"
                    aria-label="Menu điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>

            <a class="navbar-brand fw-bold d-flex align-items-center text-white m-0" href="/">
                <div class="brand-logo-icon me-2 flex-shrink-0">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div class="d-flex flex-column">
                    <span class="lh-1 fw-bold brand-header-title">Đăng Ký Học Phần</span>
                    <span class="brand-subtext d-none d-sm-block">Cổng Đào Tạo Trực Tuyến</span>
                </div>
            </a>
        </div>

        <!-- Khối bên phải trên di động: Nút Giỏ Đăng Ký vừa vặn trên cùng hàng -->
        <div class="d-flex align-items-center d-lg-none ms-auto">
            <CartBadgeComponent />
        </div>

        <!-- Menu Desktop ở trên cùng hàng ngang với Logo & Accordion trên di động -->
        <div class="collapse navbar-collapse @(isMobileNavExpanded ? "show" : "")" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseAllDropdowns">
                        <i class="bi bi-house-door me-1"></i> Trang chủ
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/sections" @onclick="CloseAllDropdowns">
                        <i class="bi bi-search me-1"></i> Tra cứu học phần
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/schedule" @onclick="CloseAllDropdowns">
                        <i class="bi bi-calendar3 me-1"></i> Thời khóa biểu
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="/tuition" @onclick="CloseAllDropdowns">
                        <i class="bi bi-wallet2 text-warning me-1"></i> Thanh toán học phí
                    </NavLink>
                </li>
                @if (isAuthenticated && currentRole == "Admin")
                {
                    <li class="nav-item dropdown position-relative">
                        <button class="nav-link dropdown-toggle d-flex align-items-center bg-transparent border-0 text-warning" 
                                type="button" 
                                @onclick="ToggleAdminDropdown">
                            <i class="bi bi-shield-lock me-1"></i> Phòng Đào Tạo
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark shadow border-0 rounded-3 @(isAdminDropdownOpen ? "show" : "")">
                            <li>
                                <a class="dropdown-item py-2" href="/admin/courses" @onclick="CloseAllDropdowns">
                                    <i class="bi bi-book text-primary me-2"></i> Danh mục Môn học
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/admin/sections" @onclick="CloseAllDropdowns">
                                    <i class="bi bi-collection text-info me-2"></i> Mở & Quản lý Lớp HP
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/admin/enrollments" @onclick="CloseAllDropdowns">
                                    <i class="bi bi-people text-success me-2"></i> Quản lý Đăng ký & Rút môn SV
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/admin/tuition" @onclick="CloseAllDropdowns">
                                    <i class="bi bi-wallet2 text-warning me-2"></i> Quản lý Học Phí & Chế Tài Thi
                                </a>
                            </li>
                            <li><hr class="dropdown-divider border-secondary opacity-50"></li>
                            <li>
                                <a class="dropdown-item py-2" href="/ai-advisor" @onclick="CloseAllDropdowns">
                                    <i class="bi bi-stars text-warning me-2"></i> Trợ Lý AI Phòng Đào Tạo
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>

            <div class="d-flex align-items-center flex-nowrap gap-2 pt-2 pt-lg-0 border-top border-secondary border-opacity-25 border-top-lg-0">
                <!-- User Switcher & Auth Controls -->
                @if (!isAuthenticated)
                {
                    <button type="button" 
                            class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill shadow-sm"
                            style="height: 38px;"
                            @onclick="OpenLoginModal">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span class="fw-semibold small">Đăng nhập</span>
                    </button>
                }
                else
                {
                    <div class="dropdown position-relative">
                        <button class="btn btn-dark user-profile-btn dropdown-toggle d-inline-flex align-items-center gap-2 border border-secondary border-opacity-50 py-1" 
                                style="height: 38px;"
                                type="button" 
                                @onclick="ToggleUserDropdown">
                            @if (currentRole == "Admin")
                            {
                                <div class="user-avatar bg-danger text-white">
                                    <i class="bi bi-shield-lock-fill"></i>
                                </div>
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-bold small lh-1 text-white">@(currentUser?.FullName ?? "Cán bộ Quản lý")</div>
                                    <span class="badge bg-danger-subtle text-danger px-1 py-0" style="font-size: 0.68rem;">Phòng Đào Tạo</span>
                                </div>
                            }
                            else if (currentStudent != null || currentUser != null)
                            {
                                var displayName = currentStudent?.FullName ?? currentUser?.FullName ?? "Sinh viên";
                                var displayCode = currentStudent?.StudentCode ?? currentUser?.Username ?? "SV";
                                <div class="user-avatar @(currentStudent?.StudentCode == "SV21002" ? "bg-warning text-dark" : "bg-primary")">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-bold small lh-1 text-white">@displayName</div>
                                    <span class="badge @(currentStudent?.StudentCode == "SV21002" ? "bg-warning-subtle text-warning" : "bg-primary-subtle text-primary") px-1 py-0" style="font-size: 0.68rem;">
                                        @displayCode &bull; @(currentStudent?.MaxCreditsPerSemester ?? 24) TC
                                    </span>
                                </div>
                            }
                        </button>
                        
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2 @(isUserDropdownOpen ? "show" : "")" style="min-width: 320px; max-width: 380px;">
                            <!-- Header thông tin tài khoản -->
                            <li class="px-1 py-1 mb-2">
                                <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3 border">
                                    <div class="user-avatar @(currentRole == "Admin" ? "bg-danger text-white" : "bg-primary text-white")">
                                        <i class="bi @(currentRole == "Admin" ? "bi-shield-lock-fill" : "bi-person-fill")"></i>
                                    </div>
                                    <div class="text-truncate">
                                        <div class="fw-bold small text-dark text-truncate">@(currentUser?.FullName ?? currentStudent?.FullName ?? "Người dùng")</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">
                                            @(currentRole == "Admin" ? "Quản Trị Viên (Admin)" : $"MSSV: {currentStudent?.StudentCode ?? currentUser?.Username}")
                                        </div>
                                    </div>
                                </div>
                            </li>

                            @if (currentRole == "Admin")
                            {
                                <li class="dropdown-header small text-uppercase text-danger fw-bold pb-1">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Quản Trị Hệ Thống
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/admin/courses" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-book text-primary me-2"></i>
                                        <span class="small fw-semibold">Quản lý Môn học</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/admin/sections" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-collection text-info me-2"></i>
                                        <span class="small fw-semibold">Mở & Quản lý Lớp HP</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/admin/enrollments" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-people text-success me-2"></i>
                                        <span class="small fw-semibold">Quản lý Đăng ký & Rút môn</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-2"></li>
                                
                                <!-- Phần KÉO THẢ TOÀN BỘ TÀI KHOẢN SINH VIÊN -->
                                <li class="px-1 py-1">
                                    <button type="button" 
                                            class="btn btn-sm @(isStudentListExpanded ? "btn-primary text-white" : "btn-outline-primary") w-100 d-flex align-items-center justify-content-between rounded-3 py-2 px-3 text-start transition-all"
                                            @onclick="() => isStudentListExpanded = !isStudentListExpanded">
                                        <span class="d-flex align-items-center gap-2 text-truncate">
                                            <i class="bi bi-people-fill"></i>
                                            <span class="small fw-bold">Toàn bộ tài khoản SV (@availableStudents.Count)</span>
                                        </span>
                                        <i class="bi @(isStudentListExpanded ? "bi-chevron-up" : "bi-chevron-down") fw-bold"></i>
                                    </button>
                                </li>
                                @if (isStudentListExpanded)
                                {
                                    <li class="px-1 pt-2 pb-1">
                                        <div class="input-group input-group-sm mb-2 shadow-sm">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                            <input type="text" 
                                                   class="form-control border-start-0" 
                                                   placeholder="Tìm theo MSSV hoặc họ tên..." 
                                                   @bind="studentSearchKeyword" 
                                                   @bind:event="oninput" />
                                            @if (!string.IsNullOrWhiteSpace(studentSearchKeyword))
                                            {
                                                <button class="btn btn-outline-secondary border-start-0 bg-white" type="button" @onclick="() => studentSearchKeyword = string.Empty">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            }
                                        </div>
                                        
                                        <div class="student-dropdown-scrollable border rounded-3 p-1 bg-light-subtle" style="max-height: 220px; overflow-y: auto;">
                                            @foreach (var s in FilteredStudents)
                                            {
                                                bool isCurrent = currentStudent?.StudentId == s.StudentId;
                                                <button type="button" 
                                                        class="dropdown-item rounded-2 py-1 px-2 mb-1 d-flex align-items-center justify-content-between @(isCurrent ? "bg-primary-subtle border-start border-primary border-3" : "bg-white")" 
                                                        @onclick="() => SwitchStudent(s.StudentId)">
                                                    <div class="d-flex align-items-center gap-2 text-truncate">
                                                        <div class="user-avatar-sm @(s.StudentCode == "SV21002" ? "bg-warning text-dark" : "bg-primary text-white")">
                                                            <i class="bi bi-person"></i>
                                                        </div>
                                                        <div class="text-truncate">
                                                            <div class="fw-bold small text-truncate">@s.FullName</div>
                                                            <div class="text-muted" style="font-size: 0.72rem;">@s.StudentCode &bull; @s.Major</div>
                                                            <div class="extra-info-text @(s.StudentCode == "SV21002" ? "text-danger fw-semibold" : "text-success")" style="font-size: 0.68rem;">
                                                                @(s.StudentCode == "SV21002" ? "⚠️ Demo chặn Tiên quyết" : "✓ Đạt chuẩn tiên quyết")
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (isCurrent)
                                                    {
                                                        <span class="badge bg-primary text-white ms-1" style="font-size: 0.62rem;">Đang chọn</span>
                                                    }
                                                </button>
                                            }
                                            @if (!FilteredStudents.Any())
                                            {
                                                <div class="text-center text-muted small py-3">
                                                    <i class="bi bi-search text-secondary d-block mb-1"></i>
                                                    Không tìm thấy sinh viên
                                                </div>
                                            }
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="px-3 py-1 mb-2 small text-muted">
                                    <div>Ngành: <strong class="text-dark">@(currentStudent?.Major ?? "Công nghệ thông tin")</strong></div>
                                    <div class="text-primary fw-semibold mt-1">
                                        Hạn mức kỳ này: @(currentStudent?.MaxCreditsPerSemester ?? 24) Tín chỉ
                                    </div>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/cart" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-cart3 text-success me-2"></i>
                                        <span class="small fw-semibold">Giỏ đăng ký của tôi</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/schedule" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-calendar3 text-info me-2"></i>
                                        <span class="small fw-semibold">Thời khóa biểu của tôi</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/tuition" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-wallet2 text-warning me-2"></i>
                                        <span class="small fw-semibold">Thanh toán học phí</span>
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider my-2"></li>
                            <li>
                                <button class="dropdown-item rounded-2 py-2 d-flex align-items-center text-danger fw-semibold" @onclick="HandleLogout">
                                    <i class="bi bi-box-arrow-right me-2 fs-6"></i>
                                    <span>Đăng xuất</span>
                                </button>
                            </li>
                        </ul>
                    </div>
                }

                <!-- Desktop Cart Badge -->
                <div class="d-none d-lg-block">
                    <CartBadgeComponent />
                </div>
            </div>
        </div>
    </div>
</nav>

<!-- Mobile Native-Style Bottom Navigation Bar (Dành riêng cho Điện thoại < 768px) -->
<div class="mobile-bottom-nav d-lg-none">
    <div class="mobile-nav-container">
        <NavLink class="mobile-nav-item" href="/" Match="NavLinkMatch.All">
            <i class="bi bi-house-door"></i>
            <span>Trang chủ</span>
        </NavLink>
        <NavLink class="mobile-nav-item" href="/sections">
            <i class="bi bi-search"></i>
            <span>Tra cứu</span>
        </NavLink>
        <NavLink class="mobile-nav-item position-relative" href="/cart">
            <div class="cart-icon-wrapper">
                <i class="bi bi-cart3"></i>
                @if (cartCount > 0)
                {
                    <span class="mobile-cart-badge">@cartCount</span>
                }
            </div>
            <span>Giỏ môn</span>
        </NavLink>
        <NavLink class="mobile-nav-item" href="/schedule">
            <i class="bi bi-calendar3"></i>
            <span>Lịch học</span>
        </NavLink>
        @if (currentRole == "Admin")
        {
            <NavLink class="mobile-nav-item" href="/admin/courses">
                <i class="bi bi-shield-lock"></i>
                <span>Quản trị</span>
            </NavLink>
        }
        else if (!isAuthenticated)
        {
            <button type="button" class="mobile-nav-item bg-transparent border-0" @onclick="OpenLoginModal">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>Đăng nhập</span>
            </button>
        }
        else
        {
            <NavLink class="mobile-nav-item" href="/tuition">
                <i class="bi bi-wallet2"></i>
                <span>Học phí</span>
            </NavLink>
        }
    </div>
</div>

@code {
    private List<Student> availableStudents = new List<Student>();
    private Student? currentStudent;
    private UserAccount? currentUser;
    private string currentRole = string.Empty;
    private bool isAuthenticated = false;
    private int cartCount = 0;

    private bool isAdminDropdownOpen = false;
    private bool isUserDropdownOpen = false;
    private bool isMobileNavExpanded = false;
    private bool isStudentListExpanded = false;
    private string studentSearchKeyword = string.Empty;

    private IEnumerable<Student> FilteredStudents =>
        string.IsNullOrWhiteSpace(studentSearchKeyword)
            ? availableStudents
            : availableStudents.Where(s => 
                (s.StudentCode?.Contains(studentSearchKeyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.FullName?.Contains(studentSearchKeyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.Major?.Contains(studentSearchKeyword, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        CurrentUserStateStore.AddStateChangeListeners(HandleUserStateChange);
        CartStateStore.AddStateChangeListeners(HandleCartStateChange);

        availableStudents = (await StudentRepository.GetAllStudentsAsync()).ToList();
        await RefreshUserState();
        await RefreshCartCount();
    }

    private async void HandleUserStateChange()
    {
        await RefreshUserState();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleCartStateChange()
    {
        await RefreshCartCount();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUserState()
    {
        isAuthenticated = await CurrentUserStateStore.IsAuthenticatedAsync();
        currentUser = await CurrentUserStateStore.GetCurrentUserAsync();
        int studentId = await CurrentUserStateStore.GetCurrentStudentIdAsync();
        currentRole = await CurrentUserStateStore.GetCurrentRoleAsync();
        currentStudent = availableStudents.FirstOrDefault(s => s.StudentId == studentId);
    }

    private async Task RefreshCartCount()
    {
        cartCount = await CartStateStore.GetItemsCount();
    }

    private void ToggleAdminDropdown()
    {
        isUserDropdownOpen = false;
        isAdminDropdownOpen = !isAdminDropdownOpen;
    }

    private void ToggleUserDropdown()
    {
        isAdminDropdownOpen = false;
        isUserDropdownOpen = !isUserDropdownOpen;
    }

    private async Task SwitchStudent(int studentId)
    {
        CloseAllDropdowns();
        await CurrentUserStateStore.SetCurrentStudentIdAsync(studentId);
    }

    private async Task HandleLogout()
    {
        CloseAllDropdowns();
        await CurrentUserStateStore.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    private void CloseAllDropdowns()
    {
        isAdminDropdownOpen = false;
        isUserDropdownOpen = false;
        isMobileNavExpanded = false;
        isStudentListExpanded = false;
        studentSearchKeyword = string.Empty;
    }

    private void OpenLoginModal()
    {
        CloseAllDropdowns();
        LoginModalService.Open();
    }

    public void Dispose()
    {
        CurrentUserStateStore.RemoveStateChangeListeners(HandleUserStateChange);
        CartStateStore.RemoveStateChangeListeners(HandleCartStateChange);
    }
}
