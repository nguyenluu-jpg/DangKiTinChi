@page "/schedule"
@namespace CourseRegistration.Web.Components.Pages
@inject IViewScheduleUseCase ViewScheduleUseCase
@inject IStudentRepository StudentRepository
@inject ICurrentUserStateStore CurrentUserStateStore
@inject ILoginModalService LoginModalService
@implements IDisposable

@inject IEnrollmentRepository EnrollmentRepository

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-calendar3 text-primary me-2"></i>Thời Khóa Biểu Sinh Viên
        </h2>
        <p class="text-muted mb-0">Học kỳ 1 (Năm học 2026 - 2027) &bull; Lịch học theo tuần và từng ngày trực quan</p>
    </div>
    
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (currentEnrollmentId.HasValue && currentEnrollmentId.Value > 0)
        {
            <a href="/api/reports/student-enrollment/excel?enrollmentId=@currentEnrollmentId.Value" class="btn btn-outline-success fw-bold shadow-sm" target="_blank" download>
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel TKB
            </a>
            <a href="/api/reports/student-enrollment/pdf?enrollmentId=@currentEnrollmentId.Value" class="btn btn-outline-danger fw-bold shadow-sm" target="_blank">
                <i class="bi bi-file-earmark-pdf me-1"></i> Xuất Phiếu ĐK (PDF)
            </a>
        }
        <button class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In Nhanh
        </button>
        @if (currentRole == "Admin")
        {
            <div class="d-flex align-items-center gap-1">
                <span class="badge bg-danger text-white">Admin</span>
                <label class="small text-muted fw-bold d-none d-sm-inline">Xem lịch SV:</label>
                <select class="form-select form-select-sm" style="min-width: 220px;" @onchange="OnStudentChanged">
                    @foreach (var s in students)
                    {
                        <option value="@s.StudentId" selected="@(s.StudentId == selectedStudentId)">
                            @s.StudentCode - @s.FullName
                        </option>
                    }
                </select>
            </div>
        }
    </div>
</div>

@if (!isAuthenticated)
{
    <div class="card border-0 shadow-sm text-center py-5 bg-white rounded-4 mb-4">
        <i class="bi bi-calendar-x fs-1 text-muted mb-3"></i>
        <h4 class="fw-bold text-dark">Vui Lòng Đăng Nhập</h4>
        <p class="text-muted small mb-4 mx-auto" style="max-width: 500px;">
            Để xem thời khóa biểu chi tiết, vui lòng đăng nhập bằng tài khoản Sinh viên của bạn hoặc tài khoản Quản trị viên.
        </p>
        <div>
            <button type="button" 
                    class="btn btn-primary px-4 py-2 fw-bold"
                    @onclick="() => LoginModalService.Open()">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Ngay
            </button>
        </div>
    </div>
}
else if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Đang tải thời khóa biểu...</p>
    </div>
}
else if (!registeredSections.Any())
{
    <div class="card border-0 shadow-sm text-center py-5 bg-white rounded-4">
        <i class="bi bi-calendar-x fs-1 text-muted mb-3"></i>
        <h5 class="fw-bold text-muted">Chưa có lịch học</h5>
        <p class="text-muted small mb-4">
            Sinh viên <strong>@(currentStudent?.FullName ?? "này")</strong> (@(currentStudent?.StudentCode)) chưa có phiếu đăng ký nào được xác nhận trong học kỳ hiện tại.
        </p>
        <div>
            <a href="/sections" class="btn btn-primary px-4 py-2">
                <i class="bi bi-plus-circle me-1"></i> Đăng ký lớp học phần ngay
            </a>
        </div>
    </div>
}
else
{
    int totalCredits = registeredSections.Where(s => s.Course != null).Sum(s => s.Course!.Credits);

    <!-- Card Thống kê Lịch Học -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white rounded-4">
        <div class="row g-3 align-items-center">
            <div class="col-sm-6">
                <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar @(selectedStudentId == 1 ? "bg-primary text-white" : "bg-warning text-dark")">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">@currentStudent?.FullName (@currentStudent?.StudentCode)</div>
                        <div class="text-muted small">@currentStudent?.Major &bull; @currentStudent?.AcademicYear</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 text-sm-end">
                <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2 me-2">
                    <i class="bi bi-collection me-1"></i>@registeredSections.Count() Lớp Học Phần
                </span>
                <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">
                    <i class="bi bi-journal-check me-1"></i>Tổng @totalCredits Tín Chỉ
                </span>
            </div>
        </div>
    </div>

    <!-- Hiển thị thời khóa biểu qua Reusable Component ScheduleTableComponent (K3.1) -->
    <div class="mb-4">
        <ScheduleTableComponent Sections="@registeredSections" />
    </div>

    <!-- Tóm tắt danh sách các môn đã đăng ký -->
    <div class="card border-0 shadow-sm p-4 bg-white rounded-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-check text-primary me-2"></i>Tổng Hợp Các Lớp Đã Xác Nhận Trong Kỳ
            </h5>
            <span class="text-muted small">@registeredSections.Count() lớp</span>
        </div>

        <div class="row row-cols-1 row-cols-md-2 g-3">
            @foreach (var sec in registeredSections)
            {
                <div class="col">
                    <div class="p-3 border rounded-3 bg-light-subtle h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary-subtle text-primary fw-bold fs-6">@sec.SectionCode</span>
                            <span class="badge bg-secondary">@(sec.Course?.Credits ?? 0) Tín chỉ</span>
                        </div>
                        <h6 class="fw-bold mb-2 text-dark">@sec.Course?.CourseName</h6>
                        <div class="small text-muted mb-2">
                            <div><i class="bi bi-person-badge me-1"></i> Giảng viên: <strong>@sec.Instructor</strong></div>
                            <div><i class="bi bi-geo-alt me-1"></i> Phòng: <strong>@(string.IsNullOrEmpty(sec.Room) ? "Chưa xếp" : sec.Room)</strong></div>
                        </div>

                        @if (sec.Schedules != null && sec.Schedules.Any())
                        {
                            <div class="pt-2 border-top">
                                <span class="small fw-bold text-muted me-1">Lịch:</span>
                                @foreach (var sched in sec.Schedules)
                                {
                                    <span class="badge bg-info-subtle text-dark border me-1">
                                        @sched.DayOfWeekName (T @sched.StartPeriod-@sched.EndPeriod)
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Student> students = new List<Student>();
    private Student? currentStudent;
    private int selectedStudentId = 0;
    private bool isAuthenticated = false;
    private string currentRole = string.Empty;
    private IEnumerable<Section> registeredSections = new List<Section>();
    private bool isLoading = true;

    private int? currentEnrollmentId;

    protected override async Task OnInitializedAsync()
    {
        CurrentUserStateStore.AddStateChangeListeners(HandleUserStateChange);
        students = (await StudentRepository.GetAllStudentsAsync()).ToList();

        await RefreshUserState();
        await LoadSchedule();
    }

    private async Task RefreshUserState()
    {
        isAuthenticated = await CurrentUserStateStore.IsAuthenticatedAsync();
        currentRole = await CurrentUserStateStore.GetCurrentRoleAsync();
        selectedStudentId = await CurrentUserStateStore.GetCurrentStudentIdAsync();
        currentStudent = students.FirstOrDefault(s => s.StudentId == selectedStudentId);
    }

    private async void HandleUserStateChange()
    {
        await RefreshUserState();
        await LoadSchedule();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSchedule()
    {
        isLoading = true;
        if (selectedStudentId > 0)
        {
            registeredSections = await ViewScheduleUseCase.ExecuteAsync(selectedStudentId, "2026_HK1");
            var enrollments = await EnrollmentRepository.GetEnrollmentsByStudentIdAsync(selectedStudentId);
            currentEnrollmentId = enrollments.FirstOrDefault(e => e.Semester == "2026_HK1" && e.Status == "Confirmed")?.EnrollmentId;
        }
        else
        {
            registeredSections = new List<Section>();
            currentEnrollmentId = null;
        }
        isLoading = false;
    }

    private async Task OnStudentChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedStudentId = id;
            currentStudent = students.FirstOrDefault(s => s.StudentId == id);
            await CurrentUserStateStore.SetCurrentStudentIdAsync(id);
            await LoadSchedule();
        }
    }

    public void Dispose()
    {
        CurrentUserStateStore.RemoveStateChangeListeners(HandleUserStateChange);
    }
}
