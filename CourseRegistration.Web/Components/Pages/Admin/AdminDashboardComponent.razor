                                int maxCap = sec.MaxCapacity > 0 ? sec.MaxCapacity : 40;
                                int percent = (int)Math.Round((double)currentEnroll / maxCap * 100);
                                string badgeColor = percent >= 90 ? "bg-danger" : percent >= 60 ? "bg-success" : "bg-warning text-dark";

