                                        <div class="text-muted" style="font-size: 0.72rem;">@(sec.Course?.CourseCode ?? "") &bull; @(sec.Course?.Credits ?? 3) TC</div>
                                    </td>
                                    <td>@(sec.Instructor ?? "Chưa phân công")</td>
                                    <td class="text-center fw-bold">@currentEnroll / @maxCap</td>
