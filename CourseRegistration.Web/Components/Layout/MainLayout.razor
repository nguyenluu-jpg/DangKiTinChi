@inherits LayoutComponentBase
@namespace CourseRegistration.Web.Components.Layout
@inject IJSRuntime JSRuntime
@inject CourseRegistration.UseCases.PluginInterfaces.StateStore.ICurrentUserStateStore CurrentUserStateStore
@inject CourseRegistration.UseCases.PluginInterfaces.DataStore.IUserAccountRepository UserAccountRepository

<div class="page d-flex flex-column min-vh-100 bg-light">
    <header>
        <NavMenu />
    </header>

    <main class="flex-grow-1 py-4">
        <div class="container">
            @Body
        </div>
    </main>

    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container text-center text-muted small">
            <div><strong>Hệ Thống Đăng Ký Học Phần Trực Tuyến</strong> &bull; Năm học 2026 - 2027</div>
            <div>Phân hệ Sinh viên &amp; Phòng Đào Tạo &bull; Cổng dịch vụ đào tạo tín chỉ trực tuyến</div>
        </div>
    </footer>
</div>

<LoginModalComponent />
<CourseRegistration.Web.Components.Shared.ChangePasswordModalComponent />

<!-- Robot Cố Vấn Học Thuật AI Nổi Góc Phải (Floating AI Robot) -->
<CourseRegistration.Web.Components.Shared.AiRobotWidgetComponent />

<div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3 d-none">
    Có lỗi xảy ra trong ứng dụng.
    <a href="" class="reload">Tải lại</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Không tự động đăng nhập khi mở web/F5; dọn dẹp session cũ nếu có
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "courseReg_username");
            }
            catch { }
        }
    }
}
