        <div class="d-flex align-items-center justify-content-end gap-2 mt-3 pt-1">
            <button type="button" 
                    class="btn fw-semibold shadow-none" 
                    style="background-color: #edf2fa; color: #0b57d0; border: none; border-radius: 999px; font-size: 0.84rem; padding: 7px 14px;"
