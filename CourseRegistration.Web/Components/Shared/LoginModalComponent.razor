@namespace CourseRegistration.Web.Components.Shared
@inject ILoginModalService LoginModalService
@inject ILoginUseCase LoginUseCase
@inject ICurrentUserStateStore CurrentUserStateStore
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (LoginModalService.IsVisible)
{
    <!-- Modal Backdrop Overlay (Cố định: không bị mất modal khi chạm ra bên ngoài) -->
    <div class="login-modal-overlay">
        <div class="login-modal-dialog">
            <!-- Modal Card -->
            <div class="login-modal-content card border-0 shadow-2xl rounded-4 overflow-hidden">
                <!-- Header Gradient (Giao diện cũ, đã bỏ hình tròn trắng) -->
                <div class="login-modal-header text-white text-center py-4 px-4 position-relative">
                    <button type="button" 
                            class="btn-close-modal position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center" 
                            @onclick="CloseModal"
                            aria-label="Đóng">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <div class="mb-2">
                        <i class="bi bi-mortarboard-fill fs-1 text-white"></i>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">Đăng Nhập Hệ Thống</h4>
                    <div class="text-white-50 small">Cổng Đăng Ký Học Phần Trực Tuyến</div>
                </div>

                <!-- Body (Giao diện chuẩn ban đầu) -->
                <div class="card-body p-4 p-md-4 bg-white" data-ms-editor="false">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center rounded-3 mb-3 py-2 px-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                            <div class="small fw-semibold">
                                @errorMessage
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1">Tài khoản / MSSV <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-person"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-start-0 ps-0 bg-light" 
                                   placeholder="Nhập mã sinh viên hoặc tên đăng nhập" 
                                   id="txt_auth_uid"
                                   name="txt_auth_uid"
                                   autocomplete="off"
                                   autocorrect="off"
                                   autocapitalize="off"
                                   spellcheck="false"
                                   data-lpignore="true"
                                   data-bwignore="true"
                                   data-1p-ignore="true"
                                   data-ms-editor="false"
                                   data-form-type="other"
                                   @bind="loginModel.Username" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleKeyDown" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1">Mã truy cập (Mật khẩu) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input type="@(showPassword ? "text" : "password")" 
                                   class="form-control border-start-0 border-end-0 ps-0 bg-light" 
                                   placeholder="Nhập mã truy cập của bạn" 
                                   id="txt_auth_sec"
                                   name="txt_auth_sec"
                                   autocomplete="off"
                                   autocorrect="off"
                                   autocapitalize="off"
                                   spellcheck="false"
                                   data-lpignore="true"
                                   data-bwignore="true"
                                   data-1p-ignore="true"
                                   data-ms-editor="false"
                                   data-form-type="other"
                                   @bind="loginModel.Password" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleKeyDown" />
                            <button type="button" 
                                     class="input-group-text bg-light border-start-0 text-muted cursor-pointer"
                                     @onclick="() => showPassword = !showPassword"
                                     title="@(showPassword ? "Ẩn mã truy cập" : "Hiện mã truy cập")">
                                <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Tùy chọn lưu mật khẩu & Lời khuyên cho sinh viên -->
                    <div class="mb-3">
                        <div class="form-check d-flex align-items-center gap-2 mb-1">
                            <input class="form-check-input mt-0 cursor-pointer" 
                                   type="checkbox" 
                                   id="chkRememberPassword" 
                                   @bind="loginModel.RememberPassword" />
                            <label class="form-check-label text-dark small cursor-pointer fw-semibold" for="chkRememberPassword">
                                Lưu mật khẩu trên máy này?
                            </label>
                        </div>
                        <div class="text-muted small ps-4" style="font-size: 0.76rem; line-height: 1.4;">
                            <span class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i>Nên lưu:</span> Máy tính cá nhân, điện thoại riêng.<br />
                            <span class="text-danger fw-semibold"><i class="bi bi-x-circle me-1"></i>Không nên lưu:</span> Máy trường, phòng thực hành, thư viện.
                        </div>
                    </div>

                    <!-- Nút Đăng Nhập nguyên bản duy nhất -->
                    <button type="button" 
                            class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3"
                            disabled="@isLoading"
                            @onclick="HandleLogin">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Đang xác thực...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right fs-5"></i>
                            <span>Đăng Nhập</span>
                        }
                    </button>

                    <div class="mt-3 pt-3 border-top text-center text-secondary small" style="font-size: 0.78rem;">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Hệ thống xác thực tài khoản sinh viên &amp; cán bộ quản trị.
                        <div class="mt-1 text-muted" style="font-size: 0.74rem;">
                            Quên mật khẩu hoặc cần cấp lại tài khoản? Vui lòng liên hệ <span class="fw-semibold text-dark">Phòng Đào Tạo</span>.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private LoginViewModel loginModel = new LoginViewModel();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;

    protected override void OnInitialized()
    {
        LoginModalService.OnChange += HandleModalStateChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadRememberedCredentialsAsync();
        }
    }

    private async void HandleModalStateChange()
    {
        if (LoginModalService.IsVisible)
        {
            errorMessage = string.Empty;
            showPassword = false;
            await LoadRememberedCredentialsAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadRememberedCredentialsAsync()
    {
        try
        {
            var saved = await JSRuntime.InvokeAsync<SavedAuthModel?>("authStorage.loadCredentials");
            if (saved != null && saved.Remember && !string.IsNullOrEmpty(saved.Username))
            {
                loginModel.Username = saved.Username;
                loginModel.Password = saved.Password ?? string.Empty;
                loginModel.RememberPassword = true;
            }
        }
        catch
        {
            // Bỏ qua nếu môi trường không cho phép truy xuất localStorage
        }
    }

    private void CloseModal()
    {
        LoginModalService.Close();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var account = await LoginUseCase.ExecuteAsync(loginModel.Username.Trim(), loginModel.Password);
            if (account != null)
            {
                // Xử lý lưu / xóa mật khẩu theo lựa chọn của người dùng
                if (loginModel.RememberPassword)
                {
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("authStorage.saveCredentials", 
                            loginModel.Username.Trim(), 
                            loginModel.Password, 
                            true);
                    }
                    catch { }
                }
                else
                {
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("authStorage.clearCredentials");
                    }
                    catch { }
                }

                await CurrentUserStateStore.SetCurrentUserAsync(account);
                
                // Đóng modal để trở lại giao diện
                LoginModalService.Close();

                // Giữ nguyên trang đang đứng, chỉ điều hướng nếu đang ở route /login riêng lẻ
                var uri = new Uri(NavigationManager.Uri);
                if (uri.AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo("/");
                }
                else
                {
                    NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: false);
                }
            }
            else
            {
                errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác. Vui lòng thử lại!";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Có lỗi xảy ra trong quá trình đăng nhập: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        LoginModalService.OnChange -= HandleModalStateChange;
    }

    public class LoginViewModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberPassword { get; set; } = false;
    }

    public class SavedAuthModel
    {
        public bool Remember { get; set; }
        public string Username { get; set; } = string.Empty;
        public string? Password { get; set; }
    }
}
