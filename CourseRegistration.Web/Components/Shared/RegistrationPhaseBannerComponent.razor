@namespace CourseRegistration.Web.Components.Shared
@inject IRegistrationPeriodService RegistrationPeriodService

<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden phase-banner-card">
    <div class="card-header bg-gradient-primary-subtle p-3 p-md-4 border-0">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="phase-icon-box bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm">
                    <i class="bi bi-calendar-event-fill fs-4"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge bg-primary px-2 py-1 rounded-pill small">Hệ thống Đào tạo Tín chỉ</span>
                        @if (isOpen)
                        {
                            <span class="badge bg-success text-white px-2 py-1 rounded-pill d-inline-flex align-items-center gap-1 shadow-xs">
                                <span class="pulse-dot"></span> ĐANG MỞ ĐĂNG KÝ
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white px-2 py-1 rounded-pill">
                                <i class="bi bi-lock-fill me-1"></i> CỔNG ĐÓNG
                            </span>
                        }
                    </div>
                    <h5 class="fw-bold mb-0 text-dark mt-1">
                        @selectedSemester?.SemesterName
                    </h5>
                </div>
            </div>

            @if (ShowControls)
            {
                <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                    <!-- Chọn Học kỳ -->
                    <div class="input-group input-group-sm semester-select-group shadow-xs">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-bookmark-fill text-primary"></i>
                        </span>
                        <select class="form-select form-select-sm border-start-0 fw-semibold text-primary" 
                                value="@SelectedSemesterCode" 
                                @onchange="HandleSemesterChanged">
                            @foreach (var sem in allSemesters)
                            {
                                <option value="@sem.SemesterCode">@sem.ShortName</option>
                            }
                        </select>
                    </div>

                    <!-- Giả lập giai đoạn phục vụ Demo chấm thi -->
                    <div class="input-group input-group-sm demo-sim-group shadow-xs">
                        <span class="input-group-text bg-white border-end-0 text-warning" title="Chế độ biểu diễn cho Giảng viên">
                            <i class="bi bi-sliders2-vertical"></i>
                        </span>
                        <select class="form-select form-select-sm border-start-0 text-dark" 
                                value="@(RegistrationPeriodService.SimulatedPhaseOverride?.ToString() ?? "0")" 
                                @onchange="HandlePhaseOverrideChanged"
                                title="Linh hoạt chuyển đổi giai đoạn để chiếu cho Giảng viên kiểm tra">
                            <option value="0">⏱️ Thời gian thực tế (Bao trùm 02/11/2026)</option>
                            <option value="1">🧪 Mô phỏng GĐ 1: ĐK Chính thức</option>
                            <option value="2">🧪 Mô phỏng GĐ 2: ĐK Bổ sung & Học vượt</option>
                            <option value="3">🧪 Mô phỏng GĐ 3: Rút môn & Học phí</option>
                        </select>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 3 Giai đoạn của học kỳ hiển thị dạng Stepper / Process Card -->
    <div class="card-body p-3 p-md-4 bg-white">
        @if (selectedSemester != null)
        {
            <div class="row g-3">
                @foreach (var phase in selectedSemester.Phases.OrderBy(p => p.PhaseNumber))
                {
                    bool isCurrent = activePhase?.PhaseNumber == phase.PhaseNumber;
                    bool isPast = !isCurrent && DateTime.Now > phase.EndDate && !RegistrationPeriodService.SimulatedPhaseOverride.HasValue;
                    bool isFuture = !isCurrent && DateTime.Now < phase.StartDate && !RegistrationPeriodService.SimulatedPhaseOverride.HasValue;

                    <div class="col-12 col-md-4">
                        <div class="phase-card h-100 p-3 rounded-3 border @(isCurrent ? "border-primary bg-primary-subtle-light shadow-sm active-phase" : "border-light-subtle bg-light")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge @(isCurrent ? "bg-primary text-white" : isPast ? "bg-secondary-subtle text-secondary" : "bg-light-subtle text-muted") rounded-pill px-2 py-1">
                                    Giai đoạn @phase.PhaseNumber
                                </span>

                                @if (isCurrent)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small fw-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i> Hiện tại
                                    </span>
                                }
                                else if (isPast)
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                                        <i class="bi bi-clock-history me-1"></i> Đã kết thúc
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                                        <i class="bi bi-hourglass-split me-1"></i> Kế tiếp
                                    </span>
                                }
                            </div>

                            <h6 class="fw-bold mb-1 text-dark">
                                @phase.ShortName
                            </h6>

                            <div class="small text-muted mb-2 d-flex align-items-center gap-1">
                                <i class="bi bi-calendar3 text-primary"></i>
                                <span>@phase.StartDate.ToString("dd/MM/yyyy") &rarr; @phase.EndDate.ToString("dd/MM/yyyy")</span>
                            </div>

                            <p class="small text-secondary mb-0 line-clamp-2" title="@phase.Description">
                                @phase.Description
                            </p>

                            @if (phase.PhaseNumber == 2 && selectedSemester.SemesterCode == "2026_HK1")
                            {
                                <div class="mt-2 pt-2 border-top border-primary-subtle small text-primary fw-semibold d-flex align-items-center gap-1">
                                    <i class="bi bi-stars"></i>
                                    <span>Bao trùm ngày thi 02/11/2026 (Mở ĐK)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Dòng chú thích thời gian thực tế hỗ trợ giảng viên -->
            <div class="alert alert-light border border-info-subtle mt-3 mb-0 py-2 px-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 small">
                    <i class="bi bi-info-circle-fill text-info fs-6"></i>
                    <span>
                        <strong>Ghi chú bảo vệ:</strong> Ngày thi <span class="badge bg-primary text-white">02/11/2026</span> nằm trọn vẹn trong <strong>Giai đoạn 2</strong> (27/10 &rarr; 05/11/2026). Sinh viên có thể tự do đăng ký thêm môn, đổi lớp và kiểm tra hạn mức tín chỉ thời gian thực.
                    </span>
                </div>
                @if (RegistrationPeriodService.SimulatedPhaseOverride.HasValue)
                {
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="ResetSimulation">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Trở về thực tế
                    </button>
                }
            </div>
        }
    </div>
</div>

<style>
    .phase-banner-card {
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }
    .bg-gradient-primary-subtle {
        background: linear-gradient(135deg, #f0f7ff 0%, #e6f0fa 100%);
        border-bottom: 1px solid rgba(13, 110, 253, 0.1);
    }
    .phase-icon-box {
        width: 48px;
        height: 48px;
    }
    .phase-card {
        transition: all 0.2s ease;
    }
    .phase-card.active-phase {
        border-width: 2px !important;
        background-color: #f7fbff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.08);
    }
    .pulse-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #ffffff;
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
        animation: pulsing 1.5s infinite;
    }
    @@keyframes pulsing {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
        }
        70% {
            box-shadow: 0 0 0 6px rgba(255, 255, 255, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
        }
    }
    .semester-select-group {
        min-width: 200px;
    }
    .demo-sim-group {
        min-width: 260px;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    [Parameter]
    public string SelectedSemesterCode { get; set; } = "2026_HK1";

    [Parameter]
    public EventCallback<string> SelectedSemesterCodeChanged { get; set; }

    [Parameter]
    public bool ShowControls { get; set; } = true;

    [Parameter]
    public EventCallback OnPhaseChanged { get; set; }

    private List<SemesterInfo> allSemesters = new();
    private SemesterInfo? selectedSemester;
    private RegistrationPhaseInfo? activePhase;
    private bool isOpen = true;

    protected override void OnInitialized()
    {
        allSemesters = RegistrationPeriodService.GetAllSemesters();
        if (string.IsNullOrEmpty(SelectedSemesterCode))
        {
            SelectedSemesterCode = RegistrationPeriodService.CurrentSemesterCode;
        }
        RefreshPhaseState();
    }

    protected override void OnParametersSet()
    {
        RefreshPhaseState();
    }

    private void RefreshPhaseState()
    {
        selectedSemester = RegistrationPeriodService.GetSemester(SelectedSemesterCode) 
                           ?? RegistrationPeriodService.GetCurrentSemester();
        activePhase = RegistrationPeriodService.GetActivePhase(SelectedSemesterCode);
        isOpen = RegistrationPeriodService.IsRegistrationOpen(SelectedSemesterCode);
    }

    private async Task HandleSemesterChanged(ChangeEventArgs e)
    {
        var newSem = e.Value?.ToString();
        if (!string.IsNullOrEmpty(newSem) && newSem != SelectedSemesterCode)
        {
            SelectedSemesterCode = newSem;
            RegistrationPeriodService.CurrentSemesterCode = newSem;
            RefreshPhaseState();
            await SelectedSemesterCodeChanged.InvokeAsync(SelectedSemesterCode);
            await OnPhaseChanged.InvokeAsync();
        }
    }

    private async Task HandlePhaseOverrideChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            RegistrationPeriodService.SetSimulatedPhase(val == 0 ? null : val);
            RefreshPhaseState();
            await OnPhaseChanged.InvokeAsync();
        }
    }

    private async Task ResetSimulation()
    {
        RegistrationPeriodService.SetSimulatedPhase(null);
        RefreshPhaseState();
        await OnPhaseChanged.InvokeAsync();
    }
}
