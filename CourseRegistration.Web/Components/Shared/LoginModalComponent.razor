        <!-- Nút đóng 'X' góc phải trên -->
        <button type="button" 
                class="btn btn-sm btn-icon position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center text-muted border-0 bg-transparent" 
                style="width: 28px; height: 28px; border-radius: 50%;" 
