@inject IRegistrationCartStateStore CartStateStore
@implements IDisposable

<a href="/cart" class="btn btn-outline-light d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill position-relative text-nowrap shadow-sm text-decoration-none" style="height: 38px;">
    <i class="bi bi-cart3 fs-6"></i>
    <span class="fw-semibold small">Giỏ đăng ký</span>
    @if (itemCount > 0)
    {
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm">
            @itemCount
            <span class="visually-hidden">môn đã chọn</span>
        </span>
    }
</a>

@code {
    private int itemCount = 0;

    protected override async Task OnInitializedAsync()
    {
        CartStateStore.AddStateChangeListeners(HandleStateChange);
        await LoadCount();
    }

    private async void HandleStateChange()
    {
        await LoadCount();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCount()
    {
        itemCount = await CartStateStore.GetItemsCount();
    }

    public void Dispose()
    {
        CartStateStore.RemoveStateChangeListeners(HandleStateChange);
    }
}
