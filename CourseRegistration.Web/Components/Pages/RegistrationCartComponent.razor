@page "/cart"
@namespace CourseRegistration.Web.Components.Pages
@inject IViewRegistrationCartUseCase ViewRegistrationCartUseCase
@inject IRemoveSectionFromCartUseCase RemoveSectionFromCartUseCase
@inject IPlaceEnrollmentUseCase PlaceEnrollmentUseCase
@inject IStudentRepository StudentRepository
@inject NavigationManager NavigationManager

<div class="mb-4">
    <h2 class="fw-bold mb-1">Giỏ Đăng Ký Học Phần</h2>
    <p class="text-muted mb-0">Kiểm tra danh sách lớp học phần trước khi gửi phiếu đăng ký chính thức</p>
</div>

<!-- Lựa chọn tài khoản sinh viên demo (Để test vi phạm luật nghiệp vụ) -->
<div class="card border-0 shadow-sm p-3 mb-4 bg-white">
    <div class="row align-items-center">
        <div class="col-md-7">
            <label class="form-label fw-bold text-dark small mb-1">
                <i class="bi bi-person-circle text-primary me-1"></i> Chọn Sinh viên thực hiện đăng ký (Demo kiểm tra luật):
            </label>
            <select class="form-select" @onchange="OnStudentChanged">
                @foreach (var s in availableStudents)
                {
                    <option value="@s.StudentId" selected="@(s.StudentId == selectedStudentId)">
                        @s.StudentCode - @s.FullName (@s.Major - Hạn mức: @s.MaxCreditsPerSemester TC)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-5 mt-2 mt-md-0">
            <div class="p-2 bg-light rounded small border">
                @if (selectedStudentId == 1)
                {
                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> <strong>SV Tuấn:</strong> Đã đạt TIN101 & TIN102 (Đủ điều kiện đăng ký các môn)</span>
                }
                else
                {
                    <span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>SV Mai:</strong> Mới học TIN101, CHƯA học TIN102 (Sẽ bị chặn khi đăng ký Web/CNPM)</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Reusable Component: Thông báo lỗi thân thiện nếu vi phạm luật nghiệp vụ (K3.3) -->
<ValidationAlertComponent Errors="@validationErrors" OnDismiss="@(() => validationErrors.Clear())" />

@if (cart == null || cart.EnrollmentLines == null || !cart.EnrollmentLines.Any())
{
    <div class="card border-0 shadow-sm text-center py-5 bg-white">
        <i class="bi bi-cart-x fs-1 text-muted mb-3"></i>
        <h5 class="fw-bold text-muted">Giỏ đăng ký hiện đang trống</h5>
        <p class="text-muted small mb-4">Bạn chưa chọn lớp học phần nào để đăng ký.</p>
        <div>
            <a href="/sections" class="btn btn-primary">
                <i class="bi bi-search me-1"></i> Tìm và chọn lớp học phần ngay
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Danh sách lớp trong giỏ -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm bg-white overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Lớp học phần</th>
                                <th>Môn học</th>
                                <th>Tín chỉ</th>
                                <th>Lịch học</th>
                                <th>Sĩ số</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in cart.EnrollmentLines)
                            {
                                var sec = line.Section;
                                <tr>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary fw-bold">@sec?.SectionCode</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@sec?.Course?.CourseName</div>
                                        <div class="small text-muted">GV: @sec?.Instructor</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(sec?.Course?.Credits ?? 0) TC</span>
                                    </td>
                                    <td class="small">
                                        @if (sec?.Schedules != null && sec.Schedules.Any())
                                        {
                                            foreach (var sched in sec.Schedules)
                                            {
                                                <div class="text-nowrap">@sched.DayOfWeekName (Tiết @sched.StartPeriod-@sched.EndPeriod)</div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="small @(sec?.CurrentEnrollment >= sec?.MaxCapacity ? "text-danger fw-bold" : "text-muted")">
                                            @sec?.CurrentEnrollment / @sec?.MaxCapacity
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleRemove(line.SectionId)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a href="/sections" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn lớp học phần
                </a>
            </div>
        </div>

        <!-- Tóm tắt đăng ký & nút xác nhận -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 bg-white">
                <h5 class="fw-bold mb-3">Tóm Tắt Đăng Ký</h5>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tổng số lớp đã chọn:</span>
                    <span class="fw-bold">@cart.EnrollmentLines.Count lớp</span>
                </div>

                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted">Tổng số tín chỉ:</span>
                    <span class="fw-bold fs-5 text-primary">@cart.TotalCredits TC</span>
                </div>

                <div class="mb-3 small text-muted">
                    <i class="bi bi-shield-check text-success me-1"></i> Hệ thống sẽ tự động kiểm tra điều kiện tiên quyết, trùng lịch và sĩ số khi bạn nhấn xác nhận.
                </div>

                <button class="btn btn-success btn-lg w-100 shadow-sm" 
                        disabled="@isSubmitting"
                        @onclick="HandleConfirmEnrollment">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Xác Nhận Đăng Ký</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Enrollment? cart;
    private List<Student> availableStudents = new List<Student>();
    private int selectedStudentId = 1;
    private List<string> validationErrors = new List<string>();
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        availableStudents = (await StudentRepository.GetAllStudentsAsync()).ToList();
        await LoadCart();
    }

    private async Task LoadCart()
    {
        cart = await ViewRegistrationCartUseCase.ExecuteAsync();
    }

    private async Task HandleRemove(int sectionId)
    {
        await RemoveSectionFromCartUseCase.ExecuteAsync(sectionId);
        validationErrors.Clear();
        await LoadCart();
    }

    private void OnStudentChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedStudentId = id;
            validationErrors.Clear();
        }
    }

    private async Task HandleConfirmEnrollment()
    {
        isSubmitting = true;
        validationErrors.Clear();

        var result = await PlaceEnrollmentUseCase.ExecuteAsync(selectedStudentId, "2025_HK1");

        isSubmitting = false;

        if (result.IsSuccess && result.EnrollmentId.HasValue)
        {
            NavigationManager.NavigateTo($"/enrollment/{result.EnrollmentId.Value}");
        }
        else
        {
            validationErrors = result.Errors;
        }
    }
}
