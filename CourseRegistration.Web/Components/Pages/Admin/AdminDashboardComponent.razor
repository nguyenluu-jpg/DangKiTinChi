                                <th>Môn Học</th>
                                <th>Giảng Viên</th>
                                <th class="text-center">Sĩ Số / Chỉ Tiêu</th>
                                <th class="text-center">Tỷ Lệ Lấp Đầy</th>
                                <th class="text-end">Trạng Thái</th>
                            </tr>
                        </thead>
