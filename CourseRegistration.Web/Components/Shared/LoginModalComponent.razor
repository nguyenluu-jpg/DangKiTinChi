@namespace CourseRegistration.Web.Components.Shared
@inject ILoginModalService LoginModalService
@inject ILoginUseCase LoginUseCase
@inject ICurrentUserStateStore CurrentUserStateStore
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (LoginModalService.IsVisible)
{
    <!-- Modal Backdrop Overlay (Cố định: không bị mất modal khi chạm ra bên ngoài) -->
    <div class="login-modal-overlay">
        <div class="login-modal-dialog">
            <!-- Modal Card -->
            <div class="login-modal-content card border-0 shadow-2xl rounded-4 overflow-hidden">
                <!-- Header Gradient -->
                <div class="login-modal-header text-white text-center py-4 px-4 position-relative">
                    <button type="button" 
                            class="btn-close-modal position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center" 
                            @onclick="CloseModal"
                            aria-label="Đóng">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <div class="mb-2">
                        <i class="bi bi-mortarboard-fill fs-1 text-white"></i>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">Đăng Nhập Hệ Thống</h4>
                    <div class="text-white-50 small">Cổng Đăng Ký Học Phần Trực Tuyến</div>
                </div>

                <!-- Body: Form Đăng Nhập -->
                <div class="card-body p-4 p-md-4 bg-white">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center rounded-3 mb-3 py-2 px-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                            <div class="small fw-semibold">
                                @errorMessage
                            </div>
                        </div>
                    }

                    <form method="post" action="" @onsubmit="HandleLogin" @onsubmit:preventDefault="true" autocomplete="on">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small mb-1" for="username">Tài khoản / MSSV <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" 
                                       class="form-control border-start-0 ps-0 bg-light" 
                                       placeholder="Nhập mã sinh viên hoặc tên đăng nhập" 
                                       id="username"
                                       name="username"
                                       autocomplete="username"
                                       autocorrect="off"
                                       autocapitalize="off"
                                       spellcheck="false"
                                       @bind="loginModel.Username" 
                                       @bind:event="oninput" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small mb-1" for="password">Mã truy cập (Mật khẩu) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-shield-lock"></i>
                                </span>
                                <input type="@(showPassword ? "text" : "password")" 
                                       class="form-control border-start-0 border-end-0 ps-0 bg-light" 
                                       placeholder="Nhập mã truy cập của bạn" 
                                       id="password"
                                       name="password"
                                       autocomplete="current-password"
                                       autocorrect="off"
                                       autocapitalize="off"
                                       spellcheck="false"
                                       @bind="loginModel.Password" 
                                       @bind:event="oninput" />
                                <button type="button" 
                                        class="input-group-text bg-light border-start-0 text-muted cursor-pointer" 
                                        @onclick="() => showPassword = !showPassword"
                                        title="@(showPassword ? "Ẩn mã truy cập" : "Hiện mã truy cập")">
                                    <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Nút Đăng Nhập -->
                        <button type="submit" 
                                class="btn btn-primary w-100 py-2.5 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3"
                                disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Đang xác thực...</span>
                            }
                            else
                            {
                                <i class="bi bi-box-arrow-in-right fs-5"></i>
                                <span>Đăng Nhập</span>
                            }
                        </button>
                    </form>

                    <div class="mt-3 pt-3 border-top text-center text-secondary small" style="font-size: 0.78rem;">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Hệ thống xác thực tài khoản sinh viên &amp; cán bộ quản trị.
                        <div class="mt-1 text-muted" style="font-size: 0.74rem;">
                            Quên mật khẩu hoặc cần cấp lại tài khoản? Vui lòng liên hệ <span class="fw-semibold text-dark">Phòng Đào Tạo</span>.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showBreachWarningModal)
{
    <!-- MODAL THAY ĐỔI MẬT KHẨU TỰ ĐỘNG HIỆN LÊN MÁY (CHUẨN THEO ẢNH SCREENSHOT 151815) -->
    <div class="chrome-breach-backdrop" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 10500; background-color: rgba(0, 0, 0, 0.45); display: flex; align-items: center; justify-content: center; padding: 1.25rem;">
        <div class="chrome-breach-card" style="width: 100%; max-width: 440px; background: #ffffff; border-radius: 24px; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35); padding: 26px 28px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; animation: modalPopIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);">
            
            <!-- Graphic Illustration chuẩn y hệt ảnh Screenshot 151815 -->
            <div class="text-center mb-3">
                <svg width="220" height="92" viewBox="0 0 220 92" fill="none" xmlns="http://www.w3.org/2000/svg" style="max-width: 100%; height: auto;">
                    <!-- Sparkles/stars -->
                    <path d="M28 36c0 2.2-1.8 4-4 4s-4-1.8-4-4 1.8-4 4-4 4 1.8 4 4z" fill="#E8EAED"/>
                    <path d="M192 34c0 2.5-2 4.5-4.5 4.5s-4.5-2-4.5-4.5 2-4.5 4.5-4.5 4.5 2 4.5 4.5z" fill="#E8EAED"/>
                    <circle cx="20" cy="46" r="3" fill="#E8EAED"/>
                    
                    <!-- Curved connecting cable -->
                    <path d="M106 42 C122 42, 126 18, 142 18 C158 18, 162 42, 172 42" stroke="#DADCE0" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                    <path d="M88 40 C70 40, 68 56, 50 56" stroke="#DADCE0" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                    
                    <!-- Clipboard document -->
                    <rect x="76" y="8" width="56" height="72" rx="7" fill="#FFFFFF" stroke="#DADCE0" stroke-width="1.6"/>
                    <path d="M95 5h18a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H95a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" fill="#DADCE0"/>
                    <rect x="98" y="7" width="12" height="3" rx="1" fill="#FFFFFF"/>
                    
                    <!-- Red warning shield badge -->
                    <g transform="translate(85, 27)">
                        <path d="M19 1.5 L36 30.5 A2 2 0 0 1 34.3 33.5 L3.7 33.5 A2 2 0 0 1 2 30.5 L19 1.5 Z" fill="#EA4335"/>
                        <rect x="17" y="11" width="4" height="12" rx="2" fill="#FFFFFF"/>
                        <circle cx="19" cy="27.5" r="2.2" fill="#FFFFFF"/>
                    </g>
                    
                    <!-- Password input box -->
                    <g transform="translate(118, 29)">
                        <rect x="0" y="0" width="62" height="26" rx="4" fill="#FFFFFF" stroke="#DADCE0" stroke-width="1.5"/>
                        <text x="8" y="18" font-family="'Segoe UI', Roboto, sans-serif" font-weight="900" font-size="16" fill="#1A73E8" letter-spacing="2">* * *</text>
                        <line x1="50" y1="5" x2="50" y2="21" stroke="#1A73E8" stroke-width="2"/>
                    </g>
                </svg>
            </div>

            <!-- Title -->
            <h5 class="fw-bold mb-2 text-start" style="color: #1f1f1f; font-size: 1.18rem; letter-spacing: -0.2px;">
                Thay đổi mật khẩu của bạn
            </h5>

            <!-- Description -->
            <div class="text-start mb-4" style="color: #444746; font-size: 0.85rem; line-height: 1.48;">
                Mật khẩu bạn vừa sử dụng đã bị lộ trong một sự cố rò rỉ dữ liệu. Trình quản lý mật khẩu của Google khuyên bạn nên đổi mật khẩu ngay.
            </div>

            <!-- Bottom Row: Info Icon & OK Button -->
            <div class="d-flex justify-content-between align-items-center pt-1">
                <span class="text-secondary" style="cursor: pointer;" title="Trình quản lý mật khẩu">
                    <i class="bi bi-info-circle fs-5" style="color: #5f6368;"></i>
                </span>
                <button type="button" 
                        class="btn btn-primary rounded-pill px-4 py-1.5 fw-bold shadow-none" 
                        style="background-color: #0b57d0; border-color: #0b57d0; font-size: 0.9rem; min-width: 86px;"
                        @onclick="ConfirmBreachWarningAndProceed"
                        autofocus>
                    OK
                </button>
            </div>

        </div>
    </div>
}

@code {
    private LoginViewModel loginModel = new LoginViewModel();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;
    private bool showBreachWarningModal = false;
    private string savedUsername = string.Empty;
    private string savedPassword = string.Empty;

    protected override void OnInitialized()
    {
        LoginModalService.OnChange += HandleModalStateChange;
    }

    private void HandleModalStateChange()
    {
        if (LoginModalService.IsVisible)
        {
            errorMessage = string.Empty;
            loginModel = new LoginViewModel();
            showPassword = false;
            showBreachWarningModal = false;
        }
        InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        showBreachWarningModal = false;
        LoginModalService.Close();
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var username = loginModel.Username.Trim();
            var password = loginModel.Password;

            var account = await LoginUseCase.ExecuteAsync(username, password);
            if (account != null)
            {
                // 1. Cập nhật phiên đăng nhập của người dùng
                await CurrentUserStateStore.SetCurrentUserAsync(account);

                // 2. Đóng form đăng nhập
                LoginModalService.Close();

                // 3. Giữ nguyên trang đang đứng (ở Trang chủ thì ở lại Trang chủ, KHÔNG nhảy sang Tổng quan!)
                var uri = new Uri(NavigationManager.Uri);
                if (uri.AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo("/");
                }
                else
                {
                    NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: false);
                }

                savedUsername = username;
                savedPassword = password;

                // 4. Xử lý thông báo theo đúng yêu cầu:
                if (string.Equals(account.Role, "Admin", StringComparison.OrdinalIgnoreCase))
                {
                    // Bên Admin: Bỏ bớt thông báo "Thay đổi mật khẩu của bạn" (tránh bị thừa thông báo),
                    // kích hoạt trực tiếp hộp thoại Lưu mật khẩu gốc của Chrome (Screenshot 162716) 1 lần duy nhất.
                    showBreachWarningModal = false;
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("triggerBrowserSavePassword", username, password);
                    }
                    catch { }
                }
                else
                {
                    // Bên Sinh viên: Tự động hiển thị cảnh báo mật khẩu rò rỉ (Screenshot 151815) trước,
                    // sau khi bấm OK sẽ chuyển tiếp đến hộp thoại Lưu mật khẩu của Chrome (Screenshot 162716).
                    showBreachWarningModal = true;
                }
            }
            else
            {
                errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác. Vui lòng thử lại!";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Có lỗi xảy ra trong quá trình đăng nhập: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmBreachWarningAndProceed()
    {
        showBreachWarningModal = false;

        // Bấm OK -> Lập tức kích hoạt hộp thoại Lưu mật khẩu của Chrome (Screenshot 162716) đúng 1 lần duy nhất
        try
        {
            await JSRuntime.InvokeVoidAsync("triggerBrowserSavePassword", savedUsername, savedPassword);
        }
        catch { }
    }

    public void Dispose()
    {
        LoginModalService.OnChange -= HandleModalStateChange;
    }

    public class LoginViewModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
