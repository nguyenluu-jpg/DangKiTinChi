@namespace CourseRegistration.Web.Components.Layout
@inject ICurrentUserStateStore CurrentUserStateStore
@inject IStudentRepository StudentRepository
@inject IRegistrationCartStateStore CartStateStore
@inject ILoginModalService LoginModalService
@inject IChangePasswordModalService ChangePasswordModalService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<!-- Dropdown Backdrop Overlay (Tự động đóng tất cả dropdown khi bấm ra ngoài bất kỳ đâu) -->
@if (isAdminDropdownOpen || isUserDropdownOpen || isLookupDropdownOpen || isMobileNavExpanded)
{
    <div class="dropdown-backdrop-overlay" @onclick="CloseAllDropdowns"></div>
}

<!-- Top Desktop & Tablet Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark custom-navbar sticky-top py-2 shadow-sm">
    <div class="container position-relative">
        <!-- Khối bên trái: Nút 3 thanh (mobile) + Logo Đăng Ký Học Phần -->
        <div class="d-flex align-items-center gap-2 me-lg-4 me-xl-5">
            <button class="navbar-toggler border-0 p-1 d-lg-none flex-shrink-0" 
                    type="button" 
                    @onclick="() => isMobileNavExpanded = !isMobileNavExpanded"
                    aria-label="Menu điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>

            <a class="navbar-brand fw-bold d-flex align-items-center text-white m-0" href="@(currentRole == "Admin" ? "/admin" : "/")">
                <div class="brand-logo-icon me-2 flex-shrink-0">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div class="d-flex flex-column">
                    <span class="lh-1 fw-bold brand-header-title">Đăng Ký Học Phần</span>
                    <span class="brand-subtext d-none d-sm-block">@(currentRole == "Admin" ? "Phòng Đào Tạo & Quản Lý Học Vụ" : "Cổng Đào Tạo Trực Tuyến")</span>
                </div>
            </a>
        </div>

        <!-- Khối bên phải trên di động: Hiển thị các nút tương ứng trạng thái trên mobile -->
        @if (currentRole == "Admin")
        {
            <div class="d-flex align-items-center d-lg-none ms-auto">
                <button type="button" 
                        class="btn btn-dark user-profile-btn d-inline-flex align-items-center gap-1.5 px-2.5 py-1 rounded-pill border border-danger border-opacity-50 shadow-xs"
                        style="height: 34px;"
                        @onclick="ToggleAdminMobileActions">
                    <span class="user-avatar bg-danger text-white" style="width: 22px; height: 22px; font-size: 0.72rem; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </span>
                    <span class="fw-semibold text-white" style="font-size: 0.8rem;">Admin</span>
                    <i class="bi @(isAdminMobileActionsOpen ? "bi-chevron-up" : "bi-chevron-down") text-muted" style="font-size: 0.7rem;"></i>
                </button>
            </div>
        }
        else if (!isAuthenticated)
        {
            <!-- Khi mới F5 / chưa đăng nhập: Giỏ hàng trước Đăng nhập trên header mobile -->
            <div class="d-flex align-items-center gap-1.5 d-lg-none ms-auto">
                <CartBadgeComponent />
                <button type="button" 
                        class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-2.5 py-1 rounded-pill shadow-xs"
                        style="height: 34px; font-size: 0.8rem;"
                        @onclick="OpenLoginModal">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span class="fw-semibold">Đăng nhập</span>
                </button>
            </div>
        }
        else
        {
            <div class="d-flex align-items-center d-lg-none ms-auto">
                <CartBadgeComponent />
            </div>
        }

        <!-- Menu Desktop ở trên cùng hàng ngang với Logo & Accordion trên di động -->
        <div class="collapse navbar-collapse @(isMobileNavExpanded ? "show" : "")" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center ms-lg-3 gap-lg-1">
                @if (currentRole == "Admin")
                {
                    <!-- 1. Tổng quan: Điều hướng đến Tổng quan Cán bộ Đào tạo -->
                    <li class="nav-item">
                        <NavLink class="@(IsAdminHomeActive ? "nav-link active" : "nav-link")" href="/admin" Match="NavLinkMatch.All" @onclick="CloseAllDropdowns">
                            <i class="bi bi-speedometer2 me-1"></i> Tổng quan
                        </NavLink>
                    </li>

                    <!-- 2. Quản lý đào tạo: Dropdown chứa các chức năng -->
                    <li class="nav-item dropdown position-relative">
                        <button class="nav-link dropdown-toggle d-flex align-items-center bg-transparent border-0 @(IsAdminTrainingActive ? "active text-white" : "")" 
                                type="button" 
                                @onclick="ToggleAdminDropdown">
                            <i class="bi bi-mortarboard me-1"></i> Quản lý đào tạo
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark shadow border-0 rounded-3 p-2 @(isAdminDropdownOpen ? "show" : "")" style="min-width: 290px;">
                            <!-- Quản lý Môn học -->
                            <li>
                                <a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2.5 text-white" href="/admin/courses" @onclick="CloseAllDropdowns">
                                    <div class="bg-primary bg-opacity-25 text-primary p-2 rounded-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                        <i class="bi bi-book"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Quản lý Môn học</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">Danh mục môn, số tín chỉ &amp; tiên quyết</div>
                                    </div>
                                </a>
                            </li>

                            <!-- Mở & Quản lý Lớp HP -->
                            <li>
                                <a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2.5 text-white" href="/admin/sections" @onclick="CloseAllDropdowns">
                                    <div class="bg-info bg-opacity-25 text-info p-2 rounded-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                        <i class="bi bi-collection"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Mở &amp; Quản lý Lớp HP</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">Mở lớp học phần, lịch học &amp; sĩ số</div>
                                    </div>
                                </a>
                            </li>

                            <!-- Quản lý Đăng ký & Rút môn -->
                            <li>
                                <a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2.5 text-white" href="/admin/enrollments" @onclick="CloseAllDropdowns">
                                    <div class="bg-success bg-opacity-25 text-success p-2 rounded-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                        <i class="bi bi-people"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Quản lý Đăng ký &amp; Rút môn</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">Duyệt đơn rút môn &amp; danh sách SV theo lớp</div>
                                    </div>
                                </a>
                            </li>

                            <!-- Trợ lý AI Phòng Đào tạo -->
                            <li>
                                <a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2.5 text-white" href="/ai-advisor" @onclick="CloseAllDropdowns">
                                    <div class="bg-warning bg-opacity-25 text-warning p-2 rounded-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                        <i class="bi bi-stars"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Trợ lý AI Phòng Đào tạo</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">Cố vấn đào tạo thông minh &amp; phân tích</div>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- 3. Thời khóa biểu: Giữ nguyên vị trí trên Navbar -->
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/schedule" @onclick="CloseAllDropdowns">
                            <i class="bi bi-calendar3 me-1"></i> Thời khóa biểu
                        </NavLink>
                    </li>

                    <!-- 4. Quản lý học phí: Thay thế mục Thanh toán học phí hiện tại -->
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/admin/tuition" @onclick="CloseAllDropdowns">
                            <i class="bi bi-wallet2 text-warning me-1"></i> Quản lý học phí
                        </NavLink>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" @onclick="CloseAllDropdowns">
                            <i class="bi bi-house-door me-1"></i> Trang chủ
                        </NavLink>
                    </li>
                    <!-- Nhóm Kế hoạch & Tra cứu: Kế hoạch đầu, Tra cứu sau -->
                    <li class="nav-item dropdown position-relative">
                        <button class="nav-link dropdown-toggle d-flex align-items-center bg-transparent border-0 @(IsLookupActive ? "active text-white" : "")" 
                                type="button" 
                                @onclick="ToggleLookupDropdown">
                            <i class="bi bi-calendar3-range me-1"></i> Kế hoạch & Tra cứu
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark shadow border-0 rounded-3 p-2 @(isLookupDropdownOpen ? "show" : "")" style="min-width: 270px;">
                            <li>
                                <a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2.5 text-white" href="/sections?tab=plan" @onclick="CloseAllDropdowns">
                                    <div class="bg-info bg-opacity-25 text-info p-2 rounded-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                        <i class="bi bi-calendar3-range"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Kế hoạch đăng ký</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">Tiến độ 3 giai đoạn & mở cổng</div>
                                    </div>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider border-secondary opacity-50 my-1"></li>
                            <li>
                                <a class="dropdown-item rounded-2 py-2 d-flex align-items-center gap-2.5 text-white" href="/sections?tab=search" @onclick="CloseAllDropdowns">
                                    <div class="bg-primary bg-opacity-25 text-primary p-2 rounded-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                        <i class="bi bi-search"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Tra cứu học phần</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">Tìm môn học & chọn lớp vào giỏ</div>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/schedule" @onclick="CloseAllDropdowns">
                            <i class="bi bi-calendar3 me-1"></i> Thời khóa biểu
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/tuition" @onclick="CloseAllDropdowns">
                            <i class="bi bi-wallet2 text-warning me-1"></i> Thanh toán học phí
                        </NavLink>
                    </li>
                }
            </ul>

            <div class="d-flex align-items-center flex-nowrap gap-2 pt-2 pt-lg-0 border-top border-secondary border-opacity-25 border-top-lg-0 ms-auto">
                <!-- Desktop Cart Badge (Chỉ hiển thị cho Sinh viên) - Đứng trước Đăng nhập / Tài khoản -->
                @if (currentRole != "Admin")
                {
                    <div class="d-none d-lg-block">
                        <CartBadgeComponent />
                    </div>
                }

                <!-- User Switcher & Auth Controls -->
                @if (!isAuthenticated)
                {
                    <button type="button" 
                            class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill shadow-sm"
                            style="height: 38px;"
                            @onclick="OpenLoginModal">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span class="fw-semibold small">Đăng nhập</span>
                    </button>
                }
                else
                {
                    <div class="dropdown position-relative">
                        <button class="btn btn-dark user-profile-btn dropdown-toggle d-inline-flex align-items-center gap-2 border border-secondary border-opacity-50 py-1" 
                                style="height: 38px;"
                                type="button" 
                                @onclick="ToggleUserDropdown">
                            @if (currentRole == "Admin")
                            {
                                <div class="user-avatar bg-danger text-white">
                                    <i class="bi bi-shield-lock-fill"></i>
                                </div>
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-bold small lh-1 text-white">@(currentUser?.FullName ?? "Cán bộ Đào tạo")</div>
                                    <span class="badge bg-danger text-white px-1 py-0" style="font-size: 0.68rem;">Cán bộ Quản trị</span>
                                </div>
                            }
                            else if (currentStudent != null || currentUser != null)
                            {
                                var displayName = currentStudent?.FullName ?? currentUser?.FullName ?? "Sinh viên";
                                var displayCode = currentStudent?.StudentCode ?? currentUser?.Username ?? "SV";
                                <div class="user-avatar @(currentStudent?.StudentCode == "SV21002" ? "bg-warning text-dark" : "bg-primary")">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-bold small lh-1 text-white">@displayName</div>
                                    <span class="badge @(currentStudent?.StudentCode == "SV21002" ? "bg-warning-subtle text-warning" : "bg-primary-subtle text-primary") px-1 py-0" style="font-size: 0.68rem;">
                                        @displayCode &bull; @(currentStudent?.MaxCreditsPerSemester ?? 24) TC
                                    </span>
                                </div>
                            }
                        </button>
                        
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2 @(isUserDropdownOpen ? "show" : "")" style="min-width: @(currentRole == "Admin" ? "270px" : "320px"); max-width: 380px;">
                            <!-- Header thông tin tài khoản -->
                            <li class="px-1 py-1 mb-2">
                                <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3 border">
                                    <div class="user-avatar @(currentRole == "Admin" ? "bg-danger text-white" : "bg-primary text-white")">
                                        <i class="bi @(currentRole == "Admin" ? "bi-shield-lock-fill" : "bi-person-fill")"></i>
                                    </div>
                                    <div class="text-truncate">
                                        <div class="fw-bold small text-dark text-truncate">@(currentUser?.FullName ?? currentStudent?.FullName ?? "Cán bộ Quản lý")</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">
                                            @(currentRole == "Admin" ? "Cán bộ Quản trị & Điều hành Đào tạo" : $"MSSV: {currentStudent?.StudentCode ?? currentUser?.Username}")
                                        </div>
                                    </div>
                                </div>
                            </li>

                            @if (currentRole == "Admin")
                            {
                                <!-- Mobile: Nút trực tiếp bên ngoài menu xổ xuống trong hamburger menu -->
                                <li class="px-2 py-1 d-lg-none">
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-warning btn-sm flex-fill d-flex align-items-center justify-content-center gap-1.5 py-1.5 fw-bold text-dark rounded-3" @onclick="OpenChangePasswordModal">
                                            <i class="bi bi-key-fill"></i>
                                            <span>Đổi mật khẩu</span>
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm flex-fill d-flex align-items-center justify-content-center gap-1.5 py-1.5 fw-bold text-white rounded-3" @onclick="HandleLogout">
                                            <i class="bi bi-box-arrow-right"></i>
                                            <span>Đăng xuất</span>
                                        </button>
                                    </div>
                                </li>
                            }
                            else
                            {
                                <li class="px-3 py-1 mb-2 small text-muted">
                                    <div>Ngành: <strong class="text-dark">@(currentStudent?.Major ?? "Công nghệ thông tin")</strong></div>
                                    <div class="text-primary fw-semibold mt-1">
                                        Hạn mức kỳ này: @(currentStudent?.MaxCreditsPerSemester ?? 24) Tín chỉ
                                    </div>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/cart" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-cart3 text-success me-2"></i>
                                        <span class="small fw-semibold">Giỏ đăng ký của tôi</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/schedule" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-calendar3 text-info me-2"></i>
                                        <span class="small fw-semibold">Thời khóa biểu của tôi</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark" href="/tuition" @onclick="CloseAllDropdowns">
                                        <i class="bi bi-wallet2 text-warning me-2"></i>
                                        <span class="small fw-semibold">Thanh toán học phí</span>
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider my-2"></li>
                            <li>
                                <button type="button" class="dropdown-item rounded-2 py-2 d-flex align-items-center text-dark fw-semibold" @onclick="OpenChangePasswordModal">
                                    <i class="bi bi-key-fill text-warning me-2 fs-6"></i>
                                    <span>Đổi mật khẩu</span>
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item rounded-2 py-2 d-flex align-items-center text-danger fw-semibold" @onclick="HandleLogout">
                                    <i class="bi bi-box-arrow-right me-2 fs-6"></i>
                                    <span>Đăng xuất</span>
                                </button>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</nav>

<!-- Bảng thao tác trực tiếp tài khoản Admin trên Mobile (Hiển thị trực tiếp Đổi mật khẩu & Đăng xuất bên ngoài menu xổ xuống) -->
@if (isAdminMobileActionsOpen && currentRole == "Admin")
{
    <div class="admin-mobile-direct-container d-lg-none">
        <div class="admin-mobile-backdrop" @onclick="CloseAdminMobileActions"></div>
        <div class="admin-mobile-action-card shadow-lg animate-fade-in">
            <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar bg-danger text-white shadow-xs" style="width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-shield-lock-fill fs-6"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white small lh-1">@(currentUser?.FullName ?? "Cán bộ Đào tạo")</div>
                        <span class="text-white-50" style="font-size: 0.72rem;">Cán bộ Quản trị &bull; Cổng Đào tạo</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white small p-1" @onclick="CloseAdminMobileActions" aria-label="Đóng"></button>
            </div>
            
            <div class="d-flex gap-2">
                <button type="button" 
                        class="btn btn-warning flex-fill d-flex align-items-center justify-content-center gap-1.5 py-2 rounded-3 fw-bold text-dark shadow-xs"
                        style="font-size: 0.85rem;"
                        @onclick="() => { CloseAdminMobileActions(); OpenChangePasswordModal(); }">
                    <i class="bi bi-key-fill fs-6"></i>
                    <span>Đổi mật khẩu</span>
                </button>
                <button type="button" 
                        class="btn btn-danger flex-fill d-flex align-items-center justify-content-center gap-1.5 py-2 rounded-3 fw-bold text-white shadow-xs"
                        style="font-size: 0.85rem;"
                        @onclick="async () => { CloseAdminMobileActions(); await HandleLogout(); }">
                    <i class="bi bi-box-arrow-right fs-6"></i>
                    <span>Đăng xuất</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Mobile Native-Style Bottom Navigation Bar (Dành riêng cho Điện thoại < 768px) -->
<div class="mobile-bottom-nav d-lg-none">
    <div class="mobile-nav-container">
        @if (currentRole == "Admin")
        {
            <NavLink class="@(IsAdminHomeActive ? "mobile-nav-item active" : "mobile-nav-item")" href="/admin" Match="NavLinkMatch.All" @onclick="CloseAdminMobileActions">
                <i class="bi bi-speedometer2"></i>
                <span>Tổng quan</span>
            </NavLink>
            <NavLink class="@(IsAdminTrainingActive ? "mobile-nav-item active" : "mobile-nav-item")" href="/admin/courses" @onclick="CloseAdminMobileActions">
                <i class="bi bi-mortarboard"></i>
                <span>Đào tạo</span>
            </NavLink>
            <NavLink class="mobile-nav-item" href="/schedule" @onclick="CloseAdminMobileActions">
                <i class="bi bi-calendar3"></i>
                <span>Lịch học</span>
            </NavLink>
            <NavLink class="mobile-nav-item" href="/admin/tuition" @onclick="CloseAdminMobileActions">
                <i class="bi bi-wallet2"></i>
                <span>Học phí</span>
            </NavLink>
            <button type="button" 
                    class="mobile-nav-item bg-transparent border-0 @(isAdminMobileActionsOpen ? "active text-danger" : "")" 
                    @onclick="ToggleAdminMobileActions">
                <i class="bi bi-shield-lock-fill"></i>
                <span>Tài khoản</span>
            </button>
        }
        else
        {
            <NavLink class="mobile-nav-item" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-house-door"></i>
                <span>Trang chủ</span>
            </NavLink>
            <NavLink class="mobile-nav-item" href="/sections">
                <i class="bi bi-search"></i>
                <span>Tra cứu</span>
            </NavLink>
            <!-- Vị trí 3: Giỏ môn (đứng trước Đăng nhập) -->
            <NavLink class="mobile-nav-item position-relative" href="/cart">
                <div class="cart-icon-wrapper">
                    <i class="bi bi-cart3"></i>
                    @if (cartCount > 0)
                    {
                        <span class="mobile-cart-badge">@cartCount</span>
                    }
                </div>
                <span>Giỏ môn</span>
            </NavLink>
            <NavLink class="mobile-nav-item" href="/schedule">
                <i class="bi bi-calendar3"></i>
                <span>Lịch học</span>
            </NavLink>
            <!-- Vị trí 5: Đăng nhập / Học phí (đứng sau Giỏ môn) -->
            @if (!isAuthenticated)
            {
                <button type="button" class="mobile-nav-item bg-transparent border-0" @onclick="OpenLoginModal">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Đăng nhập</span>
                </button>
            }
            else
            {
                <NavLink class="mobile-nav-item" href="/tuition">
                    <i class="bi bi-wallet2"></i>
                    <span>Học phí</span>
                </NavLink>
            }
        }
    </div>
</div>

@code {
    private List<Student> availableStudents = new List<Student>();
    private Student? currentStudent;
    private UserAccount? currentUser;
    private string currentRole = string.Empty;
    private bool isAuthenticated = false;
    private int cartCount = 0;

    private bool isLookupDropdownOpen = false;
    private bool isAdminDropdownOpen = false;
    private bool isUserDropdownOpen = false;
    private bool isMobileNavExpanded = false;

    private bool IsLookupActive =>
        NavigationManager.Uri.Contains("/sections", StringComparison.OrdinalIgnoreCase) ||
        NavigationManager.Uri.Contains("/registration-plan", StringComparison.OrdinalIgnoreCase);

    private bool IsAdminTrainingActive =>
        NavigationManager.Uri.Contains("/admin/courses", StringComparison.OrdinalIgnoreCase) ||
        NavigationManager.Uri.Contains("/admin/sections", StringComparison.OrdinalIgnoreCase) ||
        NavigationManager.Uri.Contains("/admin/enrollments", StringComparison.OrdinalIgnoreCase) ||
        NavigationManager.Uri.Contains("/ai-advisor", StringComparison.OrdinalIgnoreCase);

    private bool IsAdminHomeActive
    {
        get
        {
            var uri = NavigationManager.Uri;
            return uri.EndsWith("/admin", StringComparison.OrdinalIgnoreCase) ||
                   uri.EndsWith("/admin/", StringComparison.OrdinalIgnoreCase) ||
                   uri.Contains("/admin/dashboard", StringComparison.OrdinalIgnoreCase) ||
                   uri.Contains("/phong-dao-tao", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        CurrentUserStateStore.AddStateChangeListeners(HandleUserStateChange);
        CartStateStore.AddStateChangeListeners(HandleCartStateChange);

        availableStudents = (await StudentRepository.GetAllStudentsAsync()).ToList();
        await RefreshUserState();
        await RefreshCartCount();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private async void HandleUserStateChange()
    {
        await RefreshUserState();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleCartStateChange()
    {
        await RefreshCartCount();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshUserState()
    {
        isAuthenticated = await CurrentUserStateStore.IsAuthenticatedAsync();
        currentUser = await CurrentUserStateStore.GetCurrentUserAsync();
        int studentId = await CurrentUserStateStore.GetCurrentStudentIdAsync();
        currentRole = await CurrentUserStateStore.GetCurrentRoleAsync();
        currentStudent = availableStudents.FirstOrDefault(s => s.StudentId == studentId);
    }

    private async Task RefreshCartCount()
    {
        cartCount = await CartStateStore.GetItemsCount();
    }

    private void ToggleLookupDropdown()
    {
        isAdminDropdownOpen = false;
        isUserDropdownOpen = false;
        isLookupDropdownOpen = !isLookupDropdownOpen;
    }

    private void ToggleAdminDropdown()
    {
        isLookupDropdownOpen = false;
        isUserDropdownOpen = false;
        isAdminDropdownOpen = !isAdminDropdownOpen;
    }

    private void ToggleUserDropdown()
    {
        isLookupDropdownOpen = false;
        isAdminDropdownOpen = false;
        isUserDropdownOpen = !isUserDropdownOpen;
    }


    private async Task HandleLogout()
    {
        CloseAllDropdowns();
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "courseReg_username");
        }
        catch { }
        await CurrentUserStateStore.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    private bool isAdminMobileActionsOpen = false;

    private void ToggleAdminMobileActions()
    {
        CloseAllDropdowns();
        isAdminMobileActionsOpen = !isAdminMobileActionsOpen;
    }

    private void CloseAdminMobileActions()
    {
        isAdminMobileActionsOpen = false;
    }

    private void CloseAllDropdowns()
    {
        isLookupDropdownOpen = false;
        isAdminDropdownOpen = false;
        isUserDropdownOpen = false;
        isMobileNavExpanded = false;
        isAdminMobileActionsOpen = false;
    }

    private void OpenLoginModal()
    {
        CloseAllDropdowns();
        LoginModalService.Open();
    }

    private void OpenChangePasswordModal()
    {
        CloseAllDropdowns();
        ChangePasswordModalService.Open();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        CurrentUserStateStore.RemoveStateChangeListeners(HandleUserStateChange);
        CartStateStore.RemoveStateChangeListeners(HandleCartStateChange);
    }
}
