@page "/enrollment/{enrollmentId:int}"
@namespace CourseRegistration.Web.Components.Pages
@using CourseRegistration.UseCases.StudentPortal.Payment
@inject IViewEnrollmentUseCase ViewEnrollmentUseCase
@inject NavigationManager NavigationManager

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Đang tải phiếu đăng ký...</p>
            </div>
        }
        else if (enrollment == null)
        {
            <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-4">
                <i class="bi bi-exclamation-circle fs-1 text-danger mb-3"></i>
                <h5 class="fw-bold">Không tìm thấy phiếu đăng ký #@EnrollmentId</h5>
                <p class="text-muted small">Phiếu đăng ký không tồn tại hoặc đã bị hủy.</p>
                <div class="mt-3">
                    <a href="/" class="btn btn-primary">Quay về trang chủ</a>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow rounded-4 overflow-hidden bg-white">
                <!-- Header Receipt Banner -->
                <div class="card-header bg-success text-white py-4 px-4 text-center position-relative">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white bg-opacity-25 rounded-circle p-3 mb-2">
                        <i class="bi bi-check-circle-fill display-5 text-white"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Đăng Ký Học Phần Thành Công!</h3>
                    <p class="mb-0 opacity-75 small">
                        Phiếu đăng ký chính thức &bull; Mã giao dịch: <strong class="text-white">@enrollment.UniqueId</strong>
                    </p>
                </div>

                <div class="card-body p-4">
                    <!-- Thông tin sinh viên & đợt đăng ký -->
                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="text-muted small text-uppercase fw-bold" style="font-size: 0.72rem;">Sinh viên đăng ký</div>
                                <div class="fw-bold fs-5 text-dark">@enrollment.Student?.FullName</div>
                                <div class="text-muted small mt-1">
                                    <span>MSSV: <strong class="text-dark">@enrollment.Student?.StudentCode</strong></span>
                                    <span class="mx-1">&bull;</span>
                                    <span>Ngành: <strong class="text-dark">@enrollment.Student?.Major</strong></span>
                                </div>
                            </div>
                            <div class="col-sm-6 text-sm-end">
                                <div class="text-muted small text-uppercase fw-bold" style="font-size: 0.72rem;">Thông tin giao dịch</div>
                                <div class="fw-bold text-dark">Phiếu #@enrollment.EnrollmentId</div>
                                <div class="text-muted small mt-1">
                                    <span>Thời gian: @(enrollment.DateRegistered?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</span>
                                    <span class="d-block">Học kỳ: <strong>@enrollment.Semester</strong></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 text-dark">
                        <i class="bi bi-card-checklist text-primary me-2"></i>Chi Tiết Danh Sách Lớp Đã Xác Nhận
                    </h5>

                    <!-- Desktop View (Table) -->
                    <div class="table-responsive mb-4 d-none d-md-block">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">STT</th>
                                    <th>Mã Lớp HP</th>
                                    <th>Tên Học Phần</th>
                                    <th>Tín Chỉ</th>
                                    <th>Giảng Viên</th>
                                    <th>Lịch Học & Phòng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int index = 1; }
                                @foreach (var line in enrollment.EnrollmentLines)
                                {
                                    var sec = line.Section;
                                    <tr>
                                        <td class="text-muted fw-bold">@(index++)</td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary fw-bold fs-6">
                                                @sec?.SectionCode
                                            </span>
                                        </td>
                                        <td class="fw-semibold text-dark">@sec?.Course?.CourseName</td>
                                        <td><span class="badge bg-secondary fs-6">@(sec?.Course?.Credits ?? 0) TC</span></td>
                                        <td>@sec?.Instructor</td>
                                        <td class="small">
                                            @if (sec?.Schedules != null && sec.Schedules.Any())
                                            {
                                                foreach (var sched in sec.Schedules)
                                                {
                                                    <div class="text-secondary">
                                                        @sched.DayOfWeekName (Tiết @sched.StartPeriod-@sched.EndPeriod) - @(string.IsNullOrEmpty(sched.Room) ? sec.Room : sched.Room)
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">@(string.IsNullOrEmpty(sec?.Room) ? "Chưa xếp" : sec.Room)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-group-divider">
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Tổng số tín chỉ xác nhận:</td>
                                    <td colspan="3" class="text-success fs-5">@enrollment.TotalCredits Tín chỉ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Mobile View (Cards) -->
                    <div class="d-md-none mb-4">
                        <div class="d-flex flex-column gap-3">
                            @{ int mobIdx = 1; }
                            @foreach (var line in enrollment.EnrollmentLines)
                            {
                                var sec = line.Section;
                                <div class="p-3 border rounded-3 bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="badge bg-light text-muted border me-1">#@(mobIdx++)</span>
                                            <span class="badge bg-primary-subtle text-primary fw-bold">@sec?.SectionCode</span>
                                        </div>
                                        <span class="badge bg-secondary">@(sec?.Course?.Credits ?? 0) TC</span>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">@sec?.Course?.CourseName</h6>
                                    <div class="small text-muted mb-2">
                                        <div><i class="bi bi-person me-1"></i> GV: @sec?.Instructor</div>
                                        <div><i class="bi bi-geo-alt me-1"></i> Phòng: @sec?.Room</div>
                                    </div>
                                    @if (sec?.Schedules != null && sec.Schedules.Any())
                                    {
                                        <div class="p-2 bg-white rounded border small">
                                            @foreach (var sched in sec.Schedules)
                                            {
                                                <div>@sched.DayOfWeekName (Tiết @sched.StartPeriod-@sched.EndPeriod)</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="p-3 bg-light rounded-3 mt-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-muted">Tổng số tín chỉ:</span>
                            <span class="fw-bold fs-5 text-success">@enrollment.TotalCredits TC</span>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- KHỐI QUẢN LÝ HỌC PHÍ & THANH TOÁN VIETQR CHUẨN THỰC TẾ                    -->
                    <!-- ========================================================================= -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden @(enrollment.IsPaid ? "bg-success-subtle border-success" : "bg-warning-subtle border-warning")" style="border-width: 2px !important;">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-3">
                                <div class="col-md-7">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="bg-white rounded-circle p-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                            @if (enrollment.IsPaid)
                                            {
                                                <i class="bi bi-patch-check-fill text-success fs-3"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-credit-card-2-front-fill text-warning fs-3"></i>
                                            }
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-dark">Học Phí Học Phần &amp; Trạng Thái Nộp Tiền</h5>
                                            <div class="small text-muted">Quy định đào tạo &bull; Đơn giá 450.000 VNĐ / 1 tín chỉ</div>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-3 mt-3">
                                        <div>
                                            <span class="text-muted small d-block">Tổng số tín chỉ:</span>
                                            <strong class="text-dark fs-6">@enrollment.TotalCredits TC</strong>
                                        </div>
                                        <div class="vr"></div>
                                        <div>
                                            <span class="text-muted small d-block">Đơn giá tín chỉ:</span>
                                            <span class="text-dark fw-semibold">450.000 đ/TC</span>
                                        </div>
                                        <div class="vr"></div>
                                        <div>
                                            <span class="text-muted small d-block">Tổng học phí phải nộp:</span>
                                            <strong class="text-danger fs-5">@($"{enrollment.TuitionFee:N0} VNĐ")</strong>
                                        </div>
                                    </div>

                                    @if (enrollment.IsPaid)
                                    {
                                        <div class="mt-3 p-2 bg-white rounded-3 border d-inline-block small">
                                            <div class="text-success fw-bold">
                                                <i class="bi bi-check-circle-fill me-1"></i> ĐÃ THANH TOÁN THÀNH CÔNG
                                            </div>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                <span>Mã E-Receipt: <strong class="font-monospace text-primary">@enrollment.TransactionReference</strong></span> &bull; 
                                                <span>Ngày: @(enrollment.PaymentDate?.ToString("dd/MM/yyyy HH:mm"))</span> &bull; 
                                                <span>Phương thức: @enrollment.PaymentMethod</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-2 text-muted small">
                                            <i class="bi bi-exclamation-circle text-warning me-1"></i>
                                            Hạn nộp học phí: <strong>@(enrollment.DateRegistered?.AddDays(15).ToString("dd/MM/yyyy") ?? "Trong đợt quy định")</strong>. Quá hạn hệ thống sẽ tự động hủy lịch học.
                                        </div>
                                    }
                                </div>

                                <div class="col-md-5 text-md-end">
                                    @if (enrollment.IsPaid)
                                    {
                                        <div class="d-flex flex-column align-items-md-end gap-2">
                                            <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">
                                                <i class="bi bi-shield-fill-check me-1"></i> ĐÃ HOÀN TẤT HỌC PHÍ
                                            </span>
                                            <button class="btn btn-outline-success btn-sm mt-1" @onclick="() => isPaymentModalOpen = true">
                                                <i class="bi bi-receipt me-1"></i> Xem Chi Tiết Biên Lai
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column align-items-md-end gap-2">
                                            <button class="btn btn-primary px-4 py-2 fw-bold shadow d-inline-flex align-items-center gap-2 rounded-pill"
                                                    style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); border: none;"
                                                    @onclick="() => isPaymentModalOpen = true">
                                                <i class="bi bi-credit-card-2-front-fill fs-5"></i>
                                                <span>Thanh toán học phí</span>
                                            </button>
                                            <span class="text-muted small" style="font-size: 0.75rem;">
                                                <i class="bi bi-shield-check text-success"></i> Chuyển khoản ngân hàng xác nhận tức thì
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                        <div class="d-flex gap-2">
                            <a href="/api/reports/student-enrollment/pdf?enrollmentId=@enrollment.EnrollmentId" 
                               class="btn btn-outline-danger shadow-sm fw-semibold" target="_blank">
                                <i class="bi bi-file-earmark-pdf me-1"></i> Xuất Phiếu PDF
                            </a>
                            <a href="/api/reports/student-enrollment/excel?enrollmentId=@enrollment.EnrollmentId" 
                               class="btn btn-outline-success shadow-sm fw-semibold" target="_blank" download>
                                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                            </a>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/tuition" class="btn btn-outline-warning text-dark fw-semibold">
                                <i class="bi bi-wallet2 me-1"></i> Thanh toán học phí
                            </a>
                            <a href="/schedule" class="btn btn-primary">
                                <i class="bi bi-calendar3 me-1"></i> Xem Thời Khóa Biểu
                            </a>
                            <a href="/sections" class="btn btn-outline-primary">
                                <i class="bi bi-arrow-clockwise me-1"></i> Tiếp tục đăng ký
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Thanh Toán VietQR -->
<CourseRegistration.Web.Components.Shared.VietQrPaymentModalComponent 
    Enrollment="enrollment" 
    IsOpen="isPaymentModalOpen" 
    OnClose="() => isPaymentModalOpen = false" 
    OnPaymentSuccess="HandlePaymentSuccess" />

@code {
    [Parameter]
    public int EnrollmentId { get; set; }

    private Enrollment? enrollment;
    private bool isLoading = true;
    private bool isPaymentModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        enrollment = await ViewEnrollmentUseCase.ExecuteAsync(EnrollmentId);
        isLoading = false;
    }

    private void HandlePaymentSuccess(TuitionPaymentResult result)
    {
        if (enrollment != null)
        {
            enrollment.PaymentStatus = "Paid";
            enrollment.PaymentDate = result.PaymentDate;
            enrollment.PaymentMethod = "VietQR Napas247";
            enrollment.TransactionReference = result.TransactionReference;
        }
        StateHasChanged();
    }
}
