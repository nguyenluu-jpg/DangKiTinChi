@page "/change-password"
@namespace CourseRegistration.Web.Components.Pages
@inject ICurrentUserStateStore CurrentUserStateStore
@inject ILoginModalService LoginModalService
@inject IChangePasswordModalService ChangePasswordModalService
@inject NavigationManager NavigationManager

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="mb-3">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-teal-subtle text-teal p-3" style="width: 64px; height: 64px; background-color: #ccfbf1; color: #0d9488;">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </span>
            </div>
            <h4 class="fw-bold mb-2">Đổi Mật Khẩu Tài Khoản</h4>
            <p class="text-muted small mb-4">
                Quản lý và cập nhật mật khẩu đăng nhập an toàn cho tài khoản Cán bộ Đào tạo hoặc Sinh viên.
            </p>

            @if (isAuthenticated)
            {
                <button type="button" 
                        class="btn btn-primary px-4 py-2.5 rounded-3 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 mx-auto"
                        @onclick="() => ChangePasswordModalService.Open()">
                    <i class="bi bi-key-fill"></i>
                    <span>Mở Hộp Thoại Đổi Mật Khẩu</span>
                </button>
            }
            else
            {
                <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark small text-start py-3 px-3 rounded-3 mb-3 shadow-none">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-1.5"></i>
                    Bạn cần đăng nhập vào hệ thống trước khi thực hiện đổi mật khẩu tài khoản.
                </div>
                <button type="button" 
                        class="btn btn-primary px-4 py-2.5 rounded-3 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2 mx-auto"
                        @onclick="() => LoginModalService.Open()">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Đăng Nhập Ngay</span>
                </button>
            }
        </div>
    </div>
</div>

@code {
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await CurrentUserStateStore.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            ChangePasswordModalService.Open();
        }
        else
        {
            LoginModalService.Open();
        }
    }
}
